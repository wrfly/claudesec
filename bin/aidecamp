#!/usr/bin/env python3
"""aidecamp — a Claude secretary in tmux. See DESIGN.md.

Commands (the secretary calls these; you mostly only run `aidecamp`):
  aidecamp [start] [--new|--restart] [-d]   open the secretary in its own tmux session "aidecamp"
                                    (resumes the last secretary; --new starts fresh; --restart reloads
                                    prompt and hooks keeping the conversation; -d don't switch)
  aidecamp spawn NAME --dir DIR [--model M] [--discuss] < task.txt
                                    (--discuss: a discussion window the user is switched into)
  aidecamp status                       one-screen table of workers
  aidecamp log NAME [-n N]              last N report entries of a worker
  aidecamp interrupt NAME               send Escape to a worker's window
  aidecamp close NAME                   kill a worker's window, drop it from the registry
  aidecamp peek NAME [-n N]             last lines of a worker's window and whether it is busy
  aidecamp sessions                     Claude sessions on this machine that aidecamp does not manage
  aidecamp adopt SESSION [--as NAME] [--wait]   take over an idle session (name, bg job id or session id;
                                            keeps its history); an exited session by its session id
  aidecamp shelve NAME [--note N] [--force]   stop a worker or outside session, keep only its record
  aidecamp wake NAME [--model M] [< instruction]   resume a shelved one in a new window (history kept)
  aidecamp archive NAME [--summary S] [--tags a,b] [--files x,y]
  aidecamp archive SLUG --subagent --task T --summary S [--tags ..] [--dir D] < body.md
  aidecamp lesson TYPE SITUATION CORRECTION
  aidecamp hook EVENT [NAME]            internal; called by Claude Code hooks
"""
import argparse
import contextlib
import datetime as dt
import fcntl
import json
import os
import re
import shlex
import signal
import subprocess
import sys
import threading
import time
import unicodedata
from pathlib import Path

HOME = Path(os.environ.get("AIDECAMP_HOME", Path.home() / ".aidecamp"))
SELF = Path(__file__).resolve()
REPO = SELF.parent.parent
PROMPTS = REPO / "prompts"


def claude_dir():
    """Claude Code's config dir. A launcher may set CLAUDE_CONFIG_DIR only for claude itself, so
    aidecamp processes started by tmux don't see it; hooks run under claude and record it."""
    env = os.environ.get("CLAUDE_CONFIG_DIR")
    if env:
        return Path(env)
    try:
        saved = json.loads((HOME / "config.json").read_text()).get("claude_config_dir")
    except (OSError, ValueError):
        saved = None
    return Path(saved) if saved else Path.home() / ".claude"

DEFAULT_CONFIG = {
    "secretary_name": "secretary",
    "secretary_model": None,          # None = whatever claude defaults to
    "worker_model": "claude-opus-5-5",
    "worker_permission_mode": "auto",
    "tmux_session": "aidecamp",           # the secretary and all workers live in this tmux session
}
TERMINAL = {"DONE", "FAILED", "BLOCKED", "NEED_DECISION"}
WAITING = {"BLOCKED", "NEED_DECISION", "WAITING_PERMISSION"}
LABELS = {"WAITING_PERMISSION": "等你批权限", "API_ERROR": "API 出错"}
NAME_RE = re.compile(r"^[a-z0-9][a-z0-9-]{0,31}$")


# ---------- state ----------

def now():
    return dt.datetime.now().astimezone().isoformat(timespec="seconds")


def config():
    path = HOME / "config.json"
    if not path.exists():
        HOME.mkdir(parents=True, exist_ok=True)
        path.write_text(json.dumps(DEFAULT_CONFIG, indent=2, ensure_ascii=False) + "\n")
    return {**DEFAULT_CONFIG, **json.loads(path.read_text())}


@contextlib.contextmanager
def registry():
    """Locked read-modify-write of registry.json; hooks from several workers can race."""
    HOME.mkdir(parents=True, exist_ok=True)
    with open(HOME / "registry.lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        path = HOME / "registry.json"
        reg = json.loads(path.read_text()) if path.exists() else {}
        reg.setdefault("focus", None)
        reg.setdefault("workers", {})
        yield reg
        tmp = path.with_suffix(".tmp")
        tmp.write_text(json.dumps(reg, indent=2, ensure_ascii=False) + "\n")
        tmp.replace(path)


def read_registry():
    path = HOME / "registry.json"
    reg = json.loads(path.read_text()) if path.exists() else {}
    return reg.get("focus"), reg.get("workers", {})


def worker_dir(name):
    d = HOME / "workers" / name
    d.mkdir(parents=True, exist_ok=True)
    return d


def log_path(name):
    (HOME / "reports").mkdir(parents=True, exist_ok=True)
    return HOME / "reports" / f"{name}.log"


def append_log(name, direction, text):
    with open(log_path(name), "a") as f:
        f.write(f"=== {now()} {direction}\n{text.rstrip()}\n")


def read_log(name):
    """Return [(header, body)] entries of a worker's report log."""
    path = log_path(name)
    if not path.exists():
        return []
    entries, cur = [], None
    for line in path.read_text().splitlines():
        if line.startswith("=== "):
            cur = [line[4:], []]
            entries.append(cur)
        elif cur:
            cur[1].append(line)
    return [(h, "\n".join(b)) for h, b in entries]


def parse_report(text):
    """'KEY: value' lines; a value continues until the next KEY line."""
    fields, key = {}, None
    for line in text.splitlines():
        m = re.match(r"^([A-Z_]+):\s?(.*)$", line)
        if m:
            key = m.group(1)
            fields[key] = m.group(2)
        elif key:
            fields[key] += "\n" + line
    return {k: v.strip() for k, v in fields.items()}


def width(s):
    return sum(2 if unicodedata.east_asian_width(c) in "WF" else 1 for c in s)


def pad(s, n):
    return s + " " * (n - width(s))


def tmux(*args, check=True):
    return subprocess.run(["tmux", *args], capture_output=True, text=True, check=check).stdout


def alive_windows():
    out = tmux("list-windows", "-a", "-F", "#{window_id}", check=False)
    return set(out.split())


def hook_cmd():
    return f"AIDECAMP_HOME={shlex.quote(str(HOME))} {shlex.quote(str(SELF))}"


def hook_input():
    remember_claude_dir()
    try:
        return json.load(sys.stdin)
    except Exception:
        return {}


def remember_claude_dir():
    env = os.environ.get("CLAUDE_CONFIG_DIR")
    if not env:
        return
    path = HOME / "config.json"
    try:
        cfg = json.loads(path.read_text())
    except (OSError, ValueError):
        return
    if cfg.get("claude_config_dir") != env:
        cfg["claude_config_dir"] = env
        tmp = path.with_suffix(f".{os.getpid()}.tmp")
        tmp.write_text(json.dumps(cfg, indent=2, ensure_ascii=False) + "\n")
        tmp.replace(path)


# ---------- secretary ----------

def has_session(name):
    return subprocess.run(["tmux", "has-session", "-t", f"={name}"], capture_output=True).returncode == 0


def secretary_runs_aidecamp(sess):
    """Is the secretary window running `aidecamp run` (directly, or under the shell tmux started)?"""
    out = tmux("display-message", "-p", "-t", f"={sess}:secretary", "#{pane_dead} #{pane_pid}", check=False).split()
    if len(out) != 2 or out[0] != "0":
        return False
    try:
        kids = Path(f"/proc/{out[1]}/task/{out[1]}/children").read_text().split()
    except OSError:
        kids = []
    return any(is_aidecamp_run(pid) for pid in [out[1], *kids])


def cmd_start(args):
    """Put the secretary in its own tmux session, then switch or attach to it."""
    sess = config()["tmux_session"]
    remember_claude_dir()
    run = f"AIDECAMP_HOME={shlex.quote(str(HOME))} {shlex.quote(str(SELF))} run" + (" --new" if args.new else "")
    if not has_session(sess):
        tmux("new-session", "-d", "-s", sess, "-n", "secretary", "-c", str(HOME), run)
    elif "secretary" not in tmux("list-windows", "-t", f"={sess}", "-F", "#{window_name}").split():
        tmux("new-window", "-t", f"={sess}:", "-n", "secretary", "-c", str(HOME), run)
    else:
        wrapped = secretary_runs_aidecamp(sess)
        if args.new or args.restart or not wrapped:
            # --restart: same conversation, freshly loaded prompt and hooks. Not wrapped: a restored
            # tmux layout left a shell or a bare `claude --resume` in the window; take it over.
            if wrapped:  # the exiting `aidecamp run` sees this and leaves the workers running
                (HOME / "restarting").write_text(str(time.time()))
            tmux("respawn-pane", "-k", "-t", f"={sess}:secretary", "-c", str(HOME), run)
    # Keep this session out of tmux-resurrect's saved layouts (a post-save hook that honours
    # @resurrect-skip drops it): restored, its panes would be bare `claude --resume`s without
    # aidecamp's prompts and hooks. `aidecamp` starts the secretary itself; its wake-all brings the workers.
    tmux("set-option", "-t", f"={sess}:", "@resurrect-skip", "on", check=False)
    if args.detach:
        print(f"secretary is in tmux session '{sess}'")
    elif os.environ.get("TMUX"):
        tmux("switch-client", "-t", f"={sess}")
    else:
        os.execvp("tmux", ["tmux", "attach-session", "-t", f"={sess}"])


QUEUE = """# 决策队列

秘书维护。worker 的 NEED_DECISION、要用户定的 TODO 先进这里，按重要程度排序，一次只问用户一件。
问了还没回答的放「已问未答」；秘书自己能处理的直接处理，移到「已处理」。

## 待问（按优先级）

## 已问未答

## 已处理
"""


def cmd_run(args):
    """Runs inside the secretary's tmux window: the secretary's Claude Code process itself."""
    cfg = config()
    HOME.mkdir(parents=True, exist_ok=True)
    if not (HOME / "queue.md").exists():
        (HOME / "queue.md").write_text(QUEUE)
    settings = HOME / "secretary-settings.json"
    cmd = hook_cmd()
    # A worker stuck on a dialog can't SendMessage, so alerts reach the secretary through a
    # background watcher whose exit code 2 wakes it (asyncRewake); every turn end re-arms it.
    watch = {"type": "command", "command": f"{cmd} hook secretary-watch", "asyncRewake": True}
    settings.write_text(json.dumps({
        # The user talks to the secretary in their own words; no Tab-completion guesses.
        "promptSuggestionEnabled": False,
        "hooks": {
            "SessionStart": [{"hooks": [{"type": "command", "command": f"{cmd} hook secretary-session-start"}]},
                             {"hooks": [watch]}],
            "Stop": [{"hooks": [watch]}],
            "PostToolUse": [{"matcher": "SendMessage",
                             "hooks": [{"type": "command", "command": f"{cmd} hook secretary-send"}]}],
        },
    }, indent=2) + "\n")
    argv = ["claude", "-n", cfg["secretary_name"],
            "--settings", str(settings),
            "--append-system-prompt-file", str(PROMPTS / "secretary.md"),
            "--allowedTools", "Bash(aidecamp *)"]
    if cfg["secretary_model"]:
        argv += ["--model", cfg["secretary_model"]]
    session = HOME / "secretary.session"
    if session.exists() and not args.new:
        argv += ["--resume", session.read_text().strip()]
    # Fixed cwd: the secretary is cross-project, and Claude Code's auto memory is keyed by cwd,
    # so a fixed cwd gives it one stable memory directory.
    os.chdir(HOME)
    (HOME / "run.pid").write_text(str(os.getpid()))  # a newer one tells an older shelve-all to stop
    detach("wake-all")
    # Not exec: the workers are put away after the secretary exits. That is done here, by aidecamp,
    # so the user has no chores and no tool call of the secretary's can be refused.
    signal.signal(signal.SIGINT, signal.SIG_IGN)   # Ctrl+C belongs to claude
    signal.signal(signal.SIGHUP, signal.SIG_IGN)   # window killed: claude exits, we still clean up
    def default_signals():  # ignored signals are inherited; claude needs its own
        signal.signal(signal.SIGINT, signal.SIG_DFL)
        signal.signal(signal.SIGHUP, signal.SIG_DFL)
    child = subprocess.Popen(argv, preexec_fn=default_signals)
    signal.signal(signal.SIGTERM, lambda *_: child.terminate())
    child.wait()
    restarting = HOME / "restarting"
    try:
        deliberate = time.time() - float(restarting.read_text()) < 120
    except (OSError, ValueError):
        deliberate = False
    restarting.unlink(missing_ok=True)
    if not deliberate:
        detach("shelve-all")


def detach(job):
    """Run `aidecamp lifecycle JOB` on its own, outliving this window; output goes to a log."""
    log = open(HOME / "lifecycle.log", "a")
    p = subprocess.Popen([str(SELF), "lifecycle", job, str(os.getpid())], env={**os.environ, "AIDECAMP_HOME": str(HOME)},
                         stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True)
    # Reap it when it's done, or wake-all lingers as a zombie for as long as the secretary runs.
    # If this process exits first (shelve-all), the job is reparented and reaped by init.
    threading.Thread(target=p.wait, daemon=True).start()


def secretary_alive():
    name = config()["secretary_name"]
    return any(s.get("name") == name for s in claude_sessions())


def quietly(fn, **kw):
    """Run a cmd_* function as a library call; its sys.exit, or a crash (a window closed under
    it), becomes a returned message."""
    try:
        fn(argparse.Namespace(**kw))
        return None
    except SystemExit as e:
        return str(e.code)
    except Exception as e:
        return f"crashed: {e!r}"


def cmd_lifecycle(args):
    print(f"=== {now()} {args.job} (aidecamp run {args.run_pid})", flush=True)
    if args.job == "shelve-all":
        shelve_all(args.run_pid)
    else:
        wake_all(args.run_pid)
    print(f"=== {now()} {args.job} done", flush=True)


@contextlib.contextmanager
def lifecycle_lock():
    """wake-all and shelve-all never overlap. A secretary can die seconds after it started,
    while its workers are still being woken (each mid-wake has no session in the registry)."""
    with open(HOME / "lifecycle.lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield


def current_run():
    """pid of the live `aidecamp run` the secretary is in, from run.pid, or None."""
    try:
        pid = int((HOME / "run.pid").read_text())
        os.kill(pid, 0)
    except (OSError, ValueError):
        return None
    return pid if is_aidecamp_run(pid) else None  # after a reboot the pid may be someone else's


def is_aidecamp_run(pid):
    """Is pid a `aidecamp run`? Without /proc there is no telling; assume it is."""
    try:
        argv = Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0")
    except OSError:
        return not Path("/proc/self").exists()
    return b"run" in argv and any(a.endswith(b"aidecamp") for a in argv)


def shelve_all(run_pid):
    """The secretary is gone: put every worker away, keeping its session to resume later.
    A busy one is left to finish its turn first; if the secretary is back by then, it stays."""
    pending = None
    deadline = time.time() + 6 * 3600
    while time.time() < deadline:
        with lifecycle_lock():
            newer = current_run()
            if (newer and newer != run_pid) or secretary_alive():
                print("secretary is back; leaving the rest running:", sorted(pending or ()), flush=True)
                return
            if pending is None:  # under the lock, so workers a wake-all just brought back are included
                pending = {n for n, w in read_registry()[1].items() if w["status"] != "SHELVED"}
            for name in sorted(pending):
                w = read_registry()[1].get(name)
                if not w or w["status"] == "SHELVED":
                    pending.discard(name)
                    continue
                holder = live_holder(w.get("session"))
                if holder and holder.get("status") == "busy":
                    continue
                err = quietly(cmd_shelve, name=name, note=None, as_name=None, force=False, by="exit")
                print(f"{name}: {err or 'shelved'}", flush=True)
                pending.discard(name)
        if not pending:
            return
        time.sleep(10)
    print("gave up waiting for:", sorted(pending), flush=True)


def wake_all(run_pid):
    """The secretary started: bring back what its exit put away, plus workers whose process
    died some other way (window or tmux session killed). What the user shelved stays shelved."""
    time.sleep(3)  # let the secretary's window come up first
    with lifecycle_lock():
        if run_pid and current_run() != run_pid:
            print("the secretary that started this is already gone; waking nothing", flush=True)
            return
        wake_orphans()


def wake_orphans():
    names = []
    with registry() as reg:
        for name, w in reg["workers"].items():
            if w["status"] == "SHELVED":
                if w.get("shelved_by") == "exit":
                    names.append(name)
                continue
            if w.get("session") and not live_holder(w["session"]) and transcript(w["session"]):
                w.update(status_before=w["status"], status="SHELVED", window=None, shelved_by="exit")
                names.append(name)
    threads, failed = [], {}
    for name in names:
        def go(name=name):
            err = quietly(cmd_wake, name=name, model=None, quiet=True)
            print(f"{name}: {err or 'woken'}", flush=True)
            if err:
                failed[name] = err
        threads.append(threading.Thread(target=go))
        threads[-1].start()
    for t in threads:
        t.join()
    if failed:
        raise_alert("秘书启动时这些 worker 没能自动恢复（仍是搁置状态，可以再试 aidecamp wake）：\n"
                    + "\n".join(f"- {n}: {e.splitlines()[0][:200]}" for n, e in failed.items()))


def cmd_spawn(args):
    cfg = config()
    name = args.name
    if not NAME_RE.match(name):
        sys.exit(f"bad worker name {name!r}: use lowercase letters, digits, dashes")
    _, workers = read_registry()
    old = workers.get(name)
    if old and old["status"] == "SHELVED":
        sys.exit(f"{name} is a shelved worker: `aidecamp wake {name}` it, or `aidecamp close {name}` to forget it")
    if old and old.get("window") in alive_windows():
        sys.exit(f"worker {name} is already running in window {old['window']}")
    task = sys.stdin.read().strip()
    if not task:
        sys.exit("empty task: pass the user's words on stdin")
    project = str(Path(args.dir).expanduser().resolve())
    model = args.model or cfg["worker_model"]

    if args.discuss:
        initial = (f"用户想跟你讨论，秘书转来的原话：\n\n{task}\n\n"
                   "这是讨论模式：用户现在就在看你这个窗口，直接跟用户对话。规则见系统提示里的「讨论模式」。\n")
    else:
        initial = f"秘书派给你的任务（用户原话）：\n\n{task}\n"
    d = prepare_worker(name, cfg, initial)
    (d / "task.md").write_text(task + "\n")
    target = ["-t", f"={cfg['tmux_session']}:"] if has_session(cfg["tmux_session"]) else []
    window = tmux("new-window", "-d", *target, "-P", "-F", "#{window_id}", "-n", name, "-c", project,
                  worker_command(name, d, cfg, model)).strip()

    with registry() as reg:
        reg["workers"][name] = {
            "window": window, "dir": project, "model": model, "task": task,
            "mode": "discuss" if args.discuss else "task",
            "status": "STARTING", "started_at": now(), "last_report_at": None,
            "last_summary": "", "pending_ask": None, "session": None, "archived": None,
        }
        reg["focus"] = name
    append_log(name, "task", task)
    if args.discuss:
        # The user talks to a discussion worker directly, so take them there now.
        tmux("select-window", "-t", window, check=False)
    if not stuck_on_dialog(name, window):
        verb = "discussion window opened and switched to" if args.discuss else "spawned"
        print(f"{verb} {name} ({model}) in window {window}, dir {project}")


def prepare_worker(name, cfg, initial, fresh_log=True):
    """Fresh log, rules prompt, first message and hook settings for a worker; returns its dir."""
    # A reused name starts a fresh log; the old one stays next to it.
    if fresh_log and log_path(name).exists():
        log_path(name).rename(log_path(name).with_suffix(f".{int(time.time())}.log"))
    d = worker_dir(name)
    (d / "reported").unlink(missing_ok=True)
    prompt = (PROMPTS / "worker.md").read_text()
    prompt = prompt.replace("{{NAME}}", name).replace("{{SECRETARY}}", cfg["secretary_name"])
    (d / "prompt.md").write_text(prompt)
    (d / "initial.md").write_text(initial)
    (d / "waiting-permission").unlink(missing_ok=True)
    cmd = hook_cmd()
    q = shlex.quote(name)
    asking = {"type": "command", "command": f"{cmd} hook worker-permission {q}"}
    # Any tool event after a prompt means it was answered; the test keeps the common case cheap.
    answered = [{"matcher": "*", "hooks": [{"type": "command", "command":
                 f"[ ! -e {shlex.quote(str(d / 'waiting-permission'))} ] || {cmd} hook worker-permission-done {q}"}]}]
    (d / "settings.json").write_text(json.dumps({"hooks": {
        "SessionStart": [{"hooks": [{"type": "command", "command": f"{cmd} hook worker-session-start {q}"}]}],
        "PermissionRequest": [{"matcher": "*", "hooks": [asking]}],
        "Notification": [{"matcher": "permission_prompt|elicitation_dialog|elicitation_url_dialog",
                          "hooks": [asking]}],
        "PostToolUse": [{"matcher": "SendMessage",
                         "hooks": [{"type": "command", "command": f"{cmd} hook worker-report {q}"}]}, *answered],
        "PostToolUseFailure": [{"matcher": "SendMessage",
                                "hooks": [{"type": "command", "command": f"{cmd} hook worker-report {q}"}]}, *answered],
        "PermissionDenied": answered,
        "Stop": [{"hooks": [{"type": "command", "command": f"{cmd} hook worker-stop {q}"}]}],
        "StopFailure": [{"hooks": [{"type": "command", "command": f"{cmd} hook worker-stop-failure {q}"}]}],
    }}, indent=2) + "\n")
    return d


def worker_command(name, d, cfg, model, *extra, prompt=True):
    return " ".join(shlex.quote(a) for a in [
        "claude", "-n", name, "--model", model,
        "--permission-mode", cfg["worker_permission_mode"],
        "--settings", str(d / "settings.json"),
        "--append-system-prompt-file", str(d / "prompt.md"), *extra,
    ]) + (f' "$(cat {shlex.quote(str(d / "initial.md"))})"' if prompt else "")


def stuck_on_dialog(name, target):
    """Catch dialogs that would stall a window nobody is looking at."""
    for _ in range(8):
        time.sleep(1)
        pane = tmux("capture-pane", "-p", "-t", target, check=False)
        if not pane and target not in alive_windows():
            sys.exit(f"worker {name}: {target} exited right away")
        if re.search(r"trust this folder|Do you trust|Enter to confirm|Do you want to", pane):
            tail = "\n".join(l for l in pane.splitlines() if l.strip())[-1200:]
            print(f"{name} started in {target}, but it is STUCK ON A DIALOG — tell the user to "
                  f"switch to window '{name}' and answer it:\n{tail}")
            return True
    return False


# ---------- sessions aidecamp did not start ----------

ADOPT_PROMPT = """你刚被 aidecamp 秘书接管：会话历史都在，从现在起按系统提示里的 worker 规则工作。
先用 SendMessage 给秘书发第一条汇报，让秘书知道你的情况：
- DID 写你之前在做什么、做到了哪里。
- 上一轮的事已经做完 → TYPE: DONE，按格式给出 RESULT 和 DECISIONS。
- 上一轮停下是在等用户回答 → TYPE: NEED_DECISION，把问题在 ASK 里重新问一遍。
- 其他情况 → TYPE: BLOCKED，ISSUE 写「等秘书确认下一步」。
发完就停，不要自己开始新的工作。
"""


def claude_sessions():
    """Live Claude Code sessions on this machine, from Claude Code's own sessions/<pid>.json."""
    out = []
    for f in (claude_dir() / "sessions").glob("*.json"):
        try:
            s = json.loads(f.read_text())
            os.kill(s["pid"], 0)
        except (OSError, ValueError, KeyError):
            continue
        out.append(s)
    return out


def external_sessions():
    """Conversations aidecamp could adopt. A foreground client parked on a background job (the
    daemon's `bg` host) is folded into that job: the conversation lives in the job, the
    client's own sessionId is empty. The job's session is under s["bg"]."""
    cfg = config()
    _, workers = read_registry()
    names = {cfg["secretary_name"], *workers}
    ids = {w.get("session") for w in workers.values()}
    live = claude_sessions()
    jobs = {s["jobId"]: s for s in live if s.get("kind") == "bg" and s.get("jobId")}
    out = []
    for s in live:
        if s.get("kind") == "interactive" and s.get("parkedJobId") in jobs:
            s["bg"] = jobs.pop(s["parkedJobId"])
    for s in live:
        if s.get("kind") == "bg" and s.get("jobId") not in jobs:
            continue  # folded into the client parked on it
        if s.get("kind") not in ("interactive", "bg"):
            continue
        conv = s.get("bg") or s
        if s.get("name") in names or conv.get("sessionId") in ids:
            continue
        out.append(s)
    return sorted(out, key=lambda s: s.get("startedAt", 0))


def session_kind(s):
    if s.get("bg"):
        return f"前台挂在后台 {s['bg'].get('jobId')}"
    if s.get("kind") == "bg":
        return f"后台 {s.get('jobId')}"
    return "前台"


def session_rows(sessions):
    rows = [("会话", "类型", "状态", "tmux", "目录")]
    for s in sessions:
        conv = s.get("bg") or s
        rows.append((s.get("name", "?"), session_kind(s), conv.get("status", "?"),
                     s.get("tmux") or "（不在 tmux）", Path(conv.get("cwd", "")).name))
    return rows


def print_rows(rows):
    widths = [max(width(r[i]) for r in rows) for i in range(len(rows[0]))]
    for r in rows:
        print("  ".join(pad(c, widths[i]) for i, c in enumerate(r)).rstrip())


def cmd_sessions(args):
    sessions = external_sessions()
    if not sessions:
        print("没有 aidecamp 之外的 Claude 会话。")
        return
    print_rows(session_rows(sessions))


def transcript(sid):
    return next(claude_dir().glob(f"projects/*/{sid}.jsonl"), None)


def exited_session(key):
    """A conversation no process holds any more, by session id (prefix of 8+). It is resumed
    in a new window, in the directory it last ran in."""
    if len(key) < 8 or not re.match(r"^[0-9a-f-]+$", key):
        return None
    hits = {p.stem: p for p in claude_dir().glob(f"projects/*/{key}*.jsonl")}
    if len(hits) > 1:
        sys.exit(f"{key!r} matches several sessions: {', '.join(sorted(hits))}")
    if not hits:
        return None
    sid, path = hits.popitem()
    held = next((s for s in claude_sessions() if s.get("sessionId") == sid), None)
    if held:
        sys.exit(f"session {sid} is held by live pid {held['pid']} ({held.get('name')}), "
                 f"which aidecamp manages or can't take over")
    if sid in {w.get("session") for w in read_registry()[1].values()}:
        sys.exit(f"session {sid} already belongs to a aidecamp worker")
    cwd = None
    with open(path) as f:
        for line in f:
            if '"cwd"' in line:
                with contextlib.suppress(ValueError):
                    cwd = json.loads(line).get("cwd") or cwd
    if not cwd or not Path(cwd).is_dir():
        sys.exit(f"session {sid}: its directory {cwd!r} is gone; nothing to resume in")
    return {"sessionId": sid, "cwd": cwd, "kind": "exited", "status": "idle"}


def wait_exit(pid, secs):
    for _ in range(int(secs * 2)):
        try:
            os.kill(pid, 0)
        except OSError:
            return True
        time.sleep(0.5)
    return False


def find_external(key):
    """An unmanaged live session by name, background job id, or session id (prefix of 8+)."""
    for s in external_sessions():
        conv = s.get("bg") or s
        if key in (s.get("name"), conv.get("name"), conv.get("jobId")) or \
                len(key) >= 8 and conv.get("sessionId", "").startswith(key):
            return s
    return None


def worker_name_for(s, conv, as_name):
    name = as_name or re.sub(r"-[0-9a-f]{2}$", "", (s.get("name") or conv.get("jobId")
                                                    or Path(conv["cwd"]).name).lower())
    name = re.sub(r"[^a-z0-9-]+", "-", name).strip("-")[:32].strip("-")
    if not NAME_RE.match(name) or name in read_registry()[1]:
        sys.exit(f"can't use {name!r} as the worker name; pass --as NAME")
    return name


def stop_bg_job(conv):
    """Stopped through Claude Code, so its daemon doesn't respawn the host."""
    r = subprocess.run(["claude", "stop", conv["jobId"]], capture_output=True, text=True,
                       stdin=subprocess.DEVNULL, timeout=60)
    if not wait_exit(conv["pid"], 15):
        sys.exit(f"`claude stop {conv['jobId']}` did not stop host pid {conv['pid']} "
                 f"(exit {r.returncode}: {(r.stderr or r.stdout).strip()[-400:]}). Nothing else was touched.")


def stop_foreground(s):
    os.kill(s["pid"], signal.SIGTERM)  # an interactive session, or the client parked on a job
    wait_exit(s["pid"], 10)


def cmd_adopt(args):
    cfg = config()

    def find():
        return find_external(args.session)

    s = find() or exited_session(args.session) or sys.exit(
        f"no unmanaged live session or exited session id {args.session!r}; see `aidecamp sessions`")
    conv = s.get("bg") or s
    if not s.get("tmux") and conv.get("kind") not in ("bg", "exited"):
        sys.exit(f"{args.session} is not running in tmux; it can't be taken over in place")
    if args.wait and conv.get("kind") != "exited":
        idle_since, deadline = None, time.time() + 12 * 3600
        while True:
            s = find() or sys.exit(f"{args.session} exited before it could be adopted")
            conv = s.get("bg") or s
            if conv.get("status") == "idle":
                idle_since = idle_since or time.time()
                # Idle flickers between turns; only a quiet stretch means it has really stopped.
                if time.time() - idle_since >= 30:
                    break
            else:
                idle_since = None
            if time.time() > deadline:
                sys.exit(f"gave up: {args.session} was not idle for 12h")
            time.sleep(5)
    elif conv.get("status") != "idle":
        sys.exit(f"{args.session} is {conv.get('status')}. Only idle sessions are adopted: ask the user "
                 f"to stop it, or run `aidecamp adopt {args.session} --wait` in the background")

    sid, cwd = conv["sessionId"], conv["cwd"]
    # Nothing is stopped until we know the conversation is on disk: a client attached to a
    # background job has its own, never-written sessionId.
    if not transcript(sid):
        sys.exit(f"{args.session}: no transcript for session {sid} under {claude_dir()}/projects; "
                 f"nothing to resume (is it a client attached to a background job?). Nothing was touched.")

    label = s.get("name") or conv.get("jobId") or sid[:8]
    name = worker_name_for(s, conv, args.as_name)
    model = args.model or cfg["worker_model"]
    d = prepare_worker(name, cfg, ADOPT_PROMPT)
    (d / "exit").unlink(missing_ok=True)
    # No trailing shell: when claude exits the pane dies, and remain-on-exit keeps it (with the
    # error on screen) until resume is confirmed.
    cmd = (worker_command(name, d, cfg, model, "--resume", sid)
           + f"; echo $? > {shlex.quote(str(d / 'exit'))}")

    # Stop every process holding the conversation before another one resumes it. A background
    # job is stopped through Claude Code, so its daemon doesn't respawn the host.
    if conv.get("kind") == "bg":
        stop_bg_job(conv)
    if s.get("tmux"):
        window, pane = re.match(r"^[^:]*:(@\d+)\.(%\d+)$", s["tmux"]).groups()
        tmux("set-option", "-p", "-t", pane, "remain-on-exit", "on", check=False)
        stop_foreground(s)
    else:
        # A background job or an exited session has no pane: open a placeholder window to respawn into.
        target = ["-t", f"={cfg['tmux_session']}:"] if has_session(cfg["tmux_session"]) else []
        window, pane = tmux("new-window", "-d", *target, "-P", "-F", "#{window_id} #{pane_id}",
                            "-n", name, "-c", cwd, "sleep 3600").split()
        tmux("set-option", "-p", "-t", pane, "remain-on-exit", "on", check=False)

    with registry() as reg:
        reg["workers"][name] = {
            "window": window, "dir": cwd, "model": model,
            "task": f"接管的会话 {label}（原任务见其汇报）",
            "status": "STARTING", "started_at": now(), "last_report_at": None,
            "last_summary": "", "pending_ask": None, "session": None, "archived": None,
            "adopted_from": label,
        }
    tmux("respawn-pane", "-k", "-t", pane, "-c", cwd, cmd)
    tmux("rename-window", "-t", window, name, check=False)
    if has_session(cfg["tmux_session"]):
        tmux("move-window", "-d", "-s", window, "-t", f"={cfg['tmux_session']}:", check=False)

    verdict, screen = confirm_resume(name, pane, d, sid)
    tail = "\n".join(l for l in screen.splitlines() if l.strip())[-1200:]
    if verdict == "ok":
        tmux("set-option", "-p", "-u", "-t", pane, "remain-on-exit", check=False)
        with registry() as reg:
            reg["focus"] = name
        append_log(name, "task", f"adopted {label} (session {sid}, {cwd})")
        shown = ensure_name(name, pane, sid)
        if shown != name:
            sys.exit(f"adopt INCOMPLETE: {label} resumed as worker {name} in window {window} (session {sid}), "
                     f"but other sessions still address it as {shown!r}, so SendMessage(to: {name!r}) "
                     f"won't reach it. Run `/rename {name}` in that window.")
        print(f"adopted {label} as {name} ({model}) in window {window}, session {sid}; "
              f"it will report what it was doing")
        return
    if verdict == "dialog":
        append_log(name, "task", f"adopted {label} (session {sid}, {cwd})")
        print(f"{name} is resuming in {window}, but it is STUCK ON A DIALOG — tell the user to "
              f"switch to window '{name}' and answer it:\n{tail}")
        return
    with registry() as reg:
        reg["workers"].pop(name, None)
    sys.exit(f"adopt FAILED ({verdict}): {name} did not resume session {sid}. Window {window} is "
             f"left as it is (a dead pane keeps claude's output). The conversation is intact: run "
             f"`claude --resume {sid}` in {cwd}.\n{tail}")


# ---------- shelved: registered, but no process running ----------

WAKE_PROMPT = "你刚被 aidecamp 秘书从搁置中唤醒：会话历史都在，继续按系统提示里的 worker 规则工作。\n"
WAKE_REPORT = """先用 SendMessage 给秘书发一条汇报：DID 写你之前在做什么、做到了哪里；
TYPE: BLOCKED，ISSUE 写「等秘书给下一步」。发完就停，不要自己开始新的工作。
"""


def last_turn(sid):
    """The last user prompt and assistant reply in a transcript, for a record that runs no model."""
    user = reply = ""
    path = transcript(sid)
    for line in open(path) if path else []:
        try:
            e = json.loads(line)
        except ValueError:
            continue
        content = (e.get("message") or {}).get("content")
        if isinstance(content, str):
            text = content
        else:
            text = " ".join(b.get("text", "") for b in content or []
                            if isinstance(b, dict) and b.get("type") == "text")
        text = " ".join(text.split())
        if not text:
            continue
        if e.get("type") == "user" and not e.get("isMeta"):
            user = text
        elif e.get("type") == "assistant":
            reply = text
    return f"最后：{user[:80]} → {reply[:120]}" if user or reply else ""


def live_holder(sid):
    return next((s for s in claude_sessions() if sid and s.get("sessionId") == sid), None)


def cmd_shelve(args):
    workers = read_registry()[1]
    if args.name in workers:
        name, w = args.name, workers[args.name]
        if w["status"] == "SHELVED":
            sys.exit(f"{name} is already shelved")
        sid, cwd, label = w.get("session"), w["dir"], name
        if not sid or not transcript(sid):
            sys.exit(f"{name}: no transcript recorded for it, so it could not be woken later. Not shelved.")
        holder = live_holder(sid)
        if holder and holder.get("status") == "busy" and not args.force:
            sys.exit(f"{name} is busy; shelving would cut it off mid-task. Wait for it, or pass --force")
        if holder:
            stop_foreground(holder)
        if w.get("window"):
            tmux("kill-window", "-t", w["window"], check=False)
        entry = dict(w)
    else:
        s = find_external(args.name) or exited_session(args.name) or sys.exit(
            f"no worker, unmanaged live session or exited session id {args.name!r}; see `aidecamp status`")
        conv = s.get("bg") or s
        if conv.get("status") == "busy" and not args.force:
            sys.exit(f"{args.name} is busy; shelving would cut it off mid-task. Wait for it, or pass --force")
        sid, cwd = conv["sessionId"], conv["cwd"]
        if not transcript(sid):
            sys.exit(f"{args.name}: no transcript for session {sid}; nothing could be woken later. Nothing was touched.")
        label = s.get("name") or conv.get("jobId") or sid[:8]
        name = worker_name_for(s, conv, args.as_name)
        if conv.get("kind") == "bg":
            stop_bg_job(conv)
        if s.get("kind") == "interactive":
            stop_foreground(s)
        entry = {"dir": cwd, "model": config()["worker_model"], "task": f"搁置的会话 {label}",
                 "started_at": now(), "archived": None, "adopted_from": label}
    summary = args.note or last_turn(sid) or "（无记录）"
    with registry() as reg:
        reg["workers"][name] = {**entry, "status": "SHELVED", "window": None, "session": sid,
                                "status_before": entry.get("status"),
                                "shelved_by": getattr(args, "by", "user"),
                                "dir": cwd, "shelved_at": now(), "note": args.note or "",
                                "shelf_summary": summary, "pending_ask": None,
                                "last_summary": entry.get("last_summary") or summary,
                                "last_report_at": entry.get("last_report_at") or now()}
        if reg["focus"] == name:
            reg["focus"] = None
    (worker_dir(name) / "waiting-permission").unlink(missing_ok=True)
    append_log(name, "shelved", f"session {sid}, {cwd}\n{summary}")
    print(f"shelved {label} as {name}: nothing is running for it now. Session {sid} in {cwd}. "
          f"`aidecamp wake {name}` resumes it.")


def cmd_wake(args):
    cfg = config()
    name = args.name
    w = read_registry()[1].get(name) or sys.exit(f"no worker {name}")
    if w["status"] != "SHELVED":
        sys.exit(f"{name} is not shelved (status {w['status']})")
    sid, cwd = w["session"], w["dir"]
    if not transcript(sid):
        sys.exit(f"{name}: transcript of session {sid} is gone; it can't be resumed")
    if not Path(cwd).is_dir():
        sys.exit(f"{name}: its directory {cwd} is gone; nothing to resume in")
    holder = live_holder(sid)
    if holder:
        sys.exit(f"{name}: session {sid} is already running as pid {holder['pid']} ({holder.get('name')}); "
                 f"someone resumed it outside aidecamp")
    quiet = getattr(args, "quiet", False)
    instruction = "" if quiet or sys.stdin.isatty() else sys.stdin.read().strip()
    initial = WAKE_PROMPT + (f"\n秘书转来用户的新指令（原话），照做并按规则汇报：\n\n{instruction}\n"
                             if instruction else "\n" + WAKE_REPORT)
    model = args.model or w.get("model") or cfg["worker_model"]
    d = prepare_worker(name, cfg, initial, fresh_log=False)
    (d / "exit").unlink(missing_ok=True)
    # Quiet: just reopen the conversation; no first prompt, so no model turn and no report.
    cmd = (worker_command(name, d, cfg, model, "--resume", sid, prompt=not quiet)
           + f"; echo $? > {shlex.quote(str(d / 'exit'))}")
    target = ["-t", f"={cfg['tmux_session']}:"] if has_session(cfg["tmux_session"]) else []
    window, pane = tmux("new-window", "-d", *target, "-P", "-F", "#{window_id} #{pane_id}",
                        "-n", name, "-c", cwd, "sleep 3600").split()
    tmux("set-option", "-p", "-t", pane, "remain-on-exit", "on", check=False)
    with registry() as reg:
        reg["workers"][name].update(window=window, model=model, status="STARTING", session=None)
    tmux("respawn-pane", "-k", "-t", pane, "-c", cwd, cmd)
    if instruction:
        append_log(name, "secretary→worker", instruction)

    verdict, screen = confirm_resume(name, pane, d, sid)
    tail = "\n".join(l for l in screen.splitlines() if l.strip())[-1200:]
    if verdict == "ok":
        tmux("set-option", "-p", "-u", "-t", pane, "remain-on-exit", check=False)
        with registry() as reg:
            w = reg["workers"][name]
            if quiet:
                w["status"] = w.get("status_before") or "PROGRESS"
            else:
                reg["focus"] = name
            w.pop("shelved_by", None)
        append_log(name, "task", f"woken{' quietly' if quiet else ''} (session {sid}, {cwd})")
        shown = ensure_name(name, pane, sid)
        if shown != name:
            sys.exit(f"wake INCOMPLETE: {name} resumed in window {window}, but other sessions address it as "
                     f"{shown!r}, so SendMessage(to: {name!r}) won't reach it. Run `/rename {name}` in that window.")
        print(f"woke {name} ({model}) in window {window}; "
              + ("idle, history loaded" if quiet else
                 "it will report on the new instruction" if instruction else "it will report what it was doing"))
        return
    if verdict == "dialog":
        print(f"{name} is resuming in {window}, but it is STUCK ON A DIALOG — tell the user to "
              f"switch to window '{name}' and answer it:\n{tail}")
        return
    with registry() as reg:
        reg["workers"][name].update(status="SHELVED", window=None, session=sid)
    sys.exit(f"wake FAILED ({verdict}): {name} stays shelved. Window {window} is left as it is. "
             f"The conversation is intact: `claude --resume {sid}` in {cwd}.\n{tail}")


def confirm_resume(name, pane, d, sid):
    """Adopted only once the worker's SessionStart hook reports the very session we resumed.
    The screen is not grepped for errors: a resumed conversation renders its old messages."""
    screen, dialog = "", 0
    for _ in range(60):
        time.sleep(1)
        screen = tmux("capture-pane", "-p", "-t", pane, check=False)
        got = read_registry()[1].get(name, {}).get("session")
        if got == sid:
            return "ok", screen
        if got:
            return f"resumed as a different session {got}", screen
        if (d / "exit").exists() or tmux("display", "-p", "-t", pane, "#{pane_dead}", check=False).strip() != "0":
            return "claude exited", screen
        # A dialog blocks before SessionStart; only one that stays up counts.
        dialog = dialog + 1 if re.search(r"trust this folder|Do you trust|Enter to confirm", screen) else 0
        if dialog >= 5:
            return "dialog", screen
    return "no SessionStart within 60s", screen


def ensure_name(name, pane, sid):
    """Peers address a session by the name in its sessions/<pid>.json. On resume a name stored in
    the transcript (a background job's auto name) beats `-n`, so rename it in the session itself
    and wait until Claude Code reports the new name. Returns the name it ends up with."""
    shown = None
    for attempt in range(2):
        tmux("send-keys", "-t", pane, "-l", f"/rename {name}")
        time.sleep(1)  # Enter apart from the text, as when typed by hand
        tmux("send-keys", "-t", pane, "Enter")
        for _ in range(10):
            time.sleep(1)
            s = next((s for s in claude_sessions() if s.get("sessionId") == sid), {})
            shown = s.get("name")
            if shown == name:
                return name
    return shown


def cmd_status(args):
    focus, workers = read_registry()
    active = {n: w for n, w in workers.items() if w["status"] != "SHELVED"}
    shelved = {n: w for n, w in workers.items() if w["status"] == "SHELVED"}
    if active:
        print_workers(focus, active)
    else:
        print("没有 worker。")
    if shelved:
        print("\n搁置（没有进程在跑；aidecamp wake 唤醒）：")
        rows = [("名字", "目录", "搁置于", "备注 / 最后一轮")]
        for n, w in shelved.items():
            rows.append((n, Path(w["dir"]).name, (w.get("shelved_at") or "")[:16].replace("T", " "),
                         (w.get("shelf_summary") or w.get("last_summary") or "").replace("\n", " ")[:60]))
        print_rows(rows)
    sessions = external_sessions()
    if sessions:
        print(f"\n不归 aidecamp 管的 Claude 会话（空闲的可以 aidecamp adopt 接管）：")
        print_rows(session_rows(sessions))


def print_workers(focus, workers):
    alive = alive_windows()
    rows = [("", "worker", "模型", "状态", "距今", "最近", "等你？")]
    for name, w in workers.items():
        status = w["status"]
        if status in LABELS:
            status = LABELS[status]
        elif w.get("mode") == "discuss" and status not in ("DONE", "FAILED"):
            status = "讨论中"
        if w.get("window") not in alive and status not in ("DONE", "FAILED"):
            status += "(窗口已关)"
        age = ""
        if w.get("last_report_at"):
            secs = (dt.datetime.now().astimezone() - dt.datetime.fromisoformat(w["last_report_at"])).total_seconds()
            age = f"{int(secs // 60)}m" if secs < 3600 else f"{secs / 3600:.1f}h"
        summary = (w.get("pending_ask") if w["status"] in LABELS else
                   w.get("last_summary") or w["task"]).replace("\n", " ")
        rows.append(("*" if name == focus else "", name, w["model"].replace("claude-", ""),
                     status, age, summary[:48], "← 是" if w["status"] in WAITING else ""))
    print_rows(rows)


def cmd_log(args):
    for header, body in read_log(args.name)[-args.n:]:
        print(f"=== {header}\n{body}\n")


def cmd_interrupt(args):
    _, workers = read_registry()
    w = workers.get(args.name) or sys.exit(f"no worker {args.name}")
    if not w.get("window"):
        sys.exit(f"{args.name} has no window (status {w['status']})")
    tmux("send-keys", "-t", w["window"], "Escape")
    print(f"sent Escape to {args.name}")


def cmd_peek(args):
    """The last lines of a worker's window, and whether its Claude is busy: look before you close."""
    w = read_registry()[1].get(args.name) or sys.exit(f"no worker {args.name}")
    if w.get("window") not in alive_windows():
        sys.exit(f"{args.name} has no window (status {w['status']})")
    holder = live_holder(w.get("session"))
    print(f"{args.name}: {holder.get('status', '?') if holder else 'no live claude'}")
    lines = [l for l in tmux("capture-pane", "-p", "-t", w["window"]).splitlines() if l.strip()]
    print("\n".join(lines[-args.n:]))


def cmd_close(args):
    with registry() as reg:
        w = reg["workers"].pop(args.name, None) or sys.exit(f"no worker {args.name}")
        if reg["focus"] == args.name:
            reg["focus"] = None
    if w.get("window"):
        tmux("kill-window", "-t", w["window"], check=False)
    note = "" if w.get("archived") else "（注意：未归档）"
    print(f"closed {args.name}{note}")


# ---------- history ----------

def index_add(rel, line):
    index = HOME / "history" / "INDEX.md"
    lines = index.read_text().splitlines() if index.exists() else ["# aidecamp 历史索引", ""]
    lines = [l for l in lines if f"→ {rel}" not in l] + [f"{line} → {rel}"]
    index.write_text("\n".join(lines) + "\n")


def history_file(date, name, previous):
    if previous:
        return HOME / "history" / previous
    d = HOME / "history" / date[:7]
    d.mkdir(parents=True, exist_ok=True)
    path, n = d / f"{date}-{name}.md", 2
    while path.exists():
        path, n = d / f"{date}-{name}-{n}.md", n + 1
    return path


def frontmatter(**kv):
    out = ["---"]
    for k, v in kv.items():
        out.append(f"{k}: {json.dumps(v, ensure_ascii=False)}")
    return "\n".join(out + ["---", ""])


def cmd_archive(args):
    tags = [t for t in (args.tags or "").split(",") if t]
    files = [f for f in (args.files or "").split(",") if f]
    date = dt.date.today().isoformat()
    if args.subagent:
        body = sys.stdin.read().strip()
        path = history_file(date, args.name, None)
        project = str(Path(args.dir).expanduser().resolve()) if args.dir else ""
        path.write_text(frontmatter(date=date, project=project, worker="subagent", session=None,
                                    status="DONE", files=files, tags=tags) +
                        f"## 任务\n{args.task or ''}\n\n## 结果\n{args.summary or ''}\n\n## 过程\n{body}\n")
        status = "DONE"
    else:
        _, workers = read_registry()
        w = workers.get(args.name) or sys.exit(f"no worker {args.name}")
        entries = read_log(args.name)
        final = {}
        for header, body in entries:
            if header.endswith("worker→secretary"):
                r = parse_report(body)
                if r.get("TYPE") in ("DONE", "FAILED"):
                    final = r
        user_decisions = [f"- {h.split()[0]} {b.strip()}" for h, b in entries
                          if h.endswith("secretary→worker") and b.lstrip().startswith("用户决策")]
        path = history_file(date, args.name, w.get("archived"))
        status = final.get("TYPE", w["status"])
        trace = "\n".join(f"=== {h}\n{b}" for h, b in entries)
        path.write_text(
            frontmatter(date=w["started_at"][:10], project=w["dir"], worker=args.name, model=w["model"],
                        session=w.get("session"), status=status, files=files, tags=tags) +
            f"## 任务\n{w['task']}\n\n"
            f"## 用户决策\n{chr(10).join(user_decisions) or '无'}\n\n"
            f"## 结果\n{final.get('RESULT') or args.summary or '（worker 未给出 RESULT）'}\n\n"
            f"## worker 决策\n{final.get('DECISIONS') or '（worker 未给出）'}\n\n"
            + (f"## 待办\n{final['TODO']}\n\n" if final.get("TODO") else "") +
            f"## 过程\n```\n{trace}\n```\n"
            f"\n完整 transcript：`claude --resume {w.get('session')}`\n")
        with registry() as reg:
            reg["workers"][args.name]["archived"] = str(path.relative_to(HOME / "history"))
    rel = str(path.relative_to(HOME / "history"))
    project = Path(args.dir or (read_registry()[1].get(args.name, {}).get("dir", ""))).name
    index_add(rel, f"- {date} · {project} · {args.name} · {status} · {args.summary or ''} · "
                   + " ".join(f"#{t}" for t in tags))
    print(f"archived → {path}")


LESSONS = "# 秘书的教训（用户说「复盘」时交给 aidecamp worker 归类，处理过的移到「已处理」）\n\n"


def cmd_lesson(args):
    path = HOME / "lessons.md"
    text = path.read_text() if path.exists() else LESSONS
    entry = f"- {dt.date.today().isoformat()} · {args.type} · {args.situation} · 「{args.correction}」\n"
    pending, mark, done = text.partition("\n## 已处理")  # new ones go above the reviewed ones
    path.write_text(pending.rstrip("\n") + "\n" + entry + (mark and "\n" + mark.lstrip("\n") + done))
    print("noted")


# ---------- hooks ----------

def hook_worker_session_start(name):
    data = hook_input()
    with registry() as reg:
        if name in reg["workers"]:
            reg["workers"][name]["session"] = data.get("session_id")


def hook_worker_report(name):
    data = hook_input()
    sec = config()["secretary_name"]
    inp = data.get("tool_input") or {}
    if not str(inp.get("to", "")).startswith(sec):
        return
    text = str(inp.get("message", ""))
    append_log(name, "worker→secretary", text)
    r = parse_report(text)
    typ = r.get("TYPE", "").split()[0] if r.get("TYPE") else "UNTYPED"
    with registry() as reg:
        w = reg["workers"].get(name)
        if w is not None:
            w["status"] = typ
            w["last_report_at"] = now()
            w["last_summary"] = (r.get("DID") or text).splitlines()[0][:200]
            w["pending_ask"] = r.get("ASK") if typ == "NEED_DECISION" else None
        if typ in TERMINAL:
            reg["focus"] = name
        discussion_over = w is not None and w.get("mode") == "discuss" and typ in ("DONE", "FAILED")
    (worker_dir(name) / "waiting-permission").unlink(missing_ok=True)
    if typ in TERMINAL:
        (worker_dir(name) / "reported").write_text(typ)
    if discussion_over:
        # Bring the user back to the secretary, who summarizes and offers to dispatch the to-dos.
        tmux("select-window", "-t", f"={config()['tmux_session']}:secretary", check=False)


def hook_worker_stop(name):
    data = hook_input()
    (worker_dir(name) / "last-stop.json").write_text(json.dumps(data, indent=2, ensure_ascii=False))
    permission_answered(name)
    with registry() as reg:  # a turn that ends normally is past any API error
        w = reg["workers"].get(name)
        if w is not None and w["status"] == "API_ERROR":
            w["status"] = w.pop("status_before", None) or "PROGRESS"
            w["pending_ask"] = None
    if data.get("background_tasks"):
        return  # waiting on its own background subagents; it will be woken and report then
    if read_registry()[1].get(name, {}).get("mode") == "discuss":
        return  # every turn of a discussion ends waiting for the user, who is in the window
    if not secretary_alive():
        return  # nobody to report to; the report, if any, is in the log and registry already
    marker = worker_dir(name) / "reported"
    if marker.exists() or data.get("stop_hook_active"):
        marker.unlink(missing_ok=True)
        return
    sec = config()["secretary_name"]
    print(json.dumps({"decision": "block", "reason":
        f"结束本轮前必须用 SendMessage(to: \"{sec}\") 发一条汇报，TYPE 为 "
        "DONE / FAILED / BLOCKED / NEED_DECISION 之一（PROGRESS 不算）。"
        "若用户刚在你的窗口直接跟你说过话，汇报里注明。"}, ensure_ascii=False))


def hook_secretary_session_start():
    data = hook_input()
    if data.get("session_id"):
        (HOME / "secretary.session").write_text(data["session_id"] + "\n")
    focus, workers = read_registry()
    out = [f"[aidecamp] 状态目录 {HOME}；你的宪法文件 {PROMPTS / 'secretary.md'}"]
    import io
    buf, old = io.StringIO(), sys.stdout
    sys.stdout = buf
    try:
        cmd_status(None)
    finally:
        sys.stdout = old
    out += ["", "当前状态（来自 registry，以此为准）：", buf.getvalue().rstrip()]
    index = HOME / "history" / "INDEX.md"
    if index.exists():
        lines = [l for l in index.read_text().splitlines() if l.startswith("- ")]
        if lines:
            out += ["", f"历史索引最近 {min(20, len(lines))} 条（全部见 {index}）：", *lines[-20:]]
    lessons = HOME / "lessons.md"
    if lessons.exists():
        n = sum(1 for l in open_part(lessons).splitlines() if l.startswith("- "))
        if n:
            out += ["", f"lessons.md 里有 {n} 条教训待复盘。"]
    queue = HOME / "queue.md"
    if queue.exists():
        todo = [l for l in open_part(queue).splitlines() if re.match(r"(\d+\.|-) ", l)]
        if todo:
            out += ["", f"决策队列 {queue} 里还有 {len(todo)} 件没定（一次只问用户一件）：", *todo]
    print("\n".join(out)[:9500])


def open_part(path):
    """A lessons or queue file up to its 「已处理」 section."""
    return path.read_text().split("\n## 已处理")[0]


def hook_secretary_send():
    data = hook_input()
    inp = data.get("tool_input") or {}
    to = str(inp.get("to", "")).split(" [")[0]
    with registry() as reg:
        if to not in reg["workers"]:
            return
        reg["focus"] = to
    append_log(to, "secretary→worker", str(inp.get("message", "")))


# ---------- dialogs: a worker waiting on the user ----------

def describe_request(tool, inp):
    what = (inp.get("command") or inp.get("file_path") or inp.get("notebook_path") or inp.get("url")
            or inp.get("path") or json.dumps(inp, ensure_ascii=False))
    return f"{tool}: {what}".replace("\n", " ")[:300]


def raise_alert(text):
    d = HOME / "alerts"
    d.mkdir(parents=True, exist_ok=True)
    tmp = d / f".{time.time_ns()}"
    tmp.write_text(text + "\n")
    tmp.rename(d / f"{time.time_ns()}.txt")


def hook_worker_permission(name):
    """A worker hit a permission dialog. PermissionRequest fires at once, also for calls that
    end up auto-approved, so only a prompt still open a few seconds later is announced."""
    data = hook_input()
    marker = worker_dir(name) / "waiting-permission"
    if data.get("hook_event_name") == "Notification":
        if marker.exists():
            return  # the same prompt, already being handled
        detail = data.get("message") or data.get("title") or "需要用户确认"
        delay = 0  # Claude Code only notifies after the prompt has waited ~6s
    else:
        detail = describe_request(data.get("tool_name", "?"), data.get("tool_input") or {})
        delay = 4
    token = str(time.time_ns())
    marker.write_text(json.dumps({"token": token, "detail": detail}, ensure_ascii=False))
    subprocess.Popen([str(SELF), "hook", "worker-permission-alert", name],
                     env={**os.environ, "AIDECAMP_HOME": str(HOME), "AIDECAMP_TOKEN": token, "AIDECAMP_DELAY": str(delay)},
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)


def hook_worker_permission_alert(name):
    time.sleep(float(os.environ.get("AIDECAMP_DELAY", "0")))
    marker = worker_dir(name) / "waiting-permission"
    try:
        m = json.loads(marker.read_text())
    except (OSError, ValueError):
        return  # answered meanwhile
    if m.get("token") != os.environ.get("AIDECAMP_TOKEN"):
        return
    with registry() as reg:
        w = reg["workers"].get(name)
        if w is None:
            return
        if w["status"] != "WAITING_PERMISSION":
            w["status_before"] = w["status"]
        w["status"] = "WAITING_PERMISSION"
        w["pending_ask"] = m["detail"]
        w["last_report_at"] = now()
        discuss = w.get("mode") == "discuss"
    append_log(name, "permission", m["detail"])
    if not discuss:  # in a discussion the user is already looking at the window
        raise_alert(f"worker {name} 卡在一个确认对话框上，等用户在窗口 {name} 里处理：{m['detail']}")


def hook_worker_stop_failure(name):
    """The turn died on an API error (a proxy's 524, an overload). The worker now idles at its
    prompt and will never report, so wake the secretary, who tells it to carry on."""
    data = hook_input()
    err = " ".join(str(data.get(k) or "") for k in ("error", "error_details")).strip() or "unknown error"
    err = err.replace("\n", " ")[:300]
    with registry() as reg:
        w = reg["workers"].get(name)
        if w is None:
            return
        if w["status"] not in ("API_ERROR", "WAITING_PERMISSION"):
            w["status_before"] = w["status"]
        w["status"] = "API_ERROR"
        w["pending_ask"] = err
        w["last_report_at"] = now()
        discuss = w.get("mode") == "discuss"
    append_log(name, "api-error", err)
    if not discuss:  # in a discussion the user is in the window and sees it
        raise_alert(f"worker {name} 这一轮因 API 错误中断，停在提示符上，不会自己汇报：{err}")


def permission_answered(name):
    marker = worker_dir(name) / "waiting-permission"
    if not marker.exists():
        return
    marker.unlink(missing_ok=True)
    with registry() as reg:
        w = reg["workers"].get(name)
        if w is not None and w["status"] == "WAITING_PERMISSION":
            w["status"] = w.pop("status_before", None) or "PROGRESS"
            w["pending_ask"] = None
            append_log(name, "permission", "answered")


def hook_worker_permission_done(name):
    hook_input()
    permission_answered(name)


def hook_secretary_watch():
    """Armed in the background at session start and every turn end; one instance at a time.
    Exits 2 with the pending alerts, which wakes the secretary (asyncRewake)."""
    data = hook_input()
    lock = open(HOME / "watch.lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return  # already armed
    owner = next((s["pid"] for s in claude_sessions() if s.get("sessionId") == data.get("session_id")),
                 os.getppid())
    alerts, done = HOME / "alerts", HOME / "alerts" / "delivered"
    done.mkdir(parents=True, exist_ok=True)
    while True:
        files = sorted(alerts.glob("*.txt"))
        if files:
            msgs = [f.read_text().strip() for f in files]
            for f in files:
                f.rename(done / f.name)
            print("[aidecamp 告警]\n" + "\n".join(msgs), file=sys.stderr)
            sys.exit(2)
        try:
            os.kill(owner, 0)
        except OSError:
            return  # the secretary is gone
        time.sleep(1)


HOOKS = {
    "worker-session-start": hook_worker_session_start,
    "worker-permission": hook_worker_permission,
    "worker-permission-alert": hook_worker_permission_alert,
    "worker-permission-done": hook_worker_permission_done,
    "secretary-watch": hook_secretary_watch,
    "worker-report": hook_worker_report,
    "worker-stop": hook_worker_stop,
    "worker-stop-failure": hook_worker_stop_failure,
    "secretary-session-start": hook_secretary_session_start,
    "secretary-send": hook_secretary_send,
}


def cmd_hook(args):
    fn = HOOKS[args.event]
    fn(args.name) if args.name else fn()


# ---------- cli ----------

def main():
    p = argparse.ArgumentParser(prog="aidecamp", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd")

    s = sub.add_parser("start"); s.add_argument("--new", action="store_true")
    s.add_argument("--restart", action="store_true")
    s.add_argument("-d", "--detach", action="store_true"); s.set_defaults(fn=cmd_start)
    s = sub.add_parser("run"); s.add_argument("--new", action="store_true"); s.set_defaults(fn=cmd_run)
    s = sub.add_parser("spawn"); s.add_argument("name"); s.add_argument("--dir", required=True)
    s.add_argument("--model"); s.add_argument("--discuss", action="store_true"); s.set_defaults(fn=cmd_spawn)
    s = sub.add_parser("status"); s.set_defaults(fn=cmd_status)
    s = sub.add_parser("log"); s.add_argument("name"); s.add_argument("-n", type=int, default=3)
    s.set_defaults(fn=cmd_log)
    s = sub.add_parser("interrupt"); s.add_argument("name"); s.set_defaults(fn=cmd_interrupt)
    s = sub.add_parser("close"); s.add_argument("name"); s.set_defaults(fn=cmd_close)
    s = sub.add_parser("peek"); s.add_argument("name"); s.add_argument("-n", type=int, default=15)
    s.set_defaults(fn=cmd_peek)
    s = sub.add_parser("sessions"); s.set_defaults(fn=cmd_sessions)
    s = sub.add_parser("adopt"); s.add_argument("session"); s.add_argument("--as", dest="as_name")
    s.add_argument("--model"); s.add_argument("--wait", action="store_true"); s.set_defaults(fn=cmd_adopt)
    s = sub.add_parser("shelve"); s.add_argument("name"); s.add_argument("--note")
    s.add_argument("--as", dest="as_name"); s.add_argument("--force", action="store_true")
    s.set_defaults(fn=cmd_shelve)
    s = sub.add_parser("wake"); s.add_argument("name"); s.add_argument("--model"); s.set_defaults(fn=cmd_wake)
    s = sub.add_parser("lifecycle"); s.add_argument("job", choices=["shelve-all", "wake-all"])
    s.add_argument("run_pid", type=int, nargs="?"); s.set_defaults(fn=cmd_lifecycle)
    s = sub.add_parser("archive"); s.add_argument("name"); s.add_argument("--summary")
    s.add_argument("--tags"); s.add_argument("--files"); s.add_argument("--subagent", action="store_true")
    s.add_argument("--task"); s.add_argument("--dir"); s.set_defaults(fn=cmd_archive)
    s = sub.add_parser("lesson"); s.add_argument("type"); s.add_argument("situation")
    s.add_argument("correction"); s.set_defaults(fn=cmd_lesson)
    s = sub.add_parser("hook"); s.add_argument("event", choices=HOOKS); s.add_argument("name", nargs="?")
    s.set_defaults(fn=cmd_hook)

    argv = sys.argv[1:]
    if not argv or argv[0].startswith("-") and argv[0] not in ("-h", "--help"):
        argv = ["start", *argv]
    args = p.parse_args(argv)
    if not getattr(args, "fn", None):
        p.print_help()
        return
    args.fn(args)


if __name__ == "__main__":
    main()

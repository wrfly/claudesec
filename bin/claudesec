#!/usr/bin/env python3
"""claudesec — a Claude secretary in tmux. See DESIGN.md.

Commands (the secretary calls these; you mostly only run `claudesec`):
  claudesec [start] [--new|--restart] [-d]   open the secretary in its own tmux session "claudesec"
                                    (resumes the last secretary; --new starts fresh; --restart reloads
                                    prompt and hooks keeping the conversation; -d don't switch)
  claudesec spawn NAME [--dir DIR] [--model M] [--discuss] [--agent claude|cursor] [--for WORKER] [--budget USD] < task.txt
                                    (no --dir: ~/.claudesec/work/NAME, made if missing;
                                    --discuss: a discussion window the user is switched into;
                                    --agent cursor: Cursor's `agent` CLI instead of Claude Code;
                                    --for: the worker that delegated it, named in its reports)
  claudesec report NAME < report.txt     a Cursor worker's report to the secretary
  claudesec remind WHEN TARGET TEXT [--every 1d]   a scheduled task (定时任务): wakes the secretary at WHEN
                                    (+30m, 09:05Z, 17:05, ISO) with TEXT for TARGET (a worker or `secretary`); --list [--all], --cancel ID
  claudesec queue add [--asked|--later] TEXT   a decision queue item with the next number (printed: #N);
                                    --asked: in 待答 (asked, waiting), --later: in 搁置 (put off)
  claudesec queue move N backlog|todo|doing|done|ideas [--note T]   item #N to 搁置 / 待问 / 待答 / 已处理 / 记录
                                    (queue add --idea: a note the user wants kept, not a question)
  claudesec queue list [--older DAYS]    open items with how long they have waited
  claudesec queue doctor [--fix]         check queue.md (line-number prefixes, doubled sections, …)
  claudesec queue number                 number the open queue items written without one
  claudesec notice add [--from W] TEXT   a to-do (待办事项): something for the user to do, not decide;
                                    notice done N, notice list
  claudesec show N                       the whole of queue item or to-do #N
  claudesec dashboard on|off              panes beside the secretary, top to bottom: to-dos, decisions,
                                    progress, scheduled tasks (on by default)
  claudesec review [--print]             spawn today's review worker: tidy the secretary's memory, propose prompt diffs
  claudesec send NAME < message.txt      the secretary's message to a Cursor worker
  claudesec model NAME MODEL [--force]   switch a worker's model: restart it on MODEL, conversation kept
  claudesec delegate ME --name N [--dir D] [--ack WHY] < task.txt   a worker hands a small job to Cursor
  claudesec wait N                       the delegator waits for N's final report (background Bash)
  claudesec status                       one-screen table of workers
  claudesec budget --until T [--usd N] [--from T] | --add N | --off   a spending window for all workers;
                                    wrap-up notice at 85%, frozen at 100%; no options: show it
  claudesec budget --worker NAME --usd N | --add N | --off   one worker's budget (spawn --budget N sets it)
  claudesec cost [NAME] [--today | --since T --until T]   spend by worker and model, at list prices
                                    (T: 3h / 2d ago, 09:00 today, 2026-10-25, or ISO)
  claudesec log NAME [-n N]              last N report entries of a worker
  claudesec interrupt NAME               send Escape to a worker's window
  claudesec close NAME                   kill a worker's window, drop it from the registry
  claudesec peek NAME [-n N]             last lines of a worker's window and whether it is busy
  claudesec sessions                     Claude sessions on this machine that claudesec does not manage
  claudesec adopt SESSION [--as NAME] [--wait]   take over an idle session (name, bg job id or session id;
                                            keeps its history); an exited session by its session id
  claudesec shelve NAME [--note N] [--force]   stop a worker or outside session, keep only its record
  claudesec wake NAME [--model M] [--dir D] [< instruction]   resume a shelved one in a new window (history
                                    kept); --dir: in D, for a worker whose directory moved
  claudesec redir OLD NEW                a directory moved (repo renamed): workers recorded in OLD go to NEW
  claudesec archive NAME [--summary S] [--tags a,b] [--files x,y]
  claudesec archive SLUG --subagent --task T --summary S [--tags ..] [--dir D] < body.md
  claudesec lesson TYPE SITUATION CORRECTION
  claudesec hook EVENT [NAME]            internal; called by Claude Code hooks
"""
import argparse
import contextlib
import datetime as dt
import fcntl
import functools
import hashlib
import io
import json
import os
import re
import select
import shlex
import shutil
import signal
import subprocess
import sys
import tempfile
import termios
import threading
import time
import tty
import unicodedata
from pathlib import Path

if sys.version_info < (3, 8):  # Path.unlink(missing_ok=), among others; Debian 10's python3 is 3.7
    sys.exit(f"claudesec needs Python 3.8 or later; {sys.executable} is {sys.version.split()[0]}")

HOME = Path(os.environ.get("CLAUDESEC_HOME", Path.home() / ".claudesec"))
SELF = Path(__file__).resolve()
REPO = SELF.parent.parent
PROMPTS = REPO / "prompts"


def claude_dir():
    """Claude Code's config dir. A launcher may set CLAUDE_CONFIG_DIR only for claude itself, so
    claudesec processes started by tmux don't see it; hooks run under claude and record it."""
    env = os.environ.get("CLAUDE_CONFIG_DIR")
    if env:
        return Path(env)
    try:
        saved = json.loads((HOME / "config.json").read_text()).get("claude_config_dir")
    except (OSError, ValueError):
        saved = None
    return Path(saved) if saved else Path.home() / ".claude"

DEFAULT_CONFIG = {
    "secretary_name": "secretary",
    "secretary_model": None,          # None = whatever claude defaults to
    "worker_model": "claude-opus-5-5",
    "worker_permission_mode": "auto",
    # GPT-5.6 Sol 1M High, the user's pick. Not "gpt-5.6-sol-high": --list-models labels that slug
    # 1M High, but it runs with a 272K context. Only the full variant string, parameters in this
    # order, gets 1M.
    "cursor_worker_model": "gpt-5.6-sol[context=1m,reasoning=high,fast=false]",
    "tmux_session": "claudesec",           # the secretary and all workers live in this tmux session
    "cursor": "auto",                 # Cursor workers: "auto" = if the `agent` command is installed; true; false
    # Runaway alerts for workers without a budget of their own: spent more than this share of the
    # budget window's cap, or more than runaway_usd since a report runaway_quiet_minutes ago.
    "runaway_pool_share": 0.3,
    "runaway_usd": 20,
    "runaway_quiet_minutes": 60,
    "cursor_max_running": None,       # local Cursor workers at work at once; spawn / wake / delegate past it
                                      # refuse. None: half the CPU cores (at least 1); 0: no limit
    "cursor_nice": 10,                # their CPU priority (`nice -n`): they yield to the rest of the machine
    "dashboard": True,                # queue and progress panes beside the secretary (`claudesec dashboard off`)
    "language": None,                 # what the panes, status and queue say: "zh", "en"; None = see lang()
}
TERMINAL = {"DONE", "FAILED", "BLOCKED", "NEED_DECISION"}
CURSOR_REPORT = "（不是告警）Cursor worker 的汇报，经告警通道送达，按普通汇报处理"
CURSOR_REPORT_EN = "(not an alert) Cursor worker report, come by the alert channel; handle it as an ordinary report"
WAITING = {"BLOCKED", "NEED_DECISION", "WAITING_PERMISSION"}
LABELS = {"WAITING_PERMISSION": "等你批权限", "API_ERROR": "API 出错"}  # English: STATUS_LOOK
NAME_RE = re.compile(r"^[a-z0-9][a-z0-9-]{0,31}$")


# ---------- state ----------

def now():
    return dt.datetime.now().astimezone().isoformat(timespec="seconds")


def config():
    path = HOME / "config.json"
    if not path.exists():
        HOME.mkdir(parents=True, exist_ok=True)
        # Whole or not at all: another claudesec reading it mid-write got an empty file.
        tmp = path.with_suffix(f".{os.getpid()}.tmp")
        tmp.write_text(json.dumps(DEFAULT_CONFIG, indent=2, ensure_ascii=False) + "\n")
        tmp.replace(path)
    return {**DEFAULT_CONFIG, **json.loads(path.read_text())}


@functools.lru_cache(maxsize=None)
def lang():
    """"en" or "zh", for the dashboard, `status` and `queue`: config "language", else Claude Code's
    own `language` setting when it names English, else Chinese, which the prompts are written in.
    Not the locale: plenty of Chinese users run en_US.UTF-8."""
    want = str(config().get("language") or "").lower()
    if not want:
        with contextlib.suppress(OSError, ValueError, AttributeError):
            want = str(json.loads((claude_dir() / "settings.json").read_text()).get("language") or "").lower()
    return "en" if want.startswith("en") else "zh"


def tr(zh, en):
    return en if lang() == "en" else zh


@contextlib.contextmanager
def registry():
    """Locked read-modify-write of registry.json; hooks from several workers can race."""
    HOME.mkdir(parents=True, exist_ok=True)
    with open(HOME / "registry.lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        path = HOME / "registry.json"
        reg = json.loads(path.read_text()) if path.exists() else {}
        reg.setdefault("focus", None)
        reg.setdefault("workers", {})
        yield reg
        tmp = path.with_suffix(".tmp")
        tmp.write_text(json.dumps(reg, indent=2, ensure_ascii=False) + "\n")
        tmp.replace(path)


def read_registry():
    path = HOME / "registry.json"
    reg = json.loads(path.read_text()) if path.exists() else {}
    return reg.get("focus"), reg.get("workers", {})


def worker_dir(name):
    d = HOME / "workers" / name
    d.mkdir(parents=True, exist_ok=True)
    return d


def log_path(name):
    (HOME / "reports").mkdir(parents=True, exist_ok=True)
    return HOME / "reports" / f"{name}.log"


def append_log(name, direction, text):
    with open(log_path(name), "a") as f:
        f.write(f"=== {now()} {direction}\n{text.rstrip()}\n")


def read_log(name):
    """Return [(header, body)] entries of a worker's report log."""
    path = log_path(name)
    if not path.exists():
        return []
    entries, cur = [], None
    for line in path.read_text().splitlines():
        if line.startswith("=== "):
            cur = [line[4:], []]
            entries.append(cur)
        elif cur:
            cur[1].append(line)
    return [(h, "\n".join(b)) for h, b in entries]


def parse_report(text):
    """'KEY: value' lines; a value continues until the next KEY line."""
    fields, key = {}, None
    for line in text.splitlines():
        m = re.match(r"^([A-Z_]+):\s?(.*)$", line)
        if m:
            key = m.group(1)
            fields[key] = m.group(2)
        elif key:
            fields[key] += "\n" + line
    return {k: v.strip() for k, v in fields.items()}


def width(s):
    return sum(2 if unicodedata.east_asian_width(c) in "WF" else 1 for c in s)


def pad(s, n):
    return s + " " * (n - width(s))


def tmux(*args, check=True):
    return subprocess.run(["tmux", *args], capture_output=True, text=True, check=check).stdout


SGR = re.compile(r"\x1b\[([0-9;:]*)m")
OTHER_ESCAPE = re.compile(r"\x1b(?:\[[0-9;:?]*[ -/]*[@-~]|\][^\x07\x1b]*(?:\x07|\x1b\\)|[()][0-9A-Za-z]|[=>78])")


def dim_runs(line):
    """A captured line with SGR escapes as (text, dim) runs; other escapes dropped."""
    runs, dim, pos = [], False, 0
    for m in SGR.finditer(line):
        runs.append((line[pos:m.start()], dim))
        params = (m.group(1) or "0").split(";")
        i = 0
        while i < len(params):
            p = params[i]
            if p in ("38", "48", "58"):  # extended colour: 5;n or 2;r;g;b, whose numbers aren't attributes
                i += 2 if params[i + 1:i + 2] == ["5"] else 4 if params[i + 1:i + 2] == ["2"] else 0
            elif p in ("", "0", "22"):
                dim = False
            elif p == "2":
                dim = True
            i += 1
        pos = m.end()
    runs.append((line[pos:], dim))
    runs = [(OTHER_ESCAPE.sub("", t), d) for t, d in runs]
    return [(t, d) for t, d in runs if t]


def pane_text(target, suggestion="mark"):
    """A pane's text. In the input box after ❯, Claude Code shows the prompt it suggests next (or
    a placeholder) dimmed, which plain text can't tell from a draft the user typed and didn't
    send. Dimmed text there is dropped; with suggestion="mark", a box holding only that shows it
    as 「CC 建议」."""
    out = []
    for line in tmux("capture-pane", "-p", "-e", "-t", target, check=False).splitlines():
        runs = dim_runs(line)
        plain = "".join(t for t, _ in runs)
        if plain.startswith("❯"):
            (first, first_dim), *more = runs
            rest = [(first[1:], first_dim), *more]  # the ❯ itself is styled either way
            typed = "".join(t for t, d in rest if not d)
            ghost = "".join(t for t, d in rest if d).strip()
            if ghost and not typed.strip():
                plain = tr(f"❯ 【CC 建议，不是用户输入】{ghost}", f"❯ [CC suggestion, not user input] {ghost}") \
                    if suggestion == "mark" else "❯"
            else:
                plain = "❯" + typed
        out.append(plain)
    return "\n".join(out)


def alive_windows():
    out = tmux("list-windows", "-a", "-F", "#{window_id}", check=False)
    return set(out.split())


def hook_cmd():
    return f"CLAUDESEC_HOME={shlex.quote(str(HOME))} {shlex.quote(str(SELF))}"


def hook_input():
    remember_claude_dir()
    try:
        return json.load(sys.stdin)
    except Exception:
        return {}


def remember_claude_dir():
    env = os.environ.get("CLAUDE_CONFIG_DIR")
    if not env:
        return
    path = HOME / "config.json"
    try:
        cfg = json.loads(path.read_text())
    except (OSError, ValueError):
        return
    if cfg.get("claude_config_dir") != env:
        cfg["claude_config_dir"] = env
        tmp = path.with_suffix(f".{os.getpid()}.tmp")
        tmp.write_text(json.dumps(cfg, indent=2, ensure_ascii=False) + "\n")
        tmp.replace(path)


# ---------- secretary ----------

def has_session(name):
    return subprocess.run(["tmux", "has-session", "-t", f"={name}"], capture_output=True).returncode == 0


def secretary_runs_claudesec(sess, pane):
    """Is the secretary's pane running `claudesec run` (directly, or under the shell tmux started)?"""
    out = tmux("display-message", "-p", "-t", pane, "#{pane_dead} #{pane_pid}", check=False).split()
    if len(out) != 2 or out[0] != "0":
        return False
    try:
        kids = Path(f"/proc/{out[1]}/task/{out[1]}/children").read_text().split()
    except OSError:
        kids = []
    return any(is_claudesec_run(pid) for pid in [out[1], *kids])


def extended_keys():
    """Let Shift+Enter (a newline in Claude Code) through tmux: tmux asks the outer terminal to
    report modified keys apart (Shift+Enter is otherwise just Enter) only with extended-keys on
    and the terminal listed with the extkeys feature. Server options, so the user's own sessions on this server get them too; harmless there (a
    program gets extended keys only when it asks). A client attached before this needs to
    reattach. The outer terminal must send Shift+Enter apart from Enter: GNOME Terminal (VTE)
    doesn't, whatever tmux does; Ctrl+J or Alt+Enter work there."""
    if tmux("show-options", "-sv", "extended-keys", check=False).strip() == "off":
        tmux("set-option", "-s", "extended-keys", "on", check=False)
    features = tmux("show-options", "-sv", "terminal-features", check=False)
    if not re.search(r"^xterm\*:.*\bextkeys\b", features, re.M):
        tmux("set-option", "-as", "terminal-features", "xterm*:extkeys", check=False)


def cmd_start(args):
    """Put the secretary in its own tmux session, then switch or attach to it."""
    sess = config()["tmux_session"]
    remember_claude_dir()
    run = f"CLAUDESEC_HOME={shlex.quote(str(HOME))} {shlex.quote(str(SELF))} run" + (" --new" if args.new else "")
    pane = secretary_pane(sess) if has_session(sess) else None
    if pane is None and has_session(sess) and "secretary" in tmux(
            "list-windows", "-t", f"={sess}", "-F", "#{window_name}").split():
        tmux("kill-window", "-t", f"={sess}:secretary", check=False)  # only dashboards left in it
    if not has_session(sess):
        pane = tmux("new-session", "-d", "-s", sess, "-n", "secretary", "-c", str(HOME),
                    "-P", "-F", "#{pane_id}", run).strip()
    elif pane is None:
        pane = tmux("new-window", "-t", f"={sess}:", "-n", "secretary", "-c", str(HOME),
                    "-P", "-F", "#{pane_id}", run).strip()
    else:
        wrapped = secretary_runs_claudesec(sess, pane)
        if args.new or args.restart or not wrapped:
            # --restart: same conversation, freshly loaded prompt and hooks. Not wrapped: a restored
            # tmux layout left a shell or a bare `claude --resume` in the window; take it over.
            if wrapped:  # the exiting `claudesec run` sees this and leaves the workers running
                (HOME / "restarting").write_text(str(time.time()))
            # Before the respawn: run by the secretary itself (`claudesec --restart -d` from its
            # Bash), this process dies with it, and nothing after the respawn happens.
            tmux("set-option", "-p", "-t", pane, "@claudesec-role", "secretary", check=False)
            with contextlib.suppress(Exception):
                arrange_dashboard(sess)
            tmux("respawn-pane", "-k", "-t", pane, "-c", str(HOME), run)
    tmux("set-option", "-p", "-t", pane, "@claudesec-role", "secretary", check=False)
    extended_keys()
    arrange_dashboard(sess)
    # Keep this session out of tmux-resurrect's saved layouts (a post-save hook that honours
    # @resurrect-skip drops it): restored, its panes would be bare `claude --resume`s without
    # claudesec's prompts and hooks. `claudesec` starts the secretary itself; its wake-all brings the workers.
    tmux("set-option", "-t", f"={sess}:", "@resurrect-skip", "on", check=False)
    # Re-arrange when the terminal changes size: fewer panes, or none, on a narrow one.
    for hook in ("client-resized", "client-attached"):
        tmux("set-hook", "-t", sess, hook,  # set-hook takes no "=" exact-match prefix
             f"run-shell -b {shlex.quote(hook_cmd() + ' dashboard layout')}", check=False)
    if args.detach:
        print(f"secretary is in tmux session '{sess}'")
    elif os.environ.get("TMUX"):
        tmux("switch-client", "-t", f"={sess}")
    else:
        os.execvp("tmux", ["tmux", "attach-session", "-t", f"={sess}"])


# ---------- dashboard: to-dos, decisions, progress and scheduled tasks beside the secretary ----------
# Panes in the secretary's window, told apart by the pane option @claudesec-role (secretary /
# notices / queue / status / reminders). Laid out by `arrange_dashboard`, run at every start and when a client resizes;
# each dashboard pane redraws itself every few seconds, scrolls on the wheel and keys, and exits
# with the secretary.

DASH_MIN = 110    # window columns below which the secretary keeps the whole window
DASH_SHARE = 36   # percent of the window the dashboard column takes
DASH_REFRESH = 3
DASH_PANES = ("notices", "queue", "status", "reminders")  # top to bottom (the user, 2026-10-27)
DASH_SIDE = "right"  # of the secretary; config.json "dashboard_side": "left" puts the column there


def window_panes(target):
    """(pane id, role, index) of each pane in target's window; role is "" when unmarked. A pane
    running `claudesec dashboard show X` that lost its mark, or an older claudesec never set the
    one asked for, is a dashboard pane all the same: role X."""
    out = tmux("list-panes", "-t", target, "-F",
               "#{pane_id}|#{@claudesec-role}|#{pane_index}|#{pane_start_command}", check=False)
    panes = []
    for line in out.splitlines():
        parts = line.split("|", 3)
        if len(parts) < 3:
            continue
        pane, role, index = parts[:3]
        shown = re.search(r"\bdashboard show(?:\s+(\w+))?", parts[3] if len(parts) > 3 else "")
        if not role and shown:
            role = shown[1] or "status"
        panes.append((pane, role, index))
    return panes


def dash_layout(cfg):
    """What the dashboard column looks like in this version: its panes and side. Each pane
    carries it (@claudesec-layout), so panes an older version laid out differently, or before
    panes carried it, are rebuilt rather than kept."""
    return ",".join(DASH_PANES) + ":" + cfg.get("dashboard_side", DASH_SIDE)


def secretary_pane(sess):
    """The secretary's pane id: the one marked so, else (a window from before the dashboard,
    or a restored layout) the first unmarked pane of the secretary window."""
    panes = window_panes(f"={sess}:secretary")
    marked = [p for p, role, _ in panes if role == "secretary"]
    if marked:
        return marked[0]
    plain = sorted((int(i), p) for p, role, i in panes if not role and i.isdigit())
    return plain[0][1] if plain else None


def arrange_dashboard(sess):
    """Make the secretary window's panes match its width and the `dashboard` setting. One at a
    time: `claudesec start` arranges, and the client-attached hook it sets fires `dashboard layout`
    in the background as the terminal attaches; both saw no panes and each split the window."""
    with open(HOME / "dashboard.lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        arrange_dashboard_locked(sess)


def arrange_dashboard_locked(sess):
    sec = secretary_pane(sess)
    if not sec:
        return
    tmux("set-option", "-p", "-t", sec, "@claudesec-role", "secretary", check=False)
    width = int(tmux("display", "-p", "-t", sec, "#{window_width}", check=False).strip() or 0)
    cfg = config()
    want = list(DASH_PANES) if cfg.get("dashboard", True) and width >= DASH_MIN else []
    # "both" is the combined pane earlier versions put in a narrower window. A list, not a dict
    # by role: a doubled dashboard must not pass for the wanted one.
    have = [(role, p) for p, role, _ in window_panes(sec) if role in (*DASH_PANES, "both", "dashboard")
            or role and role != "secretary"]  # any other mark is a dashboard role of another version
    layout = dash_layout(cfg)
    stamps = {tmux("show-options", "-pqv", "-t", p, "@claudesec-layout", check=False).strip() for _, p in have}
    if sorted(role for role, _ in have) == sorted(want) and (not want or stamps == {layout}):
        return
    for _, p in have:
        tmux("kill-pane", "-t", p, check=False)
    if not want:
        return
    dash = f"{hook_cmd()} dashboard show"
    left = ["-b"] if cfg.get("dashboard_side", DASH_SIDE) == "left" else []
    prev = tmux("split-window", "-d", "-h", *left, "-l", f"{DASH_SHARE}%", "-t", sec, "-c", str(HOME),
                "-P", "-F", "#{pane_id}", f"{dash} {want[0]}").strip()
    tmux("set-option", "-p", "-t", prev, "@claudesec-role", want[0], check=False)
    tmux("set-option", "-p", "-t", prev, "@claudesec-layout", layout, check=False)
    for i, role in enumerate(want[1:], 1):  # each split leaves the panes above an equal share
        left_n = len(want) - i
        prev = tmux("split-window", "-d", "-v", "-l", f"{100 * left_n // (left_n + 1)}%", "-t", prev,
                    "-c", str(HOME), "-P", "-F", "#{pane_id}", f"{dash} {role}").strip()
        tmux("set-option", "-p", "-t", prev, "@claudesec-role", role, check=False)
        tmux("set-option", "-p", "-t", prev, "@claudesec-layout", layout, check=False)
    tmux("select-pane", "-t", sec, check=False)  # focus stays with the secretary


# A dashboard line is a list of (style, text) segments, style an SGR parameter string ("" plain);
# `paint` turns one into what the terminal gets.
BOLD, DIM, REV, RED, GREEN, YELLOW, CYAN = "1", "2", "7", "31", "32", "33", "36"
CLOSING, OPENING = set("，。、；：？！）」』》】,.;:?!)]}…"), set("（「『《【([{")


def paint(segs):
    return "".join(f"\x1b[{style}m{text}\x1b[0m" if style else text for style, text in segs if text)


def cut(text, cols):
    """The longest start of text that fits in cols display columns."""
    used = 0
    for i, ch in enumerate(text):
        used += width(ch)
        if used > cols:
            return text[:i]
    return text


def fit(segs, cols):
    """segs cut to cols display columns, the last one fitting ending in "…"."""
    out, used = [], 0
    for style, text in segs:
        if used + width(text) <= cols:
            out.append((style, text))
            used += width(text)
            continue
        if cols - used > 0:
            out.append((style, cut(text, cols - used - 1) + "…"))
        break
    return out


def wrap(segs, first, rest=None):
    """segs laid out in lines of first, then rest, display columns. Lines break at spaces and
    between CJK characters, not inside a Latin word unless it's longer than a line, and not
    before a closing mark or after an opening one."""
    rest = first if rest is None else rest
    toks = []
    for style, text in segs:
        for t in re.findall(r"[!-~]+|\s+|.", text):
            prev = toks[-1] if toks else None
            if prev and prev[0] == style and not t.isspace() and not prev[1].isspace() and (
                    t[0] in CLOSING or prev[1][-1] in OPENING):
                toks[-1] = (style, prev[1] + t)
            else:
                toks.append((style, t))
    lines, used, room = [[]], 0, first
    for style, t in toks:
        if t.isspace():
            if used and used + width(t) < room:
                lines[-1].append((style, " "))
                used += 1
            elif used:
                lines.append([])
                used, room = 0, rest
            continue
        if used + width(t) > room and used:
            while lines[-1] and lines[-1][-1][1] == " ":
                lines[-1].pop()
            lines.append([])
            used, room = 0, rest
        while width(t) > room:  # a word longer than a line
            head = cut(t, room) or t[0]
            lines[-1].append((style, head))
            lines.append([])
            t, used, room = t[len(head):], 0, rest
        lines[-1].append((style, t))
        used += width(t)
    return lines


def bar(left, right, cols):
    """A full-width title bar: left at the start, right at the end; only right when both
    don't fit."""
    gap = cols - width(left) - width(right)
    text = left + " " * gap + right if gap >= 2 else cut(" " + right.strip(), cols)
    return [(BOLD + ";" + REV, text + " " * (cols - width(text)))]


def heading(label, cols):
    return [(BOLD, label), (DIM, " " + "─" * max(0, cols - width(label) - 1))]


def ago(stamp, now=None):
    """How long ago an ISO time or date was: 5m, 3h, 2d."""
    now = now or dt.datetime.now().astimezone()
    t = dt.datetime.fromisoformat(stamp)
    if t.tzinfo is None:
        t = t.astimezone()
    secs = max(0, (now - t).total_seconds())
    return f"{int(secs // 60)}m" if secs < 3600 else f"{int(secs // 3600)}h" if secs < 86400 \
        else f"{int(secs // 86400)}d"


PRIORITY = {"高": RED, "中": YELLOW, "低": DIM, "high": RED, "medium": YELLOW, "med": YELLOW, "low": DIM}


def priority_color(note):
    word = re.match(r"[^\s,，;；]+", note or "")
    return PRIORITY.get(word[0].lower() if word else "", "")


# A queue.md item: "- #12 [web] question（中）". The number is the item's for good (the user
# answers by it); older files numbered items "1." or "0d." with no "#".
QUEUE_ITEM = re.compile(r"\s*(?:[0-9A-Za-z]{1,4}\.|[-*])\s+(?:#(\d+)\s+)?(\S.*)")


# queue.md's sections, a backlog -> todo -> doing -> done flow: 搁置 the user put off (not asked
# until they bring it up), 待问 to ask one by one, 待答 asked and waiting for the answer,
# 已处理 decided. Files from before 搁置 called 待答 「已问未答」.
QUEUE_SECTIONS = {"ideas": ("记录", "Ideas"), "backlog": ("搁置", "Backlog"), "todo": ("待问", "To ask"),
                  "doing": ("待答", "Waiting"), "done": ("已处理", "Done")}
QUEUE_ALIASES = {"ideas": ("idea", "notes"), "backlog": ("later",), "todo": ("todo",),
                 "doing": ("已问未答", "doing", "asked"), "done": ()}
# What a paste of Read's numbered output leaves in front of each line ("  12\t"), once per paste
LINE_NUMBER = re.compile(r"^(?: *\d+\t)+")


def section_name(key):
    return tr(*QUEUE_SECTIONS[key])


def queue_section(heading):
    """The section a "## …" line starts: backlog, todo, doing, done, or None. Chinese and English
    headings both, whichever language wrote the file."""
    low = heading.lower()
    return next((key for key, words in QUEUE_SECTIONS.items()
                 if any(w.lower() in low for w in (*words, *QUEUE_ALIASES[key]))), None)


def repair_queue(lines):
    """(lines, problems): queue.md as it should be, and what was wrong with it. Line-number
    prefixes from a pasted Read are stripped (2026-10-25: up to three on every line); a section
    that appears twice, as it did once a damaged file's headings went unrecognized and four new
    ones were appended, is merged into one: items in the order found, 已处理's later ones first."""
    problems = []
    numbered = sum(1 for line in lines if LINE_NUMBER.match(line))
    if numbered:
        lines = [LINE_NUMBER.sub("", line) for line in lines]
        problems.append(tr(f"{numbered} 行前面有行号", f"{numbered} lines had line numbers in front"))
    heads = [i for i, line in enumerate(lines) if line.startswith("## ") and queue_section(line)]
    keys = [queue_section(lines[i]) for i in heads]
    twice = [k for k in QUEUE_SECTIONS if keys.count(k) > 1]
    if not twice:
        return lines, problems
    problems.append(tr("分区重复：", "sections twice: ") + tr("、", ", ").join(section_name(k) for k in twice))
    blocks = {}
    for n, i in enumerate(heads):
        body = lines[i + 1:heads[n + 1] if n + 1 < len(heads) else len(lines)]
        while body and not body[0].strip():
            body = body[1:]
        while body and not body[-1].strip():
            body = body[:-1]
        if keys[n] not in blocks:
            blocks[keys[n]] = (lines[i], body)
        elif keys[n] == "done":  # newest first
            blocks["done"] = (blocks["done"][0], body + [""] + blocks["done"][1])
        else:
            blocks[keys[n]] = (blocks[keys[n]][0], blocks[keys[n]][1] + body)
    out = lines[:heads[0]]
    for key in QUEUE_SECTIONS:
        if key in blocks:
            head, body = blocks[key]
            out += [head, ""] + body + ([""] if body else [])
    return out, problems


def queue_text():
    """queue.md as read, repaired (not written back; any `claudesec queue` command does that)."""
    path = HOME / "queue.md"
    return "\n".join(repair_queue(path.read_text().splitlines())[0]) if path.exists() else ""


def queue_items(text):
    """The undecided items of queue.md: (section, number, tag, body, note), section "ideas",
    "backlog", "todo" or "doing", number None when it has none, note the trailing （中，…） or the
    date it was asked."""
    items, section = [], None
    for line in repair_queue(text.splitlines())[0]:
        if line.startswith("## "):
            section = queue_section(line)
            section = None if section == "done" else section
            continue
        m = QUEUE_ITEM.match(line)
        if not section or not m:
            continue
        num, body = m[1] and int(m[1]), m[2].strip()
        tag = re.match(r"\[([^\]]+)\]\s*", body)
        if tag:
            tag, body = tag[1], body[tag.end():]
        note = re.match(r"(\d{4}-\d{2}-\d{2})\s*(?:已问|asked)[:：]\s*", body, re.I)
        if note:
            note, body = note[1], body[note.end():]
        else:
            note = re.search(r"\s*[（(]([^（）()]*)[）)]\s*$", body)
            if note and priority_color(note[1]):
                note, body = note[1], body[:note.start()]
            else:
                note = None
        items.append((section, num, tag, body, note))
    return items


def paren(text):
    return tr(f"（{text}）", f" ({text})")


def queue_meta():
    """{number: {"added": date}} for queue items, kept beside queue.md so hand edits of the file
    don't lose it. Items from before it have no date."""
    with contextlib.suppress(OSError, ValueError):
        return json.loads((HOME / "queue-meta.json").read_text())
    return {}


def note_added(num):
    meta = queue_meta()
    meta.setdefault(str(num), {})["added"] = dt.date.today().isoformat()
    tmp = HOME / f".queue-meta.{os.getpid()}.tmp"
    tmp.write_text(json.dumps(meta, indent=1) + "\n")
    os.replace(tmp, HOME / "queue-meta.json")


def item_age(num, section, note, meta=None):
    """Days an open item has waited: since it was asked (待答), else since it was added; None
    when unknown."""
    when = note if section == "doing" else (meta if meta is not None else queue_meta()).get(str(num), {}).get("added")
    with contextlib.suppress(TypeError, ValueError):
        return (dt.date.today() - dt.date.fromisoformat(when)).days
    return None


# A pane's body is a list of blocks (key, folded, unfolded): the lines of one item folded to one
# line, and all of them. Headings and spacing have key None and don't fold. Everything starts
# folded; a click on an item unfolds it, a click on the title bar (or Tab) does all of them.

def fixed(*lines):
    return None, list(lines), list(lines)


def foldable(key, full, short):
    """A block that unfolds to full; one-line items are the same either way."""
    return key, (full if len(full) == 1 else [short]), full


def queue_blocks(cols):
    """The decision queue pane: (title bar, blocks)."""
    path = HOME / "queue.md"
    items = queue_items(path.read_text() if path.exists() else "")
    ask = [i for i in items if i[0] == "todo"]
    asked = [i for i in items if i[0] == "doing"]
    later = [i for i in items if i[0] == "backlog"]
    ideas = [i for i in items if i[0] == "ideas"]
    meta = queue_meta()
    title = bar(tr(" 决策队列", " Decisions"),
                f"{section_name('todo')} {len(ask)}  {section_name('doing')} {len(asked)} ", cols)
    if not ask and not asked:
        blocks = [fixed([(DIM, tr("没有要你定的事。", "Nothing for you to decide."))])]
    else:
        blocks, num_w = [], max(len(str(i[1] or "·")) for i in ask + asked)
    for label, group in ((section_name("todo"), ask), (section_name("doing"), asked)) if ask or asked else ():
        if not group:  # the title bar says it's 0
            continue
        blocks += [fixed([])] if blocks else []
        blocks.append(fixed(heading(f"{label} {len(group)}", cols)))
        for section, num, tag, text, note in group:
            if section == "doing":  # the number dim once asked; before that colored by priority
                try:  # an item written without its date has its priority here, or nothing
                    days = (dt.date.today() - dt.date.fromisoformat(note)).days
                except (TypeError, ValueError):
                    days = None
                color, tail = DIM, (paren(note) if note else "") if days is None else \
                    paren(tr("今天问的", "asked today")) if days < 1 else \
                    paren(tr("昨天问的", "asked yesterday")) if days == 1 else \
                    paren(tr(f"{days} 天前问的", f"asked {days} days ago"))
            else:
                color, tail = priority_color(note), paren(note) if note else ""
            head = [(BOLD + ";" + color if color else BOLD, str(num or "·").rjust(num_w)), ("", " ")]
            name = [(CYAN, tag), ("", " ")] if tag else []
            lines = wrap(name + [("", text), (DIM, tail)], cols - num_w - 1)
            full = [head + lines[0]] + [[("", " " * (num_w + 1))] + line for line in lines[1:]]
            age = item_age(num, section, note, meta)
            age = f"{age}d" if age else ""  # how long it has waited; nothing on its first day
            short = fit(head + name + [("", text)], cols - (len(age) + 1 if age else 0))
            if age:
                short += [("", " " * (cols - sum(width(t) for _, t in short) - len(age))), (DIM, age)]
            # with an age the folded line differs from the full one even when the item fits on one
            blocks.append((("q", num, tag, text), [short], full) if age else foldable(("q", num, tag, text), full, short))
    for key, group in (("backlog", later), ("ideas", ideas)):  # not questions: one line each until opened
        if not group:
            continue
        names = tr("；", "; ").join(f"{f'#{n} ' if n else ''}{f'[{tag}] ' if tag else ''}{text}"
                                   for _, n, tag, text, _ in group)
        segs = [(BOLD, f"{section_name(key)} {len(group)}"), ("", "  "), (DIM, names)]
        lines = wrap(segs, cols, cols - 2)
        blocks += [fixed([]), foldable((key,), [lines[0]] + [[("", "  ")] + l for l in lines[1:]],
                                       fit(segs, cols))]
    return title, blocks


# How each status shows in the progress pane: group (the order they're listed in), mark, word, color
STATUS_LOOK = {
    "NEED_DECISION": (0, "!", ("要你拍板", "needs your call"), YELLOW),
    "BLOCKED": (0, "!", ("卡住了", "blocked"), YELLOW),
    "WAITING_PERMISSION": (0, "!", ("等你批权限", "needs permission"), YELLOW),
    "API_ERROR": (1, "✗", ("API 出错", "API error"), RED),
    "FAILED": (1, "✗", ("失败了", "failed"), RED),
    "STARTING": (2, "▸", ("启动中", "starting"), CYAN),
    "PROGRESS": (2, "▸", ("进行中", "working"), GREEN),
    "DONE": (3, "✓", ("做完了", "done"), DIM),
}


def short_model(model):
    """A model id as the progress pane shows it, short: claude-opus-5-5 → opus-5-5,
    gpt-5.6-sol-high → 5.6-sol-high, a Cursor variant gpt-5.6-sol[context=1m,...] → 5.6-sol 1m."""
    model = re.sub(r"^(claude|gpt)-", "", model or "")
    m = re.match(r"([^\[]+)\[(.*)\]$", model)
    if not m:
        return model
    ctx = re.search(r"context=([^,\]]+)", m[2])
    return m[1] + (f" {ctx[1]}" if ctx else "")


def status_line(cols, focused, name, mark, word, color, summary, age, tokens, model, widths, money=""):
    """A worker's folded line: name (summary) status age tokens $ model, the last ones in columns
    at the right. Short of room, the tokens go first (the unfolded lines have them), then the
    model, then the $; then the summary shrinks to nothing. The name and status stay."""
    name_w, word_w, tok_w, model_w, *rest = widths
    money_w = rest[0] if rest else width(money)
    head = [(BOLD + ";" + color if color else BOLD, mark), ("", " "),
            (BOLD + (";4" if focused else ""), cut(name, name_w).ljust(name_w))]
    status = [("", "  "), (color, word + " " * (word_w - width(word)))]
    tails = {"age": [("", "  "), (DIM, f"{age:>3}")], "tokens": [("", "  "), (DIM, f"{tokens:>{tok_w}}")]}
    if money_w:
        tails["money"] = [("", "  "), (DIM, f"{money:>{money_w}}")]
    if model_w:
        tails["model"] = [("", "  "), (DIM, model + " " * (model_w - width(model)))]
    drop = [k for k in ("tokens", "model", "money") if k in tails]
    while True:
        right = status + [seg for t in tails.values() for seg in t]
        room = cols - sum(width(t) for _, t in head + right)
        if room >= 12 or not drop:
            break
        del tails[drop.pop(0)]
    if room >= 8:  # " (" + at least a few characters + ")"
        text = cut(summary, room - 3)
        text = text if text == summary else cut(summary, room - 4) + "…"
        mid = [("", " "), (DIM, f"({text})")]
        mid.append(("", " " * (room - sum(width(t) for _, t in mid))))
    else:
        mid = [("", " " * max(0, room))]
    return fit(head + mid + right, cols)


def status_blocks(cols, now=None):
    """The progress pane: (title bar, blocks, footer). A worker folds to its status line; unfolded
    it adds its last report (the question, for those waiting on the user). Today's spend is the
    footer, on the pane's last row (the user, 2026-10-27)."""
    focus, workers = read_registry()
    alive = alive_windows()
    active = {n: w for n, w in workers.items() if w["status"] != "SHELVED"}
    shelved = [n for n, w in workers.items() if w["status"] == "SHELVED"]
    usage = worker_usage(active)
    rows = []
    for name, w in active.items():
        group, mark, word, color = STATUS_LOOK.get(w["status"], (2, "▸", (w["status"],) * 2, ""))
        word = tr(*word)
        if w.get("mode") == "discuss" and group == 2:
            word, color = tr("讨论中", "discussing"), CYAN
        if w.get("window") not in alive and group < 3 and w["status"] != "FAILED":
            word += tr(" · 窗口关了", " · window closed")
        if group == 0 or w["status"] == "API_ERROR":
            summary = w.get("pending_ask") or w.get("last_summary") or w["task"]
        else:
            summary = w.get("last_summary") or w["task"]
        summary = " ".join(summary.split())
        if w.get("delegated_by"):
            summary = tr(f"为 {w['delegated_by']}：", f"for {w['delegated_by']}: ") + summary
        rows.append((group, -(dt.datetime.fromisoformat(w["last_report_at"]).timestamp()
                              if w.get("last_report_at") else 0), name, mark, word, color, summary,
                     ago(w["last_report_at"], now) if w.get("last_report_at") else "", usage[name],
                     short_model(w.get("model"))))
    rows.sort(key=lambda r: r[:3])
    counts = [sum(1 for r in rows if r[0] == g) for g in range(4)]
    labels = tr(("等你", "出错", "在做", "做完", "搁置"), ("you", "errors", "working", "done", "shelved"))
    right = "".join(f"{label} {n}  " for label, n in zip(labels, counts) if n)
    title = bar(tr(" 任务进展 $今天", " Workers $today"), right + f"{labels[4]} {len(shelved)} ", cols)
    blocks = []
    name_w = min(max((width(r[2]) for r in rows), default=0), 16)
    word_w = max((width(r[4]) for r in rows), default=0)
    tok_w = max((len(usage_word(r[8])) for r in rows), default=0)
    model_w = max((width(r[9]) for r in rows), default=0)
    moneys = worker_moneys(active)
    money_w = max((width(m) for m in moneys.values()), default=0)
    for i, (group, _, name, mark, word, color, summary, age, use, model) in enumerate(rows):
        if i and group != rows[i - 1][0]:
            blocks.append(fixed([]))
        head = status_line(cols, name == focus, name, mark, word, color, summary, age, usage_word(use), model,
                           (name_w, word_w, tok_w, model_w, money_w), money=moneys[name])
        more = [[("", "  ")] + line for line in wrap([(DIM, summary)], cols - 2)]
        if model:
            more.append([("", "  "), (DIM, tr(f"模型 {model}", f"model {model}"))])
        if use is not None:
            more += [[("", "  ")] + line for line in wrap([(DIM, usage_detail(use))], cols - 2)]
        blocks.append((("s", name), [head], [head] + more))
    if not rows:
        blocks.append(fixed([(DIM, tr("没有在跑的 worker。", "No workers running."))]))
    if shelved:
        segs = [(BOLD, f"{labels[4]} {len(shelved)}"), ("", "  "), (DIM, tr("、", ", ").join(shelved))]
        lines = wrap(segs, cols, cols - 2)
        blocks += [fixed([]), foldable(("shelved",), [lines[0]] + [[("", "  ")] + l for l in lines[1:]],
                                       fit(segs, cols))]
    spend = spend_today_line()
    return title, blocks, [[(DIM, cut(spend, cols))]] if spend else []


def reminders_blocks(cols):
    """The scheduled-tasks pane (reminders not due yet, soonest first): (title bar, blocks)."""
    pending = sorted((r for r in read_reminders() if r["status"] == "pending"), key=by_due)
    title = bar(tr(" 定时任务", " Scheduled"), tr(f"{len(pending)} 个 ", f"{len(pending)} "), cols)
    if not pending:
        return title, [fixed([(DIM, tr("没有定时任务。", "Nothing scheduled."))])]
    blocks = []
    for r in pending:
        t = dt.datetime.fromisoformat(r["due"]).astimezone()
        every = [(DIM, " " + show_every(r["every"]))] if r.get("every") else []
        segs = [(DIM, f"{t:%m-%d %H:%M}"), *every, ("", " "), (CYAN, r["target"]), ("", "  "),
                ("", " ".join(r["text"].split()))]
        lines = wrap(segs, cols, cols - 2)
        blocks.append(foldable(("r", r["due"], r["target"], r["text"]),
                               [lines[0]] + [[("", "  ")] + l for l in lines[1:]], fit(segs, cols)))
    return title, blocks


def unfold(blocks, opened):
    """The body lines with the blocks in opened unfolded, and each line's block key."""
    body, keys = [], []
    for key, folded, full in blocks:
        lines = full if key in opened else folded
        body += lines
        keys += [key] * len(lines)
    return body, keys


def dash_view(title, body, rows, top, footer=()):
    """The rows the pane shows: the title, then body from line `top` on, with a note above and
    below when there is more that way, and the footer lines pinned to the pane's last rows.
    Returns (lines, top kept in range, the body line each shown row is, None for the title,
    notes, padding and footer)."""
    footer = list(footer) if rows - len(footer) >= 4 else []  # a pane too short keeps its body
    lines, top, rowmap = dash_body(title, body, rows - len(footer), top)
    if footer:
        pad = rows - len(footer) - len(lines)
        lines, rowmap = lines + [[]] * pad + footer, rowmap + [None] * (pad + len(footer))
    return lines, top, rowmap


def dash_body(title, body, rows, top):
    room = rows - 1
    if len(body) <= room or room < 3:
        return [title] + body[:room], 0, [None] + list(range(min(room, len(body))))
    top = max(0, min(top, len(body) - room + 1))
    above = [[(DIM, tr(f"  ↑ 还有 {top} 行", f"  ↑ {top} more"))]] if top else []
    shown = room - len(above)
    below = []
    if top + shown < len(body):
        shown -= 1
        n = len(body) - top - shown
        below = [[(DIM, tr(f"  ↓ 还有 {n} 行 · 滚轮翻 · 点一条展开", f"  ↓ {n} more · scroll · click to open"))]]
    rowmap = [None] * (1 + len(above)) + list(range(top, top + shown)) + [None] * len(below)
    return [title] + above + body[top:top + shown] + below, top, rowmap


def dash_input(data, page):
    """What a burst of input from the pane's terminal asks for: (lines to scroll, rows clicked,
    whether to unfold or fold everything). Scrolling: the mouse wheel, ↑↓ j k, PgUp PgDn b
    space, Home End g G. Tab folds or unfolds everything."""
    big = 1 << 20
    keys = {b"\x1b[A": -1, b"\x1bOA": -1, b"k": -1, b"\x1b[B": 1, b"\x1bOB": 1, b"j": 1,
            b"\x1b[5~": -page, b"b": -page, b"\x1b[6~": page, b" ": page,
            b"\x1b[H": -big, b"\x1bOH": -big, b"\x1b[1~": -big, b"g": -big,
            b"\x1b[F": big, b"\x1bOF": big, b"\x1b[4~": big, b"G": big}
    scroll, clicks, everything = 0, [], False
    for m in re.finditer(rb"\x1b\[<(\d+);\d+;(\d+)([Mm])|\x1b\[[0-9;]*[~A-Za-z]|\x1bO.|.", data, re.S):
        if m[1] is not None:  # SGR mouse report: 64/65 the wheel, 0 the left button; 4/8/16 modifiers
            button = int(m[1]) & ~28
            scroll += {64: -3, 65: 3}.get(button, 0)
            if button == 0 and m[3] == b"M":
                clicks.append(int(m[2]) - 1)
        elif m[0] == b"\t":
            everything = not everything
        else:
            scroll += keys.get(m[0], 0)
    return scroll, clicks, everything


def show_dashboard(what):
    """The loop in a dashboard pane: redraw when the content or the pane size changes, scroll
    on the wheel and keys, fold and unfold on clicks; leave when the secretary's pane is gone,
    which closes the window with it."""
    me = os.environ.get("TMUX_PANE", "")
    fd = sys.stdin.fileno()
    saved = None
    with contextlib.suppress(termios.error):
        saved = termios.tcgetattr(fd)
        tty.setcbreak(fd)
    # a resize (the split that makes the pane, a terminal change) wakes the loop at once
    wake, waker = os.pipe()
    os.set_blocking(waker, False)
    signal.signal(signal.SIGWINCH, lambda *_: None)
    signal.set_wakeup_fd(waker)
    # own screen (nothing piles up in tmux's history), no cursor, clicks and the wheel as SGR reports
    sys.stdout.write("\x1b[?1049h\x1b[?25l\x1b[?1000h\x1b[?1006h")
    top, opened, shown, content, due, sec = 0, set(), None, None, 0, None
    code, reload, relaid = code_stamp(), False, False
    try:
        while True:
            size = shutil.get_terminal_size()
            if time.monotonic() >= due and code_changed(code):
                reload = True  # claudesec was updated: run the new code, not this process's copy
                break
            if time.monotonic() >= due or content is None or content[0] != size:
                panes = window_panes(me) if me else [("", "secretary", "0")]
                sec = next((p for p, role, _ in panes if role == "secretary"), None)
                if sec is None:
                    return
                if me and not relaid:  # reloaded on code with other panes: lay the column out anew
                    relaid = True
                    stamp = tmux("show-options", "-pqv", "-t", me, "@claudesec-layout", check=False).strip()
                    if stamp and stamp != dash_layout(config()):
                        tmux("run-shell", "-b", f"{hook_cmd()} dashboard layout", check=False)
                try:
                    content = (size, *{"queue": queue_blocks, "notices": notices_blocks,
                                        "reminders": reminders_blocks}.get(what, status_blocks)(size.columns - 1))
                except Exception as e:  # a half-written file, a bad entry: show it, try again
                    content = (size, [(REV, tr(f" 读状态出错，{DASH_REFRESH} 秒后重试 ",
                                                f" Can't read the state; again in {DASH_REFRESH}s "))],
                               [fixed([("", repr(e))])])
                due = time.monotonic() + DASH_REFRESH
            body, keys = unfold(content[2], opened)
            lines, top, rowmap = dash_view(content[1], body, size.lines, top, content[3] if len(content) > 3 else ())
            frame = "\x1b[K\r\n".join(paint(fit(line, size.columns - 1)) for line in lines)
            if frame != shown:
                sys.stdout.write("\x1b[H" + frame + "\x1b[K\x1b[J")
                sys.stdout.flush()
                shown = frame
            ready, _, _ = select.select([fd, wake] if saved else [wake], [], [], max(0.0, due - time.monotonic()))
            if wake in ready:
                os.read(wake, 512)
            if fd not in ready:
                continue
            data = os.read(fd, 4096)
            if not data:
                return
            scroll, clicks, everything = dash_input(data, max(1, size.lines - 3))
            top += scroll
            every = {key for key, _, _ in content[2] if key}
            for row in clicks:
                if row == 0:
                    everything = not everything
                elif row < len(rowmap) and rowmap[row] is not None and keys[rowmap[row]]:
                    opened ^= {keys[rowmap[row]]}
            if everything:
                opened = set() if every <= opened else every
            if clicks and sec and me:  # a click selects this pane; typing should go on to the secretary
                tmux("select-pane", "-t", sec, check=False)
    finally:
        sys.stdout.write("\x1b[?1006l\x1b[?1000l\x1b[?25h\x1b[?1049l")
        sys.stdout.flush()
        if saved:
            termios.tcsetattr(fd, termios.TCSADRAIN, saved)
    if reload:
        os.execv(sys.executable, [sys.executable, str(SELF), "dashboard", "show", what])


def code_stamp():
    """When claudesec's file last changed (a git pull replaces it). It imports nothing of its own."""
    with contextlib.suppress(OSError):
        return SELF.stat().st_mtime_ns
    return None


def code_changed(stamp):
    """True once the file changed and the new version compiles: a dashboard pane is a long-lived
    process that would otherwise show an update only after `dashboard off` / `on`. A file that
    doesn't compile (written half-way, a broken edit) keeps the running copy going."""
    now_stamp = code_stamp()
    if now_stamp is None or now_stamp == stamp or now_stamp in BROKEN_CODE:
        return False
    try:
        compile(SELF.read_text(), str(SELF), "exec")
    except (OSError, SyntaxError, ValueError):
        BROKEN_CODE.add(now_stamp)  # not compiled again every refresh; the next change is tried
        return False
    return True


BROKEN_CODE = set()


def cmd_dashboard(args):
    sess = config()["tmux_session"]
    if args.action == "show":
        show_dashboard(args.what or "status")
        return
    if args.action in ("on", "off"):
        path = HOME / "config.json"
        conf = json.loads(path.read_text()) if path.exists() else {}
        conf["dashboard"] = args.action == "on"
        path.write_text(json.dumps(conf, indent=2, ensure_ascii=False) + "\n")
    if has_session(sess):
        arrange_dashboard(sess)
    if args.action != "layout":
        print(f"dashboard {'on' if config().get('dashboard', True) else 'off'}")


QUEUE_INTRO = """# 决策队列

秘书维护。worker 的 NEED_DECISION、要用户定的 TODO 先进这里，按重要程度排序，一次只问用户一件。
像 backlog → todo → doing → done：「搁置」用户说以后再说的，不主动问；「待问」接下来一件件问的；
「待答」问过了、等用户回答；「已处理」定了的，新的在上。「记录」是用户只让记下的想法，不是要问的问题。
每条一行 `- #编号 [worker] 问题（高|中|低）`。编号用 `claudesec queue add` 拿，跟着条目走，不改、不复用；
在块之间挪用 `claudesec queue move 编号 backlog|todo|doing|done`。用户看着面板用编号回答。
"""
QUEUE_INTRO_EN = """# Decision queue

Kept by the secretary. Workers' NEED_DECISIONs and TODOs the user has to decide land here, most
important first; the user is asked one at a time.
Like backlog -> todo -> doing -> done: Backlog, what the user put off (not asked about); To ask,
asked next, one by one; Waiting, asked and waiting for the answer; Done, decided, newest first.
Ideas holds what the user only asked to note down: not questions.
One line an item: `- #number [worker] question (high|medium|low)`. Numbers come from
`claudesec queue add` and stay with the item; `claudesec queue move N backlog|todo|doing|done`
moves one. The user answers by number from the panel.
"""


def section_heading(key):
    return f"## {section_name(key)}" + (tr("（按优先级）", " (by priority)") if key == "todo" else "")


def queue_template():
    return tr(QUEUE_INTRO, QUEUE_INTRO_EN) + "".join(f"\n{section_heading(key)}\n" for key in QUEUE_SECTIONS)


def normalize_queue(lines):
    """queue.md's lines repaired (see repair_queue) and with all its sections, in order of the
    flow when one has to be added; an older file's 「已问未答」 becomes 「待答」 and its intro the
    current one."""
    lines = repair_queue(lines)[0]
    heads = [i for i, line in enumerate(lines) if line.startswith("## ")]
    old = [i for i in heads if "已问未答" in lines[i]]
    for i in old:
        lines[i] = "## 待答"
    if old and heads:  # the intro still talks about 已问未答
        title = next((i for i, line in enumerate(lines[:heads[0]]) if line.startswith("# ")), None)
        if title is not None:
            lines[title:heads[0]] = QUEUE_INTRO.splitlines() + [""]
    zh = any(re.search(r"[一-龥]", lines[i]) for i in heads) if heads else lang() == "zh"
    order = list(QUEUE_SECTIONS)
    for key in order:
        have = {queue_section(line): i for i, line in enumerate(lines) if line.startswith("## ")}
        if key in have:
            continue
        later = [have[k] for k in order[order.index(key) + 1:] if k in have]
        at = min(later) if later else len(lines)
        head = f"## {QUEUE_SECTIONS[key][0 if zh else 1]}"  # in the file's own language
        lines[at:at] = [head, ""] if later else ["", head]
    return [line for i, line in enumerate(lines) if line.strip() or i == 0 or lines[i - 1].strip()]


def queue_section_span(lines, key):
    """(index of the section's heading, index past its last line)."""
    heads = [i for i, line in enumerate(lines) if line.startswith("## ")]
    at = next(i for i in heads if queue_section(lines[i]) == key)
    return at, next((i for i in heads if i > at), len(lines))


def queue_append(lines, key, item):
    """item at the end of a section; at the top of 已处理, which keeps the newest first."""
    at, end = queue_section_span(lines, key)
    if key == "done":
        lines[at + 1:at + 1] = ["", item]
        return
    while end > at + 1 and not lines[end - 1].strip():
        end -= 1
    lines[end:end] = ([""] if end == at + 1 else []) + [item]


ASKED_ON = re.compile(r"\d{4}-\d{2}-\d{2}\s*(?:已问|asked)[:：]\s*", re.I)


def with_asked_date(text):
    """text with today's "YYYY-MM-DD 已问：" after its [tag] (the panel shows how long ago),
    unless it has one."""
    if ASKED_ON.search(text):
        return text
    tag = re.match(r"\[[^\]]+\]\s*", text)
    at = tag.end() if tag else 0
    return f"{text[:at]}{dt.date.today().isoformat()} {tr('已问：', 'asked: ')}{text[at:]}"


def without_asked_date(text):
    return ASKED_ON.sub("", text, count=1)


def secretary_prompt():
    """secretary.md with the Cursor parts kept or dropped for this machine, as a file for claude."""
    path = HOME / "secretary-prompt.md"
    path.write_text(render_prompt((PROMPTS / "secretary.md").read_text()))
    return path


def take_queue_number(text):
    """The next queue item number: past every one in queue.md and every one handed out before,
    so a number cleared out of 已处理 isn't handed out again. Notices draw from the same numbers,
    so "46" means one thing whichever pane it is in."""
    last = HOME / "queue.last"
    for other in (HOME / "queue.md", HOME / "notices.md"):
        with contextlib.suppress(OSError):
            text += "\n" + other.read_text()
    seen = [int(m[1]) for m in (QUEUE_ITEM.match(LINE_NUMBER.sub("", l)) for l in text.splitlines()) if m and m[1]]
    with contextlib.suppress(OSError, ValueError):
        seen.append(int(last.read_text()))
    n = max(seen, default=0) + 1
    last.write_text(f"{n}\n")
    return n


def queue_list(older=None):
    """The open items, one line each: number, section, how long it has waited, text."""
    meta, rows, unknown = queue_meta(), [], 0
    for section, num, tag, body, note in queue_items(queue_text()):
        age = item_age(num, section, note, meta)
        if older is not None and (age is None or age < older):
            unknown += age is None
            continue
        rows.append((f"#{num}" if num else "·", section_name(section), "?" if age is None else f"{age}d",
                     (f"[{tag}] " if tag else "") + " ".join(body.split())[:90]))
    if rows:
        print_rows([tr(("编号", "分区", "等了", "内容"), ("#", "section", "waited", "text")), *rows])
    else:
        print(tr("没有符合的条目。", "No such items."))
    if unknown:
        print(tr(f"另有 {unknown} 条不知道放了多久（记日期之前加的）。",
                 f"And {unknown} of unknown age (added before dates were kept)."))


def queue_doctor(raw, problems, fix):
    """What's wrong with queue.md: damage repair_queue undoes, and what it can't decide for you
    (a number twice, unnumbered items, items above the first section)."""
    lines = repair_queue(raw)[0]
    seen, section, loose = {}, None, 0
    for line in lines:
        if line.startswith("## "):
            section = queue_section(line)
            continue
        m = QUEUE_ITEM.match(line)
        if m and section is None:
            loose += 1
        if m and m[1]:
            seen.setdefault(m[1], []).append(section)
    twice = {n: s for n, s in seen.items() if len(s) > 1}
    unnumbered = sum(1 for _, n, *_ in queue_items("\n".join(lines)) if not n)
    if twice:
        problems = problems + [tr("编号出现多次：", "numbers more than once: ") + ", ".join(
            f"#{n}（{'/'.join(section_name(k) if k else '?' for k in s)}）" for n, s in sorted(twice.items()))]
    if unnumbered:
        problems.append(tr(f"{unnumbered} 条未定的没有编号（`claudesec queue number`）",
                           f"{unnumbered} open items without a number (`claudesec queue number`)"))
    if loose:
        problems.append(tr(f"{loose} 条在所有分区之前", f"{loose} items above the first section"))
    print("\n".join(f"- {p}" for p in problems) if problems else tr("queue.md 没问题。", "queue.md is fine."))
    if problems and not fix:
        print(tr("行号和重复分区：`claudesec queue doctor --fix` 修（先备份）；其余的要手动看。",
                 "Line numbers and doubled sections: `claudesec queue doctor --fix` repairs them (after a backup); "
                 "the rest needs a look by hand."))
        sys.exit(1)


def cmd_queue(args):
    """`queue add`: an item at the end of 待问 (--asked: 待答, --later: 搁置) with the next number,
    which it prints. `queue move N SECTION`: item #N to another section. `queue number`: a
    number for each open item written without one. Each one brings an older file's sections up
    to date first."""
    path = HOME / "queue.md"
    HOME.mkdir(parents=True, exist_ok=True)
    raw = (path.read_text() if path.exists() else queue_template()).splitlines()
    _, problems = repair_queue(raw)
    if args.action in ("list", "doctor"):
        if args.action == "doctor":
            queue_doctor(raw, problems, args.fix)
            if not args.fix:
                return
        else:
            queue_list(args.older)
            return
    if problems:  # repaired below; keep the damaged one, and say so
        backups = HOME / "backups"
        backups.mkdir(exist_ok=True)
        keep = backups / f"queue-{dt.datetime.now():%Y%m%d-%H%M%S}.md"
        keep.write_text("\n".join(raw) + "\n")
        print(tr(f"queue.md 坏了（{'；'.join(problems)}），已修好，原样备份在 {keep}",
                 f"queue.md was damaged ({'; '.join(problems)}); repaired, the damaged one kept at {keep}"),
              file=sys.stderr)
    lines = normalize_queue(raw)
    if args.action == "add":
        text = " ".join(args.words).strip()
        if not text:
            sys.exit("queue add: what is the question?")
        if sum(map(bool, (args.asked, args.later, getattr(args, "idea", False)))) > 1:
            sys.exit("queue add: one of --asked, --later, --idea")
        key = "doing" if args.asked else "backlog" if args.later else "ideas" if getattr(args, "idea", False) else "todo"
        n = take_queue_number("\n".join(lines))
        queue_append(lines, key, f"- #{n} {with_asked_date(text) if key == 'doing' else text}")
        note_added(n)
        print(f"#{n}")
    elif args.action == "move":
        key = {**{k: k for k in QUEUE_SECTIONS}, **{w: k for k, ws in QUEUE_SECTIONS.items() for w in ws}}.get(args.to)
        num = args.number.lstrip("#")
        found = [i for i, line in enumerate(lines)
                 if (m := QUEUE_ITEM.match(line)) and m[1] == num and not line.startswith("## ")]
        if not found:
            notice = any((m := QUEUE_ITEM.match(line)) and m[1] == num for line in
                         ((HOME / "notices.md").read_text().splitlines() if (HOME / "notices.md").exists() else []))
            sys.exit(tr(f"queue move：{path} 里没有 #{num}。", f"queue move: no item #{num} in {path}. ")
                     + (tr(f"#{num} 是待办事项：`claudesec notice done {num}`。", f"#{num} is a to-do: `claudesec notice done {num}`.")
                        if notice else tr("`claudesec queue list` 列出未定的条目；文件可能坏了的话 `claudesec queue doctor`。",
                                          "`claudesec queue list` lists the open items; if the file may be damaged, "
                                          "`claudesec queue doctor`.")))
        i = found[0]
        frm = next(queue_section(lines[j]) for j in range(i, -1, -1) if lines[j].startswith("## "))
        text = QUEUE_ITEM.match(lines[i])[2].strip()
        if key == "doing":
            text = with_asked_date(text)
        elif key in ("todo", "backlog"):
            text = without_asked_date(text)
        if key == "done":  # decided: the date, and what the user said in place of the question
            tag = re.match(r"\[[^\]]+\]\s*", text)
            at = tag.end() if tag else 0
            rest = args.note or without_asked_date(text[at:])
            text = f"{text[:at]}{dt.date.today().isoformat()} {rest}"
        elif args.note:
            text += f" {args.note}"
        del lines[i]
        if i < len(lines) and not lines[i].strip() and i > 0 and not lines[i - 1].strip():
            del lines[i]  # the blank line that separated it in 已处理
        queue_append(lines, key, f"- #{num} {text}")
        print(f"#{num} {section_name(frm)} → {section_name(key)}")
    else:
        section, done = False, []
        for i, line in enumerate(lines):
            if line.startswith("## "):
                section = queue_section(line) not in ("done", None)
                continue
            m = QUEUE_ITEM.match(line)
            if section and m and not m[1]:
                n = take_queue_number(chr(10).join(lines))
                lines[i] = f"- #{n} {m[2].strip()}"
                note_added(n)
                done.append(lines[i])
        print("\n".join(done) or tr("未定的条目都有编号了", "every open item has a number"))
    tmp = path.with_name(".queue.md.tmp")
    tmp.write_text("\n".join(lines) + "\n")
    os.replace(tmp, path)


# ---------- notices: things for the user to do that need no decision ----------
# "Say push in window X", "install the extension over VNC": the user has to act, but there is
# nothing to choose, so they stay out of the decision queue. notices.md, two sections; the
# numbers come from the queue's sequence.

NOTICE_INTRO = """# 待办事项

秘书维护。要用户去做、但不用用户拍板的事：去某个 worker 窗口说 push、在 VNC 里装扩展、登录一下。
要用户定的仍然进决策队列。每条一行 `- #编号 [worker] 要做什么`；`claudesec notice add` 登记（编号和
决策队列共用一个序列），用户做完 `claudesec notice done 编号`。
"""
NOTICE_INTRO_EN = """# To do

Kept by the secretary: things the user has to do that need no decision (say push in a worker's
window, install the extension over VNC, log in somewhere). Decisions still go to the queue. One line
each, `- #number [worker] what to do`; `claudesec notice add` files one (numbers shared with the
decision queue), `claudesec notice done number` once the user has done it.
"""
NOTICE_SECTIONS = {"open": ("待办", "To do"), "done": ("已完成", "Done")}


def notice_section(heading):
    low = heading.lower()
    return next((key for key, words in NOTICE_SECTIONS.items() if any(w.lower() in low for w in words)), None)


def notice_lines():
    """notices.md's lines, with both sections."""
    path = HOME / "notices.md"
    lines = path.read_text().splitlines() if path.exists() else tr(NOTICE_INTRO, NOTICE_INTRO_EN).splitlines()
    for key, words in NOTICE_SECTIONS.items():
        if not any(line.startswith("## ") and notice_section(line) == key for line in lines):
            lines += ["", f"## {words[0 if lang() == 'zh' else 1]}"]
    return lines


def open_notices():
    """(number, tag, text) of each notice still to do."""
    path = HOME / "notices.md"
    out, section = [], None
    for line in (path.read_text() if path.exists() else "").splitlines():
        if line.startswith("## "):
            section = notice_section(line)
            continue
        m = QUEUE_ITEM.match(line)
        if section != "open" or not m:
            continue
        body = m[2].strip()
        tag = re.match(r"\[([^\]]+)\]\s*", body)
        out.append((m[1] and int(m[1]), tag[1] if tag else None, body[tag.end():] if tag else body))
    return out


def cmd_notice(args):
    """`notice add [--from W] TEXT`: a notice with the next number, printed. `notice done N`:
    moved to 已完成 with today's date. `notice list`: the open ones."""
    if args.action == "list":
        items = open_notices()
        print("\n".join(f"#{n} " + (f"[{t}] " if t else "") + text for n, t, text in items)
              or tr("没有要用户去做的事。", "Nothing for the user to do."))
        return
    lines = notice_lines()
    if args.action == "add":
        text = " ".join(args.words).strip() or sys.exit("notice add: what should the user do?")
        n = take_queue_number("")
        item = f"- #{n} " + (f"[{args.source}] " if args.source else "") + text
        at = next(i for i, l in enumerate(lines) if l.startswith("## ") and notice_section(l) == "open")
        end = next((i for i in range(at + 1, len(lines)) if lines[i].startswith("## ")), len(lines))
        while end > at + 1 and not lines[end - 1].strip():
            end -= 1
        lines[end:end] = ([""] if end == at + 1 else []) + [item]
        print(f"#{n}")
    else:  # done
        num = args.number.lstrip("#")
        found = [i for i, l in enumerate(lines) if (m := QUEUE_ITEM.match(l)) and m[1] == num
                 and not l.startswith("## ")]
        if not found:
            sys.exit(f"notice done: no notice #{num} in {HOME / 'notices.md'}")
        body = QUEUE_ITEM.match(lines[found[0]])[2].strip()
        del lines[found[0]]
        tag = re.match(r"\[[^\]]+\]\s*", body)
        at_tag = tag.end() if tag else 0
        body = f"{body[:at_tag]}{dt.date.today().isoformat()} {body[at_tag:]}"
        at = next(i for i, l in enumerate(lines) if l.startswith("## ") and notice_section(l) == "done")
        lines[at + 1:at + 1] = ["", f"- #{num} {body}"]  # newest first
        print(f"#{num} → {NOTICE_SECTIONS['done'][0 if lang() == 'zh' else 1]}")
    lines = [l for i, l in enumerate(lines) if l.strip() or i == 0 or lines[i - 1].strip()]
    path = HOME / "notices.md"
    tmp = path.with_name(".notices.md.tmp")
    tmp.write_text("\n".join(lines) + "\n")
    os.replace(tmp, path)


def cmd_show(args):
    """The whole of item #N, from queue.md or notices.md, with the section it is in: the
    panes show one line of each, and the user asks for the rest by its number."""
    num = args.number.lstrip("#")
    for path, section_of, names in ((HOME / "queue.md", queue_section, QUEUE_SECTIONS),
                                    (HOME / "notices.md", notice_section, NOTICE_SECTIONS)):
        section = None
        for line in (path.read_text() if path.exists() else "").splitlines():
            line = LINE_NUMBER.sub("", line)
            if line.startswith("## "):
                section = section_of(line)
                continue
            m = QUEUE_ITEM.match(line)
            if m and m[1] == num:
                where = names.get(section, ("?", "?"))[0 if lang() == "zh" else 1]
                kind = tr("决策队列", "decision queue") if path.name == "queue.md" else tr("待办事项", "to-dos")
                print(f"#{num}（{kind} · {where}）\n{m[2].strip()}")
                return
    sys.exit(tr(f"没有 #{num}：queue.md 和 notices.md 里都找不到", f"no #{num} in queue.md or notices.md"))


def notices_blocks(cols):
    """The to-do pane (notices.md's open items): (title bar, blocks)."""
    items = open_notices()
    title = bar(tr(" 待办事项", " To do"), tr(f"{len(items)} 件 ", f"{len(items)} "), cols)
    if not items:
        return title, [fixed([(DIM, tr("没有要你去做的事。", "Nothing for you to do."))])]
    blocks, num_w = [], max(len(str(n or "·")) for n, _, _ in items)
    for n, tag, text in items:
        head = [(BOLD, str(n or "·").rjust(num_w)), ("", " ")]
        name = [(CYAN, tag), ("", " ")] if tag else []
        lines = wrap(name + [("", text)], cols - num_w - 1)
        full = [head + lines[0]] + [[("", " " * (num_w + 1))] + line for line in lines[1:]]
        blocks.append(foldable(("n", n, tag, text), full, fit(head + name + [("", text)], cols)))
    return title, blocks


def cmd_run(args):
    """Runs inside the secretary's tmux window: the secretary's Claude Code process itself."""
    cfg = config()
    HOME.mkdir(parents=True, exist_ok=True)
    if not (HOME / "queue.md").exists():
        (HOME / "queue.md").write_text(queue_template())
    settings = HOME / "secretary-settings.json"
    cmd = hook_cmd()
    # A worker stuck on a dialog can't SendMessage, so alerts reach the secretary through a
    # background watcher whose exit code 2 wakes it (asyncRewake); every turn end re-arms it.
    watch = {"type": "command", "command": f"{cmd} hook secretary-watch", "asyncRewake": True,
             "timeout": WATCH_TIMEOUT}
    settings.write_text(json.dumps({
        # The user talks to the secretary in their own words; no Tab-completion guesses.
        "promptSuggestionEnabled": False,
        **memory_settings(HOME),
        "hooks": {
            "SessionStart": [{"hooks": [{"type": "command", "command": f"{cmd} hook secretary-session-start"}]},
                             {"hooks": [watch]}],
            "Stop": [{"hooks": [watch]}],
            # A turn that dies on an API error (billing, overload) has no Stop: without this,
            # no watcher until the user's next message, and the alerts that woke it are lost.
            "StopFailure": [{"hooks": [{**watch, "command": f"{cmd} hook secretary-watch-failed"}]}],
            "PostToolUse": [{"matcher": "SendMessage",
                             "hooks": [{"type": "command", "command": f"{cmd} hook secretary-send"}]}],
            "UserPromptSubmit": [{"hooks": [{"type": "command", "command": f"{cmd} hook secretary-prompt"}]}],
        },
    }, indent=2) + "\n")
    argv = ["claude", "-n", cfg["secretary_name"],
            "--settings", str(settings),
            "--append-system-prompt-file", str(secretary_prompt()), *fresh_prompt(),
            "--allowedTools", "Bash(claudesec *)"]
    if cfg["secretary_model"]:
        argv += ["--model", cfg["secretary_model"]]
    session = HOME / "secretary.session"
    if session.exists() and not args.new:
        argv += ["--resume", session.read_text().strip()]
    # Fixed cwd: the secretary is cross-project, and Claude Code's auto memory is keyed by cwd,
    # so a fixed cwd gives it one stable memory directory.
    os.chdir(HOME)
    (HOME / "run.pid").write_text(str(os.getpid()))  # a newer one tells an older shelve-all to stop
    if os.environ.get("TMUX_PANE") and has_session(cfg["tmux_session"]):
        with contextlib.suppress(Exception):  # every secretary start, however it was started
            arrange_dashboard(cfg["tmux_session"])
    detach("wake-all")
    detach("reminders")
    # Not exec: the workers are put away after the secretary exits. That is done here, by claudesec,
    # so the user has no chores and no tool call of the secretary's can be refused.
    signal.signal(signal.SIGINT, signal.SIG_IGN)   # Ctrl+C belongs to claude
    signal.signal(signal.SIGHUP, signal.SIG_IGN)   # window killed: claude exits, we still clean up
    def default_signals():  # ignored signals are inherited; claude needs its own
        signal.signal(signal.SIGINT, signal.SIG_DFL)
        signal.signal(signal.SIGHUP, signal.SIG_DFL)
    child = subprocess.Popen(argv, preexec_fn=default_signals)
    signal.signal(signal.SIGTERM, lambda *_: child.terminate())
    child.wait()
    restarting = HOME / "restarting"
    try:
        deliberate = time.time() - float(restarting.read_text()) < 120
    except (OSError, ValueError):
        deliberate = False
    restarting.unlink(missing_ok=True)
    if not deliberate:
        detach("shelve-all")


def detach(job):
    """Run `claudesec lifecycle JOB` on its own, outliving this window; output goes to a log."""
    log = open(HOME / "lifecycle.log", "a")
    p = subprocess.Popen([str(SELF), "lifecycle", job, str(os.getpid())], env={**os.environ, "CLAUDESEC_HOME": str(HOME)},
                         stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True)
    # Reap it when it's done, or wake-all lingers as a zombie for as long as the secretary runs.
    # If this process exits first (shelve-all), the job is reparented and reaped by init.
    threading.Thread(target=p.wait, daemon=True).start()


def secretary_alive():
    name = config()["secretary_name"]
    return any(s.get("name") == name for s in claude_sessions())


def quietly(fn, **kw):
    """Run a cmd_* function as a library call; its sys.exit, or a crash (a window closed under
    it), becomes a returned message."""
    try:
        fn(argparse.Namespace(**kw))
        return None
    except SystemExit as e:
        return str(e.code)
    except Exception as e:
        return f"crashed: {e!r}"


def cmd_lifecycle(args):
    print(f"=== {now()} {args.job} (claudesec run {args.run_pid})", flush=True)
    if args.job == "shelve-all":
        shelve_all(args.run_pid)
    elif args.job == "reminders":
        check_reminders(args.run_pid)
    else:
        wake_all(args.run_pid)
    print(f"=== {now()} {args.job} done", flush=True)


@contextlib.contextmanager
def lifecycle_lock():
    """wake-all and shelve-all never overlap. A secretary can die seconds after it started,
    while its workers are still being woken (each mid-wake has no session in the registry)."""
    with open(HOME / "lifecycle.lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield


def current_run():
    """pid of the live `claudesec run` the secretary is in, from run.pid, or None."""
    try:
        pid = int((HOME / "run.pid").read_text())
        os.kill(pid, 0)
    except (OSError, ValueError):
        return None
    return pid if is_claudesec_run(pid) else None  # after a reboot the pid may be someone else's


def is_claudesec_run(pid):
    """Is pid a `claudesec run`? Without /proc there is no telling; assume it is."""
    try:
        argv = Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0")
    except OSError:
        return not Path("/proc/self").exists()
    return b"run" in argv and any(a.endswith(b"claudesec") for a in argv)


def shelve_all(run_pid):
    """The secretary is gone: put every worker away, keeping its session to resume later.
    A busy one, or one waiting on its background tasks, is left to finish first; if the secretary
    is back by then, it stays."""
    pending = None
    deadline = time.time() + 6 * 3600
    while time.time() < deadline:
        with lifecycle_lock():
            newer = current_run()
            if (newer and newer != run_pid) or secretary_alive():
                print("secretary is back; leaving the rest running:", sorted(pending or ()), flush=True)
                return
            if pending is None:  # under the lock, so workers a wake-all just brought back are included
                pending = {n for n, w in read_registry()[1].items() if w["status"] != "SHELVED"}
            for name in sorted(pending):
                w = read_registry()[1].get(name)
                if not w or w["status"] == "SHELVED":
                    pending.discard(name)
                    continue
                if worker_busy(name, w):
                    continue
                err = quietly(cmd_shelve, name=name, note=None, as_name=None, force=False, by="exit")
                print(f"{name}: {err or 'shelved'}", flush=True)
                pending.discard(name)
        if not pending:
            return
        time.sleep(10)
    print("gave up waiting for:", sorted(pending), flush=True)


def wake_all(run_pid):
    """The secretary started: bring back what its exit put away, plus workers whose process
    died some other way (window or tmux session killed). What the user shelved stays shelved."""
    time.sleep(3)  # let the secretary's window come up first
    with lifecycle_lock():
        if run_pid and current_run() != run_pid:
            print("the secretary that started this is already gone; waking nothing", flush=True)
            return
        wake_orphans()


def wake_orphans():
    names = []
    with registry() as reg:
        for name, w in reg["workers"].items():
            if w["status"] == "SHELVED":
                if w.get("shelved_by") == "exit":
                    names.append(name)
                continue
            running = cursor_running(w) if is_cursor(w) else live_holder(w.get("session"))
            if not running and conversation_exists(w):
                w.update(status_before=w["status"], status="SHELVED", window=None, shelved_by="exit")
                names.append(name)
    threads, failed = [], {}
    for name in names:
        def go(name=name):
            err = quietly(cmd_wake, name=name, model=None, quiet=True)
            print(f"{name}: {err or 'woken'}", flush=True)
            if err:
                failed[name] = err
        threads.append(threading.Thread(target=go))
        threads[-1].start()
    for t in threads:
        t.join()
    if failed:
        raise_alert(tr("秘书启动时这些 worker 没能自动恢复（仍是搁置状态，可以再试 claudesec wake）：\n",
                       "When the secretary started, these workers couldn't be brought back automatically (still "
                       "shelved; claudesec wake can try again):\n")
                    + "\n".join(f"- {n}: {e.splitlines()[0][:400]}" for n, e in failed.items()))


def cmd_spawn(args):
    cfg = config()
    name = args.name
    if not NAME_RE.match(name):
        sys.exit(f"bad worker name {name!r}: use lowercase letters, digits, dashes")
    refuse_while_frozen(f"spawn {name}")
    _, workers = read_registry()
    old = workers.get(name)
    if old and old["status"] == "SHELVED":
        sys.exit(f"{name} is a shelved worker: `claudesec wake {name}` it, or `claudesec close {name}` to forget it")
    if old and old.get("window") in alive_windows():
        sys.exit(f"worker {name} is already running in window {old['window']}")
    task = getattr(args, "task", None) or sys.stdin.read().strip()
    if not task:
        sys.exit("empty task: pass the user's words on stdin")
    if args.dir:
        project = str(Path(args.dir).expanduser().resolve())
    else:  # ops and general work: a directory of its own that a reboot keeps
        (HOME / "work" / name).mkdir(parents=True, exist_ok=True)
        project = str((HOME / "work" / name).resolve())
    if args.for_worker and args.for_worker not in workers:
        sys.exit(f"--for {args.for_worker}: no such worker")
    cursor = args.agent == "cursor"
    budget_usd = getattr(args, "budget", None)
    if budget_usd is not None and (cursor or budget_usd <= 0):
        sys.exit("--budget: only for Claude Code workers (claudesec can't see what a Cursor agent spends), "
                 "and above 0" if cursor else "--budget must be above 0")
    model = args.model or cfg["cursor_worker_model" if cursor else "worker_model"]
    model = model if cursor else unpaid(model)
    if cursor:
        require_cursor("spawn --agent cursor")
        if not args.for_worker:  # a delegation was checked by delegate, which says it its own way
            cursor_room(f"spawn {name}")
        check_cursor_http1()

    if args.discuss:
        initial = tr(f"用户想跟你讨论，秘书转来的原话：\n\n{task}\n\n"
                     "这是讨论模式：用户现在就在看你这个窗口，直接跟用户对话。规则见系统提示里的「讨论模式」。\n",
                     f"The user wants to talk this over with you; the secretary passes on their words:\n\n{task}\n\n"
                     "This is discussion mode: the user is looking at this window now; talk to them directly. "
                     "The rules are under \"Discussion mode\" in your system prompt.\n")
    elif args.for_worker:
        initial = tr(f"worker {args.for_worker} 委托给你的任务（它写的任务书原文）：\n\n{task}\n",
                     f"A task delegated to you by worker {args.for_worker} (its brief as written):\n\n{task}\n")
    else:
        initial = getattr(args, "intro", None) or tr("秘书派给你的任务（用户原话）：\n\n",
                                                     "A task from the secretary (the user's own words):\n\n")
        initial += f"{task}\n"
    memory = getattr(args, "memory", None)
    d = prepare_worker(name, cfg, initial, project, agent=args.agent, memory=memory)
    (d / "task.md").write_text(task + "\n")
    target = ["-t", f"={cfg['tmux_session']}:"] if has_session(cfg["tmux_session"]) else []
    # A Cursor worker's window runs `hook cursor-launch`, which runs the agent: it retries or falls
    # back when the model is refused, and records a failure instead of a STARTING that never ends.
    cmd = cursor_launch_command(name, model) if cursor else worker_command(name, d, cfg, model)
    window = tmux("new-window", "-d", *target, "-P", "-F", "#{window_id}", "-n", name, "-c", project, cmd).strip()

    with registry() as reg:
        reg["workers"][name] = {
            "window": window, "dir": project, "model": model, "task": task, "agent": args.agent,
            "delegated_by": args.for_worker, "memory": memory,
            "mode": "discuss" if args.discuss else "task",
            "status": "STARTING", "started_at": now(), "last_report_at": None,
            "last_summary": "", "pending_ask": None, "session": None, "archived": None,
            **({"budget_usd": budget_usd} if budget_usd else {}),
        }
        if not args.for_worker:  # a delegated one is its delegator's business, not the user's focus
            reg["focus"] = name
    append_log(name, "task", task)
    set_worker_budget_marker(name, budget_usd)
    if args.discuss:
        # The user talks to a discussion worker directly, so take them there now.
        tmux("select-window", "-t", window, check=False)
    if not stuck_on_dialog(name, window):
        verb = "discussion window opened and switched to" if args.discuss else "spawned"
        print(f"{verb} {name} ({model}) in window {window}, dir {project}")


def prepare_worker(name, cfg, initial, cwd, fresh_log=True, agent="claude", memory=None):
    """Fresh log, rules prompt, first message and hook settings for a worker; returns its dir.
    memory: another auto memory dir than cwd's (the review worker tidies the secretary's).
    A Cursor worker's hooks are global, in ~/.cursor/hooks.json (see install_cursor_hooks)."""
    # A reused name starts a fresh log; the old one stays next to it.
    if fresh_log and log_path(name).exists():
        log_path(name).rename(log_path(name).with_suffix(f".{int(time.time())}.log"))
    d = worker_dir(name)
    for mark in ("reported", "finish", AFTER_REPORT):
        (d / mark).unlink(missing_ok=True)
    prompt = render_prompt((PROMPTS / ("worker-cursor.md" if agent == "cursor" else "worker.md")).read_text())
    prompt = (prompt.replace("{{NAME}}", name).replace("{{SECRETARY}}", cfg["secretary_name"])
              .replace("{{CLAUDESEC}}", hook_cmd()))
    (d / "prompt.md").write_text(prompt)
    (d / "initial.md").write_text(initial)
    (d / "waiting-permission").unlink(missing_ok=True)
    (d / "busy").unlink(missing_ok=True)
    if agent == "cursor":
        install_cursor_hooks()
        return d
    cmd = hook_cmd()
    q = shlex.quote(name)
    asking = {"type": "command", "command": f"{cmd} hook worker-permission {q}"}
    # Any tool event after a prompt means it was answered; the test keeps the common case cheap.
    # Also how a worker seen as done or waiting (its last report) is seen working again (AFTER_REPORT).
    answered = [{"matcher": "*", "hooks": [{"type": "command", "command":
                 f"[ ! -e {shlex.quote(str(d / 'waiting-permission'))} ] && [ ! -e {shlex.quote(str(d / AFTER_REPORT))} ]"
                 f" || {cmd} hook worker-permission-done {q}"}]}]
    # Budgets: before every tool call, but only a file test unless a window or this worker's budget is set.
    budget = [{"matcher": "*", "hooks": [{"type": "command", "command":
               f"[ ! -e {shlex.quote(str(HOME / 'budget.json'))} ] && [ ! -e {shlex.quote(str(d / 'budget_usd'))} ]"
               f" || {cmd} hook worker-budget {q}"}]}]
    own = {"autoMemoryDirectory": memory} if memory else memory_settings(cwd)
    (d / "settings.json").write_text(json.dumps({**own, "hooks": {
        "SessionStart": [{"hooks": [{"type": "command", "command": f"{cmd} hook worker-session-start {q}"}]}],
        "PreToolUse": budget,
        "PermissionRequest": [{"matcher": "*", "hooks": [asking]}],
        "Notification": [{"matcher": "permission_prompt|elicitation_dialog|elicitation_url_dialog",
                          "hooks": [asking]}],
        "PostToolUse": [{"matcher": "SendMessage",
                         "hooks": [{"type": "command", "command": f"{cmd} hook worker-report {q}"}]}, *answered],
        "PostToolUseFailure": [{"matcher": "SendMessage",
                                "hooks": [{"type": "command", "command": f"{cmd} hook worker-report {q}"}]}, *answered],
        "PermissionDenied": answered,
        "Stop": [{"hooks": [{"type": "command", "command": f"{cmd} hook worker-stop {q}"}]}],
        "StopFailure": [{"hooks": [{"type": "command", "command": f"{cmd} hook worker-stop-failure {q}"}]}],
    }}, indent=2) + "\n")
    return d


@functools.lru_cache(maxsize=None)
def fresh_prompt():
    """Claude Code records a conversation's system prompt on its first request and replays it on
    every resume, ignoring the --append-system-prompt-file of a later launch. So an adopted
    session would never see the worker rules, and a resumed worker or secretary would keep
    rules since edited. Turn the record off, where this Claude Code has it."""
    with contextlib.suppress(OSError, subprocess.SubprocessError):
        out = subprocess.run(["claude", "--help"], capture_output=True, text=True,
                             stdin=subprocess.DEVNULL, timeout=30).stdout
        if "--system-prompt-snapshot" in out:
            return ["--system-prompt-snapshot", "off"]
    return []


def worker_command(name, d, cfg, model, *extra, prompt=True):
    return " ".join(shlex.quote(a) for a in [
        "claude", "-n", name, "--model", model,
        "--permission-mode", cfg["worker_permission_mode"],
        "--settings", str(d / "settings.json"),
        "--append-system-prompt-file", str(d / "prompt.md"), *fresh_prompt(), *extra,
    ]) + (f' "$(cat {shlex.quote(str(d / "initial.md"))})"' if prompt else "")


# ---------- Cursor workers: the `agent` CLI in a window ----------
# No per-session hooks, no SendMessage, no sessions/<pid>.json. Its hooks are global, so each one
# first checks CLAUDESEC_WORKER, which only a claudesec worker's command sets; it reports by
# running `claudesec report`, which reaches the secretary through the alert channel; the
# secretary talks to it with `claudesec send`, a paste into its window.

CURSOR_HOOKS = {"sessionStart": "cursor-session-start", "beforeSubmitPrompt": "cursor-prompt",
                "stop": "cursor-stop"}
CURSOR_NAGS = 3  # follow-ups asking for a report before the stop hook gives up and alerts


def install_cursor_hooks():
    """Put claudesec's entries into ~/.cursor/hooks.json, keeping everything else; a backup is
    written first whenever the file changes. Each entry does nothing outside a claudesec worker."""
    path = Path.home() / ".cursor" / "hooks.json"
    old = path.read_text() if path.exists() else ""
    conf = json.loads(old) if old.strip() else {"version": 1, "hooks": {}}
    hooks = conf.setdefault("hooks", {})
    for event in list(hooks):  # also drops entries for events claudesec no longer hooks
        hooks[event] = [e for e in hooks[event] if "CLAUDESEC_WORKER" not in e.get("command", "")]
    for event, hook in CURSOR_HOOKS.items():
        hooks.setdefault(event, []).append({"type": "command", "command":
                        f'[ -z "${{CLAUDESEC_WORKER:-}}" ] || {shlex.quote(str(SELF))} hook {hook}'})
    new = json.dumps(conf, indent=2, ensure_ascii=False) + "\n"
    if new == old:
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    if old:
        (path.parent / f"hooks.json.bak-claudesec-{int(time.time())}").write_text(old)
    tmp = path.with_suffix(".claudesec-tmp")
    tmp.write_text(new)
    tmp.replace(path)


def cursor_launch_command(name, model):
    """What a spawned Cursor worker's window runs. nice goes after the VAR=value assignments:
    put before them, it takes the first one for the command to run, and the window dies at once."""
    return (f"CLAUDESEC_MODEL={shlex.quote(model)} CLAUDESEC_HOME={shlex.quote(str(HOME))} {cursor_nice()}"
            f"{shlex.quote(str(SELF))} hook cursor-launch {shlex.quote(name)}")


def cursor_command(name, model, *extra, d=None):
    """The worker's agent command; with d, its first message comes from d/initial.md."""
    env = f"CLAUDESEC_WORKER={shlex.quote(name)} CLAUDESEC_HOME={shlex.quote(str(HOME))}"
    return (env + " " + cursor_nice() + " ".join(shlex.quote(a) for a in ["agent", "--model", model, "--trust", *extra])
            + (f' "$(cat {shlex.quote(str(d / "initial.md"))})"' if d else ""))


def is_cursor(w):
    return (w or {}).get("agent") == "cursor"


def cursor_available():
    """(usable, why): whether Cursor workers can be started on this machine."""
    setting = config().get("cursor", "auto")
    if setting is False or str(setting).lower() in ("false", "off", "no", "0"):
        return False, tr("已关（config.json 里 \"cursor\": false）", "off (\"cursor\": false in config.json)")
    path = shutil.which("agent")
    if path:
        return True, tr(f"可用（{path}）", f"available ({path})")
    return False, (tr("config.json 里开着，但", "on in config.json, but ") if setting is True else "") + \
        tr("这台机器上没有 `agent` 命令（Cursor CLI）", "no `agent` command (Cursor CLI) on this machine")


def require_cursor(what):
    ok, why = cursor_available()
    if not ok:
        sys.exit(f"{what}: Cursor workers are not available here — {why}.")


CURSOR_AT_WORK = {"STARTING", "PROGRESS"}


def cursor_busy(but=None):
    """Cursor workers whose agent is at work on this machine: a live window and a turn under way.
    One idling at its prompt (done, waiting on the user) costs next to no CPU and doesn't count."""
    alive = alive_windows()
    return sorted(n for n, w in read_registry()[1].items()
                  if is_cursor(w) and n != but and w["status"] in CURSOR_AT_WORK and w.get("window") in alive)


def cursor_limit():
    """cursor_max_running as it applies: a number set in config.json as is (0: no limit), else half
    this machine's cores, at least one (the user, 2026-10-26: the devbox can run plenty)."""
    value = config().get("cursor_max_running")
    if value is None or str(value).lower() == "auto":
        return max(1, (os.cpu_count() or 2) // 2)
    return int(value)


def cursor_room(what, but=None, prefix=""):
    """Refuse when cursor_max_running Cursor workers are already at work: each agent is a local
    process tree that can take whole cores (the user's CPU, 2026-10-24)."""
    limit = cursor_limit()
    busy = cursor_busy(but)
    if limit and len(busy) >= limit:
        sys.exit(f"{prefix}{what}: {len(busy)} Cursor workers are already at work ({', '.join(busy)}), the limit "
                 f"(cursor_max_running in config.json) is {limit}. Wait for one to finish, or do it with a "
                 f"subagent or yourself.")


def cursor_nice():
    """`nice -n N ` before a Cursor agent's command, or nothing."""
    n = int(config().get("cursor_nice") or 0)
    return f"nice -n {n} " if n > 0 and shutil.which("nice") else ""


def render_prompt(text):
    """Keep or drop the prompt's Cursor parts: <!-- if cursor --> A [<!-- else --> B] <!-- end cursor -->."""
    on = cursor_available()[0]

    def pick(m):
        return m.group(1) if on else (m.group(2) or "")
    return re.sub(r"<!-- if cursor -->\n(.*?)(?:<!-- else -->\n(.*?))?<!-- end cursor -->\n", pick, text, flags=re.S)


def check_cursor_http1():
    """Over HTTP/2 the agent stalls on agentn.us.api5.cursor.sh on the Mac's network, whatever the
    model; say so rather than leave a worker that never answers. Only a warning: the file is the
    user's. The devbox (Linux) talks HTTP/2 fine (two long tool-using runs, 2026-10-22)."""
    if sys.platform != "darwin":
        return
    path = Path.home() / ".cursor" / "cli-config.json"
    try:
        on = (json.loads(path.read_text()).get("network") or {}).get("useHttp1ForAgent") is True
    except (OSError, ValueError, AttributeError):
        on = False
    if not on:
        print(f"WARNING: {path} does not set \"network\": {{\"useHttp1ForAgent\": true}}. Without it the "
              "agent talks HTTP/2 to agentn.us.api5.cursor.sh and, on this network, stalls on "
              "\"Connection stalled\" with any model, so the worker never gets through a turn. "
              "To fix: back the file up, add that key under \"network\" (leave the rest as it is), "
              "then restart the worker: close and spawn it again, or shelve and wake it.", flush=True)


def cursor_chat_exists(chat):
    return bool(chat) and any((Path.home() / ".cursor" / "chats").glob(f"*/{chat}"))


def conversation_exists(w):
    return cursor_chat_exists(w.get("session")) if is_cursor(w) else bool(w.get("session") and transcript(w["session"]))


SCRATCH_ROOTS = tuple({Path("/tmp"), Path("/tmp").resolve(), Path(tempfile.gettempdir()).resolve()})  # a reboot wipes these


def where_now(path):
    """A recorded working directory as it is today: (dir, note). A move recorded by `claudesec
    redir` is followed; a directory under the temp dir, which a reboot wipes, is made again, empty
    (what was in it is gone; the conversation still says what it was doing). (None, None) when it
    is gone and nothing says where it went."""
    if Path(path).is_dir():
        return path, None
    reg_path = HOME / "registry.json"
    moves = (json.loads(reg_path.read_text()) if reg_path.exists() else {}).get("moved", {})
    for old in sorted(moves, key=len, reverse=True):
        if path == old or path.startswith(old + "/"):
            new = moves[old] + path[len(old):]
            if Path(new).is_dir():
                return new, f"{path} moved to {new}"
    root = next((r for r in SCRATCH_ROOTS if r in Path(path).parents), None)
    if root:
        with contextlib.suppress(OSError):
            Path(path).mkdir(parents=True, exist_ok=True)
            return path, f"{path} was under {root}, which a reboot wipes: made it again, empty"
    return None, None


def started_in(path):
    """The directory a Claude Code transcript's session was started in."""
    with contextlib.suppress(OSError):
        with open(path) as f:
            for line in f:
                if '"cwd"' in line:
                    with contextlib.suppress(ValueError):
                        if (cwd := json.loads(line).get("cwd")):
                            return cwd
    return None


def follow_conversation(w, cwd, old=None):
    """Move a shelved worker's conversation to where `--resume` run in cwd looks for it, once the
    directory it was started in has moved away. Claude Code keeps transcripts by start directory
    (projects/<dir with - for every non-alphanumeric>/), and only one whose start directory is
    gone is moved. Cursor keeps chats by the md5 of the directory; one is moved only out of old,
    the directory the worker is known to have left. Returns what was moved, or None."""
    sid = w.get("session")
    if not sid:
        return None
    if is_cursor(w):
        chats = Path.home() / ".cursor" / "chats"
        src = chats / hashlib.md5(str(old).encode()).hexdigest() / sid if old else None
        dst = chats / hashlib.md5(str(cwd).encode()).hexdigest() / sid
        if not src or not src.is_dir() or src == dst or dst.exists():
            return None
        dst.parent.mkdir(parents=True, exist_ok=True)
        src.rename(dst)
        return f"chat {sid} moved to {dst.parent}"
    src = transcript(sid)
    if not src:
        return None
    start = started_in(src)
    dst = claude_project(cwd)
    if src.parent == dst or not start or start == str(cwd) or Path(start).is_dir() or (dst / src.name).exists():
        return None
    dst.mkdir(parents=True, exist_ok=True)
    if (src.parent / sid).is_dir() and not (dst / sid).exists():  # its subagents and tool results
        (src.parent / sid).rename(dst / sid)
    src.rename(dst / src.name)
    return f"transcript {sid} moved from {src.parent.name} to {dst.name}"


def cursor_running(w):
    if w.get("window") not in alive_windows():
        return False  # no -t "" below: that would ask about the caller's own pane
    return tmux("display", "-p", "-t", w["window"], "#{pane_dead}", check=False).strip() == "0"


def worker_busy(name, w):
    """Mid-turn, or (Claude Code) waiting on background tasks: not to be stopped."""
    if is_cursor(w):
        return cursor_running(w) and (HOME / "workers" / name / "busy").exists()
    holder = live_holder(w.get("session"))
    return bool(holder) and session_status(holder)[0] in ("busy", "background")


def confirm_cursor_start(pane, d):
    """A resumed Cursor chat fires no sessionStart, so there is no session id to wait for:
    the agent drawing its screen and staying up is as good as it gets."""
    screen = ""
    for i in range(20):
        time.sleep(1)
        screen = pane_text(pane, suggestion="drop")
        if (d / "exit").exists() or tmux("display", "-p", "-t", pane, "#{pane_dead}", check=False).strip() != "0":
            return "agent exited", screen
        if i >= 4 and re.search(r"Cursor Agent|Add a follow-up|ctrl\+c to stop", screen):
            return "ok", screen
    return "agent did not come up within 20s", screen


def stuck_on_dialog(name, target):
    """Catch dialogs that would stall a window nobody is looking at."""
    for _ in range(8):
        time.sleep(1)
        pane = pane_text(target, suggestion="drop")
        if not pane and target not in alive_windows():
            sys.exit(f"worker {name}: {target} exited right away")
        if answer_credit_dialog(name, target, pane):
            continue
        if re.search(r"trust this folder|Do you trust|Enter to confirm|Do you want to", pane):
            tail = "\n".join(l for l in pane.splitlines() if l.strip())[-1200:]
            print(f"{name} started in {target}, but it is STUCK ON A DIALOG — tell the user to "
                  f"switch to window '{name}' and answer it:\n{tail}")
            return True
    return False


# ---------- sessions claudesec did not start ----------

ADOPT_PROMPT = """你刚被 claudesec 秘书接管：会话历史都在，从现在起按系统提示里的 worker 规则工作。
先用 SendMessage 给秘书发第一条汇报，让秘书知道你的情况：
- DID 写你之前在做什么、做到了哪里。
- 上一轮的事已经做完 → TYPE: DONE，按格式给出 RESULT 和 DECISIONS。
- 上一轮停下是在等用户回答 → TYPE: NEED_DECISION，把问题在 ASK 里重新问一遍。
- 其他情况 → TYPE: BLOCKED，ISSUE 写「等秘书确认下一步」。
发完就停，不要自己开始新的工作。
"""
ADOPT_PROMPT_EN = """The claudesec secretary has just taken you over: your conversation history is all here; from now on
you work by the worker rules in your system prompt.
First send the secretary a report with SendMessage, so it knows where you stand:
- DID: what you were doing before and how far you got.
- If your last task is finished: TYPE: DONE, with RESULT and DECISIONS as the format says.
- If you stopped waiting for the user's answer: TYPE: NEED_DECISION, and ask the question again in ASK.
- Otherwise: TYPE: BLOCKED, with ISSUE "waiting for the secretary to confirm the next step".
Then stop; don't start any new work on your own.
"""


def claude_sessions():
    """Live Claude Code sessions on this machine, from Claude Code's own sessions/<pid>.json."""
    out = []
    for f in (claude_dir() / "sessions").glob("*.json"):
        try:
            s = json.loads(f.read_text())
            os.kill(s["pid"], 0)
        except (OSError, ValueError, KeyError):
            continue
        out.append(s)
    return out


def background_tasks(conv):
    """What a live session started in the background and has not heard back from: async
    subagents, background commands, monitors. The session sits at its prompt, status idle,
    while they run, and restarting it kills them. A background job's daemon keeps count; for
    any other session they are read off the transcript: launched since this process started,
    with no final task-notification and not stopped. A finished subagent that a SendMessage
    woke runs again, until its next notification."""
    if not conv.get("startedAt"):
        return []  # no live process, nothing of its can be running
    if conv.get("kind") == "bg":
        with contextlib.suppress(OSError, ValueError, TypeError, AttributeError):
            state = json.loads((claude_dir() / "jobs" / conv["jobId"] / "state.json").read_text())
            flight = state.get("inFlight") or {}
            n = flight.get("tasks", 0) + flight.get("queued", 0)
            labels = [f"{f.get('kind')}「{f.get('label')}」" for f in state.get("fan") or []][:n]
            return labels + [tr("后台任务", "bg task")] * (n - len(labels))

    def stamp(e):
        with contextlib.suppress(ValueError, TypeError, AttributeError, KeyError):
            return dt.datetime.fromisoformat(e["timestamp"].replace("Z", "+00:00")).timestamp()
        return 0

    started, running, described = conv["startedAt"] / 1000, {}, {}
    path = transcript(conv.get("sessionId") or "")
    for line in open(path, errors="replace") if path else []:
        if not any(k in line for k in ('"isAsync":true', '"resumedAgentId"', '"backgroundTaskId"', '"timeoutMs"',
                                        "<task-notification>", '"TaskStop"', '"KillShell"')):
            continue
        try:
            e = json.loads(line)
        except ValueError:
            continue
        content = e.get("content") if e.get("type") == "queue-operation" else (e.get("message") or {}).get("content")
        if isinstance(content, str) and content.startswith("<task-notification>"):
            m = re.search(r"<task-id>([^<]+)</task-id>", content)
            # A monitor's events carry no status; only its expiry notice ends it.
            if m and (re.search(r"<status>(?!running<)[^<]+</status>", content) or "<event>[Monitor " in content):
                running.pop(m.group(1), None)
            continue
        if e.get("type") == "assistant":
            for b in content if isinstance(content, list) else []:
                if isinstance(b, dict) and b.get("type") == "tool_use" and b.get("name") in ("TaskStop", "KillShell"):
                    inp = b.get("input") or {}
                    running.pop(inp.get("task_id") or inp.get("shell_id"), None)
            continue
        r = e.get("toolUseResult")
        if not isinstance(r, dict):
            continue
        if r.get("isAsync") and r.get("agentId"):
            described[r["agentId"]] = f"subagent「{r.get('description', '')}」"
        if stamp(e) < started:
            continue  # what an earlier process of this conversation started died with it
        if r.get("isAsync") and r.get("agentId"):
            running[r["agentId"]] = (described[r["agentId"]], None)
        elif r.get("resumedAgentId"):
            running[r["resumedAgentId"]] = (described.get(r["resumedAgentId"], "subagent"), None)
        elif r.get("backgroundTaskId"):
            running[r["backgroundTaskId"]] = (tr("后台命令", "bg command"), None)
        elif r.get("taskId") and r.get("timeoutMs"):
            running[r["taskId"]] = ("monitor", None if r.get("persistent") else stamp(e) + r["timeoutMs"] / 1000)
    return [what for what, until in running.values() if until is None or until > time.time()]


def session_status(conv):
    """A live session's status and its background tasks. Idle at the prompt with background
    tasks still running is "background": as unsafe to restart as busy."""
    status = conv.get("status", "?")
    tasks = background_tasks(conv) if status == "idle" else []
    return ("background" if tasks else status), tasks


def status_label(conv):
    status, tasks = session_status(conv)
    return tr(f"后台任务×{len(tasks)}", f"bg tasks ×{len(tasks)}") if tasks else status


def external_sessions():
    """Conversations claudesec could adopt. A foreground client parked on a background job (the
    daemon's `bg` host) is folded into that job: the conversation lives in the job, the
    client's own sessionId is empty. The job's session is under s["bg"]."""
    cfg = config()
    _, workers = read_registry()
    ids = {w.get("session") for w in workers.values()}
    with contextlib.suppress(OSError):
        ids.add((HOME / "secretary.session").read_text().strip())
    ids -= {None, ""}
    # Not by name: Claude Code names a resumed session on its own (agentlodge-da) before
    # /rename puts the worker's name back, and a stranger may share a worker's name. A worker
    # being woken is in the registry with its window but no session id yet.
    windows = {w.get("window") for w in workers.values()} - {None}
    panes = set(tmux("list-panes", "-s", "-t", f"={cfg['tmux_session']}:", "-F", "#{pane_id}",
                     check=False).split())
    live = claude_sessions()
    jobs = {s["jobId"]: s for s in live if s.get("kind") == "bg" and s.get("jobId")}
    out = []
    for s in live:
        if s.get("kind") == "interactive" and s.get("parkedJobId") in jobs:
            s["bg"] = jobs.pop(s["parkedJobId"])
    for s in live:
        if s.get("kind") == "bg" and s.get("jobId") not in jobs:
            continue  # folded into the client parked on it
        if s.get("kind") not in ("interactive", "bg"):
            continue
        conv = s.get("bg") or s
        if conv.get("sessionId") in ids or s.get("sessionId") in ids:
            continue
        at = re.match(r"^[^:]*:(@\d+)\.(%\d+)$", s.get("tmux") or "")
        if at and (at[1] in windows or at[2] in panes):
            continue  # in claudesec's own tmux session, or a worker's window
        out.append(s)
    return sorted(out, key=lambda s: s.get("startedAt", 0))


def session_kind(s):
    if s.get("bg"):
        return tr(f"前台挂在后台 {s['bg'].get('jobId')}", f"attached to bg {s['bg'].get('jobId')}")
    if s.get("kind") == "bg":
        return tr(f"后台 {s.get('jobId')}", f"bg {s.get('jobId')}")
    return tr("前台", "interactive")


def session_rows(sessions):
    rows = [tr(("会话", "类型", "状态", "tmux", "目录"), ("session", "kind", "state", "tmux", "dir"))]
    for s in sessions:
        conv = s.get("bg") or s
        rows.append((s.get("name", "?"), session_kind(s), status_label(conv),
                     s.get("tmux") or tr("（不在 tmux）", "(not in tmux)"), Path(conv.get("cwd", "")).name))
    return rows


def print_rows(rows):
    widths = [max(width(r[i]) for r in rows) for i in range(len(rows[0]))]
    for r in rows:
        print("  ".join(pad(c, widths[i]) for i, c in enumerate(r)).rstrip())


def cmd_sessions(args):
    sessions = external_sessions()
    if not sessions:
        print(tr("没有 claudesec 之外的 Claude 会话。", "No Claude sessions outside claudesec."))
        return
    print_rows(session_rows(sessions))


def transcript(sid):
    return next(claude_dir().glob(f"projects/*/{sid}.jsonl"), None)


USAGE_KEYS = ("input_tokens", "cache_creation_input_tokens", "cache_read_input_tokens", "output_tokens")
# What a response is billed for, in order: input, cache write (5-minute TTL), cache write (1-hour TTL),
# cache read, output. The two writes cost different prices (1.25x and 2x input).
USAGE_PARTS = 5


def response_parts(usage):
    """A response's usage as the USAGE_PARTS counts. A transcript older than the TTL split
    counts every cache write as 5-minute, the default."""
    write = int(usage.get("cache_creation_input_tokens") or 0)
    split = usage.get("cache_creation") or {}
    w1h = int(split.get("ephemeral_1h_input_tokens") or 0)
    w5m = int(split.get("ephemeral_5m_input_tokens") or 0) if split else write
    return [int(usage.get("input_tokens") or 0), w5m, w1h, int(usage.get("cache_read_input_tokens") or 0),
            int(usage.get("output_tokens") or 0)]


def usage_key(entry, message):
    """A bucket: the local hour the response came in, its model and its speed."""
    try:
        hour = dt.datetime.fromisoformat(str(entry.get("timestamp", "")).replace("Z", "+00:00")).astimezone()
        hour = hour.strftime("%Y-%m-%dT%H")
    except ValueError:
        hour = "unknown"
    speed = (message.get("usage") or {}).get("speed") or "standard"
    return f"{hour}|{message.get('model') or 'unknown'}|{speed}"


def file_usage(path, seen):
    """Token usage in a transcript, read on from where `seen` (this file's cache entry) left off:
    {"offset", "buckets": {hour|model|speed: [USAGE_PARTS]}, "last_id", "last_key", "last"}. A response
    streamed in several content blocks writes one line per block, each with the same message id
    and usage, so a line with the previous one's id replaces its usage instead of adding to it."""
    size = path.stat().st_size
    if not seen or seen["offset"] > size or "buckets" not in seen:  # new, rewritten, or an older format
        seen = {"offset": 0, "buckets": {}, "last_id": None, "last_key": None, "last": [0] * USAGE_PARTS}
    if seen["offset"] == size:
        return seen
    with open(path, "rb") as f:
        f.seek(seen["offset"])
        data = f.read(size - seen["offset"])
    data = data[:data.rfind(b"\n") + 1]  # a line still being written waits for the next look
    buckets = {k: list(v) for k, v in seen["buckets"].items()}
    last_id, last_key, last = seen["last_id"], seen["last_key"], list(seen["last"])
    for line in data.splitlines():
        if b'"usage"' not in line:
            continue
        with contextlib.suppress(ValueError):
            e = json.loads(line)
            m = e.get("message")
            if e.get("type") != "assistant" or not isinstance(m, dict) or not isinstance(m.get("usage"), dict):
                continue
            use, key = response_parts(m["usage"]), usage_key(e, m)
            if m.get("id") and m.get("id") == last_id and last_key in buckets:
                buckets[last_key] = [t - l for t, l in zip(buckets[last_key], last)]
            buckets[key] = [t + u for t, u in zip(buckets.get(key, [0] * USAGE_PARTS), use)]
            last_id, last_key, last = m.get("id"), key, use
    return {"offset": seen["offset"] + len(data), "buckets": buckets, "last_id": last_id,
            "last_key": last_key, "last": last}


def session_buckets(sids):
    """{session id: {hour|model|speed: [USAGE_PARTS]}} over each session's transcript and its
    subagents'; None for one with no transcript. Cached in usage.json by file and offset, so
    the dashboard's redraws only read what was appended since."""
    path = HOME / "usage.json"
    try:
        cache = json.loads(path.read_text())
    except (OSError, ValueError):
        cache = {}
    out, changed = {}, False
    for sid in sids:
        main = transcript(sid)
        if not main:
            out[sid] = None
            continue
        merged = {}
        for f in [main, *sorted((main.parent / sid / "subagents").glob("*.jsonl"))]:
            with contextlib.suppress(OSError):
                seen = file_usage(f, cache.get(str(f)))
                changed |= seen != cache.get(str(f))
                cache[str(f)] = seen
                for key, v in seen["buckets"].items():
                    merged[key] = [t + u for t, u in zip(merged.get(key, [0] * USAGE_PARTS), v)]
        out[sid] = merged
    if changed:
        tmp = path.with_name(f".usage.{os.getpid()}.tmp")
        with contextlib.suppress(OSError):
            tmp.write_text(json.dumps(cache))
            os.replace(tmp, path)
    return out


def in_period(key, since=None, until=None):
    """Whether a bucket's hour falls in [since, until) (local datetimes, hour precision)."""
    hour = key.split("|", 1)[0]
    if hour == "unknown":
        return since is None and until is None
    start = dt.datetime.strptime(hour, "%Y-%m-%dT%H").astimezone()
    return (since is None or start >= since.replace(minute=0, second=0, microsecond=0)) and \
        (until is None or start < until)


def session_usage(sids, since=None, until=None):
    """{session id: [input, cache write, cache read, output]}, both cache writes summed; None for
    one with no transcript."""
    out = {}
    for sid, buckets in session_buckets(sids).items():
        if buckets is None:
            out[sid] = None
            continue
        total = [0] * USAGE_PARTS
        for key, v in buckets.items():
            if in_period(key, since, until):
                total = [t + u for t, u in zip(total, v)]
        out[sid] = [total[0], total[1] + total[2], total[3], total[4]]
    return out


def managed_sessions():
    """{session id: who it belongs to} for every Claude Code session claudesec has run: the
    secretary's, its workers' (shelved too), and those of workers since archived and closed (by
    their history files). A subagent's transcript sits under its session and counts with it.
    Cursor workers have no transcript here and aren't counted."""
    out = {}
    with contextlib.suppress(OSError, ValueError):
        for path in (HOME / "history").glob("*/*.md"):
            text = path.read_text()
            if not text.startswith("---\n"):
                continue
            meta = {}
            for line in text.split("\n---\n", 1)[0].splitlines()[1:]:
                key, _, value = line.partition(": ")
                with contextlib.suppress(ValueError):
                    meta[key] = json.loads(value)
            if meta.get("session") and meta.get("worker") not in (None, "subagent") \
                    and "cursor" not in (meta.get("tags") or []):
                out[meta["session"]] = meta["worker"]
    for name, w in read_registry()[1].items():
        if w.get("session") and not is_cursor(w):
            out[w["session"]] = name
    with contextlib.suppress(OSError):
        out[(HOME / "secretary.session").read_text().strip()] = config()["secretary_name"]
    return out


# USD per million tokens: input, cache write 5-minute, cache write 1-hour, cache read, output.
# From platform.claude.com/docs/en/about-claude/pricing, checked 2026-10-26. A model id is matched
# by its longest prefix in this table (claude-haiku-4-5-20251001 is claude-haiku-4-5). Fast mode
# ("<model> fast"): the fast base price with the usual cache multipliers on top, as that page says.
# Claude Haiku 5.5 costs more past 100K-token prompts; a bucket can't tell, so this is the lower tier.
# config.json "prices" adds to or overrides this table, same shape. A model in neither is
# "unpriced" and left out of every sum, never counted as free.
PRICES = {
    "claude-fable-5-1": [10, 12.5, 20, 0.25, 50],
    "claude-mythos-5-1": [10, 12.5, 20, 0.25, 50],
    "claude-fable-5": [10, 12.5, 20, 1, 50],
    "claude-mythos-5": [10, 12.5, 20, 1, 50],
    "claude-opus-5-5": [4, 5, 8, 0.20, 20],
    "claude-opus-5-5 fast": [8, 10, 16, 0.40, 40],
    "claude-opus-5": [5, 6.25, 10, 0.50, 25],
    "claude-opus-5 fast": [10, 12.5, 20, 1, 50],
    "claude-opus-4-8": [5, 6.25, 10, 0.50, 25],
    "claude-opus-4-8 fast": [10, 12.5, 20, 1, 50],
    "claude-opus-4-7": [5, 6.25, 10, 0.50, 25],
    "claude-opus-4-6": [5, 6.25, 10, 0.50, 25],
    "claude-opus-4-5": [5, 6.25, 10, 0.50, 25],
    "claude-opus-4-1": [15, 18.75, 30, 1.50, 75],
    "claude-opus-4": [15, 18.75, 30, 1.50, 75],
    "claude-sonnet-5-5": [2, 2.5, 4, 0.10, 10],
    "claude-sonnet-5": [2, 2.5, 4, 0.20, 10],
    "claude-sonnet-4-6": [3, 3.75, 6, 0.30, 15],
    "claude-sonnet-4-5": [3, 3.75, 6, 0.30, 15],
    "claude-sonnet-4": [3, 3.75, 6, 0.30, 15],
    "claude-haiku-5-5": [0.10, 0.125, 0.20, 0.01, 0.50],
    "claude-haiku-4-5": [1, 1.25, 2, 0.10, 5],
}


def price_of(model, speed="standard"):
    """The price row for a model and speed, or None when it isn't priced."""
    table = {**PRICES, **(config().get("prices") or {})}
    hits = [k for k in table if not k.endswith(" fast") and (model == k or model.startswith(k + "-"))]
    if not hits:
        return None
    best = max(hits, key=len)
    return table.get(f"{best} fast") if speed == "fast" else table[best]


def cost_of(parts, model, speed="standard"):
    """USD for USAGE_PARTS token counts, or None when the model isn't priced."""
    price = price_of(model, speed)
    return None if price is None else sum(n * p for n, p in zip(parts, price)) / 1e6


def usage_by_owner(since=None, until=None):
    """{owner: {model|speed: [USAGE_PARTS]}} over every session claudesec has run, in the period."""
    owners = managed_sessions()
    out = {}
    for sid, buckets in session_buckets(set(owners)).items():
        for key, v in (buckets or {}).items():
            if not in_period(key, since, until) or not any(v):
                continue  # e.g. Claude Code's own "<synthetic>" error entries: nothing billed
            _, model, speed = key.split("|")
            per = out.setdefault(owners[sid], {})
            per[f"{model}|{speed}"] = [t + u for t, u in zip(per.get(f"{model}|{speed}", [0] * USAGE_PARTS), v)]
    return out


def worker_usage(workers):
    """{worker name: usage or None}: None for a Cursor worker (no transcript to read) and one
    whose session isn't known yet."""
    sids = {n: w.get("session") for n, w in workers.items() if w.get("session") and not is_cursor(w)}
    usage = session_usage(set(sids.values()))
    return {n: usage.get(sids.get(n)) for n in workers}


def short_count(n):
    """1234 -> 1.2K, 3456789 -> 3.5M: a token count in four characters or so."""
    for unit, size in (("B", 1e9), ("M", 1e6), ("K", 1e3)):
        if n >= size:
            v = n / size
            return f"{v:.1f}{unit}" if v < 10 else f"{v:.0f}{unit}"
    return str(n)


def worker_cost(workers, since=None, until=None):
    """{worker name: USD spent, or None}: None for a Cursor worker, one with no session yet, or
    one whose tokens are all on unpriced models."""
    sids = {n: w.get("session") for n, w in workers.items() if w.get("session") and not is_cursor(w)}
    buckets = session_buckets(set(sids.values()))
    out = {}
    for name in workers:
        total = None
        for key, v in (buckets.get(sids.get(name)) or {}).items():
            if not in_period(key, since, until):
                continue
            _, model, speed = key.split("|")
            usd = cost_of(v, model, speed)
            if usd is not None:
                total = (total or 0) + usd
        out[name] = total
    return out


def money(usd):
    """$0.42, $6.2, $123: dollars in about five characters."""
    return f"${usd:.2f}" if usd < 1 else f"${usd:.1f}" if usd < 100 else f"${usd:.0f}"


def money_word(usd, budget=None):
    """A worker's $ column: what it spent, against its budget when it has one ("$6.2 / $10")."""
    spent = "-" if usd is None else money(usd)
    return f"{spent} / {money(float(budget))}" if budget else spent


def spend_today_line():
    """"今天花费：秘书 $44.5 · 全部 $210": the secretary isn't a worker row, and the total takes in the
    shelved and closed workers too. Empty when nothing was spent."""
    today = dt.datetime.now().astimezone().replace(hour=0, minute=0, second=0, microsecond=0)
    per_owner = {}
    for owner, per in usage_by_owner(since=today).items():
        costs = [cost_of(v, *k.split("|")) for k, v in per.items()]
        per_owner[owner] = sum(c for c in costs if c is not None)
    total = sum(per_owner.values())
    if not total:
        return ""
    sec = per_owner.get(config()["secretary_name"], 0.0)
    return tr(f"今天花费：秘书 {money(sec)} · 全部 {money(total)}",
              f"Spent today: secretary {money(sec)} · everything {money(total)}")


def worker_moneys(workers):
    """{name: $ column}: today's spend (the user, 2026-10-26: a worker's lifetime total read as
    today's), or, for one with a budget, its spend against the budget, which counts it all.
    `claudesec cost` has the totals."""
    today = dt.datetime.now().astimezone().replace(hour=0, minute=0, second=0, microsecond=0)
    spent_today = worker_cost(workers, since=today)
    budgeted = {n: w for n, w in workers.items() if w.get("budget_usd")}
    spent_all = worker_cost(budgeted) if budgeted else {}
    return {n: money_word(spent_all.get(n), w["budget_usd"]) if n in budgeted else money_word(spent_today.get(n))
            for n, w in workers.items()}


def usage_word(use):
    """A worker's token column: everything that went through the model, cache reads included."""
    return "-" if use is None else short_count(sum(use))


def usage_detail(use):
    return "" if use is None else tr("token：输入 {} · 缓存写 {} · 缓存读 {} · 输出 {}",
                                     "tokens: input {} · cache write {} · cache read {} · output {}").format(
        *map(short_count, use))


def exited_session(key):
    """A conversation no process holds any more, by session id (prefix of 8+). It is resumed
    in a new window, in the directory it last ran in."""
    if len(key) < 8 or not re.match(r"^[0-9a-f-]+$", key):
        return None
    hits = {p.stem: p for p in claude_dir().glob(f"projects/*/{key}*.jsonl")}
    if len(hits) > 1:
        sys.exit(f"{key!r} matches several sessions: {', '.join(sorted(hits))}")
    if not hits:
        return None
    sid, path = hits.popitem()
    held = next((s for s in claude_sessions() if s.get("sessionId") == sid), None)
    if held:
        sys.exit(f"session {sid} is held by live pid {held['pid']} ({held.get('name')}), "
                 f"which claudesec manages or can't take over")
    if sid in {w.get("session") for w in read_registry()[1].values()}:
        sys.exit(f"session {sid} already belongs to a claudesec worker")
    cwd = None
    with open(path) as f:
        for line in f:
            if '"cwd"' in line:
                with contextlib.suppress(ValueError):
                    cwd = json.loads(line).get("cwd") or cwd
    if not cwd or not Path(cwd).is_dir():
        sys.exit(f"session {sid}: its directory {cwd!r} is gone; nothing to resume in")
    return {"sessionId": sid, "cwd": cwd, "kind": "exited", "status": "idle"}


def wait_exit(pid, secs):
    for _ in range(int(secs * 2)):
        try:
            os.kill(pid, 0)
        except OSError:
            return True
        time.sleep(0.5)
    return False


def find_external(key):
    """An unmanaged live session by name, background job id, or session id (prefix of 8+)."""
    for s in external_sessions():
        conv = s.get("bg") or s
        if key in (s.get("name"), conv.get("name"), conv.get("jobId")) or \
                len(key) >= 8 and conv.get("sessionId", "").startswith(key):
            return s
    return None


def worker_name_for(s, conv, as_name):
    name = as_name or re.sub(r"-[0-9a-f]{2}$", "", (s.get("name") or conv.get("jobId")
                                                    or Path(conv["cwd"]).name).lower())
    name = re.sub(r"[^a-z0-9-]+", "-", name).strip("-")[:32].strip("-")
    if not NAME_RE.match(name) or name in read_registry()[1]:
        sys.exit(f"can't use {name!r} as the worker name; pass --as NAME")
    return name


def stop_bg_job(conv):
    """Stopped through Claude Code, so its daemon doesn't respawn the host."""
    r = subprocess.run(["claude", "stop", conv["jobId"]], capture_output=True, text=True,
                       stdin=subprocess.DEVNULL, timeout=60)
    if not wait_exit(conv["pid"], 15):
        sys.exit(f"`claude stop {conv['jobId']}` did not stop host pid {conv['pid']} "
                 f"(exit {r.returncode}: {(r.stderr or r.stdout).strip()[-400:]}). Nothing else was touched.")


def stop_foreground(s):
    os.kill(s["pid"], signal.SIGTERM)  # an interactive session, or the client parked on a job
    wait_exit(s["pid"], 10)


def cmd_adopt(args):
    cfg = config()

    def find():
        return find_external(args.session)

    s = find() or exited_session(args.session) or sys.exit(
        f"no unmanaged live session or exited session id {args.session!r}; see `claudesec sessions`")
    conv = s.get("bg") or s
    if not s.get("tmux") and conv.get("kind") not in ("bg", "exited"):
        sys.exit(f"{args.session} is not running in tmux; it can't be taken over in place")
    if args.wait and conv.get("kind") != "exited":
        idle_since, deadline = None, time.time() + 12 * 3600
        while True:
            s = find() or sys.exit(f"{args.session} exited before it could be adopted")
            conv = s.get("bg") or s
            if session_status(conv)[0] == "idle":
                idle_since = idle_since or time.time()
                # Idle flickers between turns; only a quiet stretch means it has really stopped.
                if time.time() - idle_since >= 30:
                    break
            else:
                idle_since = None
            if time.time() > deadline:
                sys.exit(f"gave up: {args.session} was not idle for 12h")
            time.sleep(5)
    else:
        status, tasks = session_status(conv)
        if tasks:
            sys.exit(f"{args.session} is at its prompt, but its background tasks are still running "
                     f"({', '.join(tasks)}); adopting restarts it and kills them. Wait for them: run "
                     f"`claudesec adopt {args.session} --wait` in the background")
        if status != "idle":
            sys.exit(f"{args.session} is {status}. Only idle sessions are adopted: ask the user "
                     f"to stop it, or run `claudesec adopt {args.session} --wait` in the background")

    sid, cwd = conv["sessionId"], conv["cwd"]
    # Nothing is stopped until we know the conversation is on disk: a client attached to a
    # background job has its own, never-written sessionId.
    if not transcript(sid):
        sys.exit(f"{args.session}: no transcript for session {sid} under {claude_dir()}/projects; "
                 f"nothing to resume (is it a client attached to a background job?). Nothing was touched.")

    label = s.get("name") or conv.get("jobId") or sid[:8]
    name = worker_name_for(s, conv, args.as_name)
    model = args.model or cfg["worker_model"]
    d = prepare_worker(name, cfg, tr(ADOPT_PROMPT, ADOPT_PROMPT_EN), cwd)
    (d / "exit").unlink(missing_ok=True)
    # No trailing shell: when claude exits the pane dies, and remain-on-exit keeps it (with the
    # error on screen) until resume is confirmed.
    cmd = (worker_command(name, d, cfg, model, "--resume", sid)
           + f"; echo $? > {shlex.quote(str(d / 'exit'))}")

    # Stop every process holding the conversation before another one resumes it. A background
    # job is stopped through Claude Code, so its daemon doesn't respawn the host.
    if conv.get("kind") == "bg":
        stop_bg_job(conv)
    if s.get("tmux"):
        window, pane = re.match(r"^[^:]*:(@\d+)\.(%\d+)$", s["tmux"]).groups()
        tmux("set-option", "-p", "-t", pane, "remain-on-exit", "on", check=False)
        stop_foreground(s)
    else:
        # A background job or an exited session has no pane: open a placeholder window to respawn into.
        target = ["-t", f"={cfg['tmux_session']}:"] if has_session(cfg["tmux_session"]) else []
        window, pane = tmux("new-window", "-d", *target, "-P", "-F", "#{window_id} #{pane_id}",
                            "-n", name, "-c", cwd, "sleep 3600").split()
        tmux("set-option", "-p", "-t", pane, "remain-on-exit", "on", check=False)

    with registry() as reg:
        reg["workers"][name] = {
            "window": window, "dir": cwd, "model": model,
            "task": tr(f"接管的会话 {label}（原任务见其汇报）", f"adopted session {label} (its task: see its report)"),
            "status": "STARTING", "started_at": now(), "last_report_at": None,
            "last_summary": "", "pending_ask": None, "session": None, "archived": None,
            "adopted_from": label,
        }
    tmux("respawn-pane", "-k", "-t", pane, "-c", cwd, cmd)
    tmux("rename-window", "-t", window, name, check=False)
    if has_session(cfg["tmux_session"]):
        tmux("move-window", "-d", "-s", window, "-t", f"={cfg['tmux_session']}:", check=False)

    verdict, screen = confirm_resume(name, pane, d, sid)
    tail = "\n".join(l for l in screen.splitlines() if l.strip())[-1200:]
    if verdict == "ok":
        tmux("set-option", "-p", "-u", "-t", pane, "remain-on-exit", check=False)
        with registry() as reg:
            reg["focus"] = name
        append_log(name, "task", f"adopted {label} (session {sid}, {cwd})")
        shown = ensure_name(name, pane, sid)
        if shown != name:
            sys.exit(f"adopt INCOMPLETE: {label} resumed as worker {name} in window {window} (session {sid}), "
                     f"but other sessions still address it as {shown!r}, so SendMessage(to: {name!r}) "
                     f"won't reach it. Run `/rename {name}` in that window.")
        print(f"adopted {label} as {name} ({model}) in window {window}, session {sid}; "
              f"it will report what it was doing")
        return
    if verdict == "dialog":
        append_log(name, "task", f"adopted {label} (session {sid}, {cwd})")
        print(f"{name} is resuming in {window}, but it is STUCK ON A DIALOG — tell the user to "
              f"switch to window '{name}' and answer it:\n{tail}")
        return
    with registry() as reg:
        reg["workers"].pop(name, None)
    sys.exit(f"adopt FAILED ({verdict}): {name} did not resume session {sid}. Window {window} is "
             f"left as it is (a dead pane keeps claude's output). The conversation is intact: run "
             f"`claude --resume {sid}` in {cwd}.\n{tail}")


# ---------- shelved: registered, but no process running ----------

WAKE_PROMPT = "你刚被 claudesec 秘书从搁置中唤醒：会话历史都在，继续按系统提示里的 worker 规则工作。\n"
WAKE_REPORT = """先用 SendMessage 给秘书发一条汇报：DID 写你之前在做什么、做到了哪里；
TYPE: BLOCKED，ISSUE 写「等秘书给下一步」。发完就停，不要自己开始新的工作。
"""
WAKE_PROMPT_EN = ("The claudesec secretary has just woken you from the shelf: your conversation history is all here; "
                  "carry on by the worker rules in your system prompt.\n")
WAKE_REPORT_EN = """First send the secretary a report with SendMessage: DID, what you were doing before and how far you
got; TYPE: BLOCKED, with ISSUE "waiting for the secretary's next step". Then stop; don't start any new work on your own.
"""


def last_turn(sid):
    """The last user prompt and assistant reply in a transcript, for a record that runs no model."""
    user = reply = ""
    path = transcript(sid)
    for line in open(path) if path else []:
        try:
            e = json.loads(line)
        except ValueError:
            continue
        content = (e.get("message") or {}).get("content")
        if isinstance(content, str):
            text = content
        else:
            text = " ".join(b.get("text", "") for b in content or []
                            if isinstance(b, dict) and b.get("type") == "text")
        text = " ".join(text.split())
        if not text:
            continue
        if e.get("type") == "user" and not e.get("isMeta"):
            user = text
        elif e.get("type") == "assistant":
            reply = text
    return tr("最后：", "last: ") + f"{user[:80]} → {reply[:120]}" if user or reply else ""


def live_holder(sid):
    return next((s for s in claude_sessions() if sid and s.get("sessionId") == sid), None)


def refuse_if_working(name, conv):
    status, tasks = session_status(conv)
    if status == "busy":
        sys.exit(f"{name} is busy; shelving would cut it off mid-task. Wait for it, or pass --force")
    if tasks:
        sys.exit(f"{name} is at its prompt, but its background tasks are still running ({', '.join(tasks)}); "
                 f"shelving would kill them. Wait for them, or pass --force")
    jobs = detached_jobs(conv.get("sessionId"), conv.get("pid"))
    if jobs:
        shown = "\n".join(f"  {pid}  {cmd[:120]}" for pid, cmd in jobs[:5])
        sys.exit(f"{name} is at its prompt, but processes it started with nohup / setsid are still running:\n"
                 f"{shown}\nThey are its work too (a sweep, a download): shelving may stop them, and a woken "
                 f"{name} would not know of them. Wait for them, or pass --force")


def detached_jobs(sid, claude_pid):
    """Processes a session left running on their own (nohup, setsid, `&` in a shell that has
    exited): Claude Code puts CLAUDE_CODE_SESSION_ID in every tool shell's environment, and that
    survives detaching, while the process is no longer under the session's own process tree.
    Linux only (/proc); elsewhere, none found. [(pid, command)]"""
    proc = Path("/proc")
    if not sid or not proc.is_dir():
        return []
    mark = f"CLAUDE_CODE_SESSION_ID={sid}".encode()
    parents, found = {}, []
    for d in proc.iterdir():
        if not d.name.isdigit():
            continue
        with contextlib.suppress(OSError, ValueError, IndexError):
            stat = (d / "stat").read_text()
            parents[int(d.name)] = int(stat.rsplit(")", 1)[1].split()[1])
            if mark in (d / "environ").read_bytes().split(b"\0"):
                found.append(int(d.name))
    me = os.getpid()

    def under(pid, root):
        seen = set()
        while pid and pid not in seen:
            if pid == root:
                return True
            seen.add(pid)
            pid = parents.get(pid)
        return False
    out = []
    for pid in found:
        if pid == me or (claude_pid and under(pid, claude_pid)) or under(me, pid):
            continue  # still the session's own tree (its tools, hooks), or this very command's caller
        with contextlib.suppress(OSError):
            cmd = (proc / str(pid) / "cmdline").read_bytes().replace(b"\0", b" ").decode(errors="replace").strip()
            out.append((pid, cmd))
    # a detached shell and its sleep are one job: show the outermost
    return [(p, c) for p, c in out if parents.get(p) not in {q for q, _ in out}]


def cmd_shelve(args):
    workers = read_registry()[1]
    if args.name in workers:
        name, w = args.name, workers[args.name]
        if w["status"] == "SHELVED":
            sys.exit(f"{name} is already shelved")
        sid, cwd, label = w.get("session"), w["dir"], name
        if not conversation_exists(w):
            sys.exit(f"{name}: no conversation recorded for it, so it could not be woken later. Not shelved.")
        if is_cursor(w) and worker_busy(name, w) and not args.force:
            sys.exit(f"{name} is busy; shelving would cut it off mid-task. Wait for it, or pass --force")
        holder = None if is_cursor(w) else live_holder(sid)
        if holder and not args.force:
            refuse_if_working(name, holder)
        if holder:
            stop_foreground(holder)
        if w.get("window"):
            tmux("kill-window", "-t", w["window"], check=False)
        entry = dict(w)
    else:
        s = find_external(args.name) or exited_session(args.name) or sys.exit(
            f"no worker, unmanaged live session or exited session id {args.name!r}; see `claudesec status`")
        conv = s.get("bg") or s
        if not args.force:
            refuse_if_working(args.name, conv)
        sid, cwd = conv["sessionId"], conv["cwd"]
        if not transcript(sid):
            sys.exit(f"{args.name}: no transcript for session {sid}; nothing could be woken later. Nothing was touched.")
        label = s.get("name") or conv.get("jobId") or sid[:8]
        name = worker_name_for(s, conv, args.as_name)
        if conv.get("kind") == "bg":
            stop_bg_job(conv)
        if s.get("kind") == "interactive":
            stop_foreground(s)
        entry = {"dir": cwd, "model": config()["worker_model"], "task": tr(f"搁置的会话 {label}", f"shelved session {label}"),
                 "started_at": now(), "archived": None, "adopted_from": label}
    summary = args.note or last_turn(sid) or tr("（无记录）", "(no record)")
    with registry() as reg:
        reg["workers"][name] = {**entry, "status": "SHELVED", "window": None, "session": sid,
                                "status_before": entry.get("status"),
                                "shelved_by": getattr(args, "by", "user"),
                                "dir": cwd, "shelved_at": now(), "note": args.note or "",
                                "shelf_summary": summary, "pending_ask": None,
                                "last_summary": entry.get("last_summary") or summary,
                                "last_report_at": entry.get("last_report_at") or now()}
        if reg["focus"] == name:
            reg["focus"] = None
    (worker_dir(name) / "waiting-permission").unlink(missing_ok=True)
    append_log(name, "shelved", f"session {sid}, {cwd}\n{summary}")
    print(f"shelved {label} as {name}: nothing is running for it now. Session {sid} in {cwd}. "
          f"`claudesec wake {name}` resumes it.")


def cmd_wake(args):
    cfg = config()
    name = args.name
    w = read_registry()[1].get(name) or sys.exit(f"no worker {name}")
    if w["status"] != "SHELVED":
        sys.exit(f"{name} is not shelved (status {w['status']})")
    sid, cwd = w["session"], w["dir"]
    cursor = is_cursor(w)
    if not conversation_exists(w):
        sys.exit(f"{name}: conversation {sid} is gone; it can't be resumed")
    left = w.get("moved_from")  # set by redir: the directory it was in before the move
    if getattr(args, "dir", None):
        new = str(Path(args.dir).expanduser().resolve())
        if not Path(new).is_dir():
            sys.exit(f"--dir {new}: no such directory")
        moved = f"{cwd} → {new} (--dir)" if new != cwd else None
        left, cwd = (cwd if moved else left), new
    else:
        new, moved = where_now(cwd)
        if not new:
            sys.exit(f"{name}: its directory {cwd} is gone, so wake has nowhere to resume it. If it moved "
                     f"(a renamed repo): `claudesec redir {shlex.quote(cwd)} NEW_DIR` points every worker "
                     f"recorded there at the new place; `claudesec wake {name} --dir NEW_DIR` moves just this one.")
        left, cwd = (cwd if new != cwd else left), new
    holder = None if cursor else live_holder(sid)
    if cursor:
        require_cursor(f"wake {name}")
        if not getattr(args, "quiet", False):  # a quiet wake only reopens the conversation; no turn runs
            cursor_room(f"wake {name}", but=name, prefix="NOT DELEGATED: " if getattr(args, "intro", None) and
                        w.get("delegated_by") else "")
        check_cursor_http1()
    if holder:
        sys.exit(f"{name}: session {sid} is already running as pid {holder['pid']} ({holder.get('name')}); "
                 f"someone resumed it outside claudesec")
    quiet = getattr(args, "quiet", False)
    if not quiet:  # a quiet wake (the secretary's restart) runs no turn: nothing to spend
        refuse_while_frozen(f"wake {name}")
    instruction = getattr(args, "instruction", None)
    if instruction is None:
        instruction = "" if quiet or sys.stdin.isatty() else sys.stdin.read().strip()
    intro = getattr(args, "intro", None) or tr("秘书转来用户的新指令（原话），照做并按规则汇报：",
                                               "The secretary passes on the user's new instruction, in their own words. "
                                               "Do it and report by the rules:")
    initial = tr(WAKE_PROMPT, WAKE_PROMPT_EN) + (f"\n{intro}\n\n{instruction}\n" if instruction else
                                                 "\n" + tr(WAKE_REPORT, WAKE_REPORT_EN))
    model = args.model or w.get("model") or cfg["cursor_worker_model" if cursor else "worker_model"]
    model = model if cursor else unpaid(model)
    followed = follow_conversation(w, cwd, old=left)
    if moved or followed or left:
        with registry() as reg:
            reg["workers"][name]["dir"] = cwd
            reg["workers"][name].pop("moved_from", None)
        append_log(name, "task", "; ".join(filter(None, [moved, followed])) or f"now in {cwd}")
    d = prepare_worker(name, cfg, initial, cwd, fresh_log=False, agent=w.get("agent", "claude"),
                       memory=w.get("memory"))
    (d / "exit").unlink(missing_ok=True)
    # Quiet: just reopen the conversation; no first prompt, so no model turn and no report.
    cmd = ((cursor_command(name, model, "--resume", sid, d=None if quiet else d) if cursor else
            worker_command(name, d, cfg, model, "--resume", sid, prompt=not quiet))
           + f"; echo $? > {shlex.quote(str(d / 'exit'))}")
    target = ["-t", f"={cfg['tmux_session']}:"] if has_session(cfg["tmux_session"]) else []
    window, pane = tmux("new-window", "-d", *target, "-P", "-F", "#{window_id} #{pane_id}",
                        "-n", name, "-c", cwd, "sleep 3600").split()
    tmux("set-option", "-p", "-t", pane, "remain-on-exit", "on", check=False)
    with registry() as reg:  # a resumed Cursor chat reports no session id; it keeps its own
        reg["workers"][name].update(window=window, model=model, status="STARTING", session=sid if cursor else None)
    tmux("respawn-pane", "-k", "-t", pane, "-c", cwd, cmd)
    if instruction:
        append_log(name, f"{w.get('delegated_by') or 'secretary'}→worker", instruction)

    verdict, screen = confirm_cursor_start(pane, d) if cursor else confirm_resume(name, pane, d, sid)
    tail = "\n".join(l for l in screen.splitlines() if l.strip())[-1200:]
    if verdict == "ok":
        tmux("set-option", "-p", "-u", "-t", pane, "remain-on-exit", check=False)
        with registry() as reg:
            w = reg["workers"][name]
            if quiet:
                w["status"] = w.get("status_before") or "PROGRESS"
            elif not w.get("delegated_by"):  # a delegated one is its delegator's business
                reg["focus"] = name
            w.pop("shelved_by", None)
        append_log(name, "task", f"woken{' quietly' if quiet else ''} (session {sid}, {cwd})")
        shown = name if cursor else ensure_name(name, pane, sid)
        if shown != name:
            sys.exit(f"wake INCOMPLETE: {name} resumed in window {window}, but other sessions address it as "
                     f"{shown!r}, so SendMessage(to: {name!r}) won't reach it. Run `/rename {name}` in that window.")
        print(f"woke {name} ({model}) in window {window}; "
              + ("idle, history loaded" if quiet else
                 "it will report on the new instruction" if instruction else "it will report what it was doing")
              + (f". Directory: {moved}" if moved else ""))
        return
    if verdict == "dialog":
        print(f"{name} is resuming in {window}, but it is STUCK ON A DIALOG — tell the user to "
              f"switch to window '{name}' and answer it:\n{tail}")
        return
    with registry() as reg:
        reg["workers"][name].update(status="SHELVED", window=None, session=sid)
    sys.exit(f"wake FAILED ({verdict}): {name} stays shelved. Window {window} is left as it is. "
             f"The conversation is intact: `{'agent' if cursor else 'claude'} --resume {sid}` in {cwd}.\n{tail}")


def cmd_redir(args):
    """A directory moved (a repo renamed): point every worker recorded in it, or below it, at the
    new place, and remember the move for what is recorded elsewhere (archived Cursor delegations).
    Conversations follow at the next wake, once nothing is writing to them."""
    old = os.path.normpath(os.path.abspath(os.path.expanduser(args.old)))
    new = str(Path(args.new).expanduser().resolve())
    if not Path(new).is_dir():
        sys.exit(f"{new}: no such directory")
    if Path(old).exists():
        sys.exit(f"{old} is still there; redir is for a directory that moved away. "
                 f"To move one worker: `claudesec wake NAME --dir {shlex.quote(new)}`")
    if new == old or new.startswith(old + "/"):
        sys.exit(f"{new} is inside {old}")
    moved = []
    with registry() as reg:
        for name, w in reg["workers"].items():
            d = w.get("dir") or ""
            if d == old or d.startswith(old + "/"):
                w["moved_from"] = w.get("moved_from") or d
                w["dir"] = new + d[len(old):]
                moved.append(f"{name} ({w['status']}): {w['dir']}")
        reg.setdefault("moved", {})[old] = new
    print(f"{old} → {new}: " + ("\n  " + "\n  ".join(moved) if moved else "no worker was recorded there")
          + "\nRemembered for archived delegations too. `claudesec wake NAME` resumes a shelved one there.")


def confirm_resume(name, pane, d, sid):
    """Adopted only once the worker's SessionStart hook reports the very session we resumed.
    The screen is not grepped for errors: a resumed conversation renders its old messages."""
    screen, dialog = "", 0
    for _ in range(60):
        time.sleep(1)
        screen = pane_text(pane, suggestion="drop")
        got = read_registry()[1].get(name, {}).get("session")
        if got == sid:
            return "ok", screen
        if got:
            return f"resumed as a different session {got}", screen
        if (d / "exit").exists() or tmux("display", "-p", "-t", pane, "#{pane_dead}", check=False).strip() != "0":
            return "claude exited", screen
        if answer_credit_dialog(name, pane, screen):
            continue
        # A dialog blocks before SessionStart; only one that stays up counts.
        dialog = dialog + 1 if re.search(r"trust this folder|Do you trust|Enter to confirm", screen) else 0
        if dialog >= 5:
            return "dialog", screen
    return "no SessionStart within 60s", screen


def ensure_name(name, pane, sid):
    """Peers address a session by the name in its sessions/<pid>.json. On resume a name stored in
    the transcript (a background job's auto name) beats `-n`, so rename it in the session itself
    and wait until Claude Code reports the new name. Returns the name it ends up with."""
    shown = None
    for attempt in range(2):
        tmux("send-keys", "-t", pane, "-l", f"/rename {name}")
        time.sleep(1)  # Enter apart from the text, as when typed by hand
        tmux("send-keys", "-t", pane, "Enter")
        for _ in range(10):
            time.sleep(1)
            s = next((s for s in claude_sessions() if s.get("sessionId") == sid), {})
            shown = s.get("name")
            if shown == name:
                return name
    return shown


def cmd_status(args):
    focus, workers = read_registry()
    active = {n: w for n, w in workers.items() if w["status"] != "SHELVED"}
    shelved = {n: w for n, w in workers.items() if w["status"] == "SHELVED"}
    if active:
        print_workers(focus, active)
    else:
        print(tr("没有 worker。", "No workers."))
    if shelved:
        print(tr("\n搁置（没有进程在跑；claudesec wake 唤醒）：", "\nShelved (no process running; claudesec wake brings one back):"))
        rows = [tr(("名字", "目录", "搁置于", "token", "备注 / 最后一轮"), ("name", "dir", "shelved", "tokens", "note / last turn"))]
        usage = worker_usage(shelved)
        for n, w in shelved.items():
            rows.append((n, Path(w["dir"]).name, (w.get("shelved_at") or "")[:16].replace("T", " "), usage_word(usage[n]),
                         (w.get("shelf_summary") or w.get("last_summary") or "").replace("\n", " ")[:60]))
        print_rows(rows)
    spend = spend_today_line()
    if spend:
        print("\n" + spend)
    print_reminders()
    items = open_notices()
    if items:
        print(tr("\n待办事项（要用户去做的事；claudesec notice done 编号）：", "\nTo do (for the user; claudesec notice done N):"))
        for n, t, text in items:
            print(f"  #{n} " + (f"[{t}] " if t else "") + text)
    load = ""
    if cursor_available()[0] and cursor_limit():
        load = tr(f" · 在跑 {len(cursor_busy())}/{cursor_limit()}", f" · at work {len(cursor_busy())}/{cursor_limit()}")
    print(tr("\nCursor worker：", "\nCursor workers: ") + cursor_available()[1] + load)
    sessions = external_sessions()
    if sessions:
        print(tr("\n不归 claudesec 管的 Claude 会话（空闲的可以 claudesec adopt 接管）：",
                 "\nClaude sessions claudesec doesn't manage (an idle one can be taken over with claudesec adopt):"))
        print_rows(session_rows(sessions))


def print_workers(focus, workers):
    alive = alive_windows()
    rows = [("", "worker", *tr(("模型", "状态", "距今", "token", "$今天", "最近", "等你？"),
                               ("model", "status", "ago", "tokens", "$ today", "latest", "you?")))]
    usage = worker_usage(workers)
    moneys = worker_moneys(workers)
    for name, w in workers.items():
        status = w["status"]
        if status in LABELS:
            status = tr(LABELS[status], tr(*STATUS_LOOK[status][2]))
        elif w.get("mode") == "discuss" and status not in ("DONE", "FAILED"):
            status = tr("讨论中", "discussing")
        if w.get("window") not in alive and status not in ("DONE", "FAILED"):
            status += tr("(窗口已关)", " (window closed)")
        age = ""
        if w.get("last_report_at"):
            secs = (dt.datetime.now().astimezone() - dt.datetime.fromisoformat(w["last_report_at"])).total_seconds()
            age = f"{int(secs // 60)}m" if secs < 3600 else f"{secs / 3600:.1f}h"
        summary = (w.get("pending_ask") if w["status"] in LABELS else
                   w.get("last_summary") or w["task"]).replace("\n", " ")
        if w.get("delegated_by"):
            summary = tr(f"[为 {w['delegated_by']}] ", f"[for {w['delegated_by']}] ") + summary
        rows.append(("*" if name == focus else "", name, w["model"].replace("claude-", ""),
                     status, age, usage_word(usage[name]), moneys[name],
                     summary[:48], tr("← 是", "← yes") if w["status"] in WAITING else ""))
    print_rows(rows)


def cmd_log(args):
    for header, body in read_log(args.name)[-args.n:]:
        print(f"=== {header}\n{body}\n")


def cmd_interrupt(args):
    _, workers = read_registry()
    w = workers.get(args.name) or sys.exit(f"no worker {args.name}")
    if not w.get("window"):
        sys.exit(f"{args.name} has no window (status {w['status']})")
    key = "C-c" if is_cursor(w) else "Escape"  # Cursor's Escape only drops a queued message
    if is_cursor(w):  # its stop hook then sees status "error", same as a failed turn
        (worker_dir(args.name) / "interrupted").write_text(now())
    tmux("send-keys", "-t", w["window"], key)
    print(f"sent {key} to {args.name}")


def cmd_peek(args):
    """The last lines of a worker's window, and whether its Claude is busy: look before you close."""
    w = read_registry()[1].get(args.name) or sys.exit(f"no worker {args.name}")
    if w.get("window") not in alive_windows():
        sys.exit(f"{args.name} has no window (status {w['status']})")
    if is_cursor(w):
        state = ("busy" if worker_busy(args.name, w) else "idle") if cursor_running(w) else "no live agent"
    else:
        holder = live_holder(w.get("session"))
        state = status_label(holder) if holder else "no live claude"
    print(f"{args.name}: {state}")
    lines = [l for l in pane_text(w["window"]).splitlines() if l.strip()]
    print("\n".join(lines[-args.n:]))


def cmd_close(args):
    with registry() as reg:
        w = reg["workers"].pop(args.name, None) or sys.exit(f"no worker {args.name}")
        if reg["focus"] == args.name:
            reg["focus"] = None
    if w.get("window"):
        tmux("kill-window", "-t", w["window"], check=False)
    note = "" if w.get("archived") else tr("（注意：未归档）", " (note: not archived)")
    print(f"closed {args.name}{note}")


# ---------- history ----------

def index_add(rel, line):
    index = HOME / "history" / "INDEX.md"
    lines = index.read_text().splitlines() if index.exists() else [tr("# claudesec 历史索引", "# claudesec history index"), ""]
    lines = [l for l in lines if f"→ {rel}" not in l] + [f"{line} → {rel}"]
    index.write_text("\n".join(lines) + "\n")


def history_file(date, name, previous):
    if previous:
        return HOME / "history" / previous
    d = HOME / "history" / date[:7]
    d.mkdir(parents=True, exist_ok=True)
    path, n = d / f"{date}-{name}.md", 2
    while path.exists():
        path, n = d / f"{date}-{name}-{n}.md", n + 1
    return path


def frontmatter(**kv):
    out = ["---"]
    for k, v in kv.items():
        out.append(f"{k}: {json.dumps(v, ensure_ascii=False)}")
    return "\n".join(out + ["---", ""])


def cmd_archive(args):
    tags = [t for t in (args.tags or "").split(",") if t]
    files = [f for f in (args.files or "").split(",") if f]
    date = dt.date.today().isoformat()
    if args.subagent:
        body = sys.stdin.read().strip()
        path = history_file(date, args.name, None)
        project = str(Path(args.dir).expanduser().resolve()) if args.dir else ""
        path.write_text(frontmatter(date=date, project=project, worker="subagent", session=None,
                                    status="DONE", files=files, tags=tags) +
                        tr(f"## 任务\n{args.task or ''}\n\n## 结果\n{args.summary or ''}\n\n## 过程\n{body}\n",
                           f"## Task\n{args.task or ''}\n\n## Result\n{args.summary or ''}\n\n## Process\n{body}\n"))
        status = "DONE"
    else:
        _, workers = read_registry()
        w = workers.get(args.name) or sys.exit(f"no worker {args.name}")
        entries = read_log(args.name)
        final = {}
        for header, body in entries:
            if header.endswith("worker→secretary"):
                r = parse_report(body)
                if r.get("TYPE") in ("DONE", "FAILED"):
                    final = r
        user_decisions = [f"- {h.split()[0]} {b.strip()}" for h, b in entries
                          if h.endswith("secretary→worker") and is_user_decision(b)]
        path = history_file(date, args.name, w.get("archived"))
        status = final.get("TYPE", w["status"])
        trace = "\n".join(f"=== {h}\n{b}" for h, b in entries)
        path.write_text(
            frontmatter(date=w["started_at"][:10], project=w["dir"], worker=args.name, model=w["model"],
                        session=w.get("session"), status=status, files=files, tags=tags,
                        **({"delegated_by": w["delegated_by"]} if w.get("delegated_by") else {})) +
            tr(f"## 任务\n{w['task']}\n\n"
               f"## 用户决策\n{chr(10).join(user_decisions) or '无'}\n\n"
               f"## 结果\n{final.get('RESULT') or args.summary or '（worker 未给出 RESULT）'}\n\n"
               f"## worker 决策\n{final.get('DECISIONS') or '（worker 未给出）'}\n\n"
               + (f"## 待办\n{final['TODO']}\n\n" if final.get("TODO") else "") +
               f"## 过程\n```\n{trace}\n```\n"
               f"\n完整 transcript：`claude --resume {w.get('session')}`\n",
               f"## Task\n{w['task']}\n\n"
               f"## User decisions\n{chr(10).join(user_decisions) or 'none'}\n\n"
               f"## Result\n{final.get('RESULT') or args.summary or '(the worker gave no RESULT)'}\n\n"
               f"## Worker decisions\n{final.get('DECISIONS') or '(the worker gave none)'}\n\n"
               + (f"## To do\n{final['TODO']}\n\n" if final.get("TODO") else "") +
               f"## Process\n```\n{trace}\n```\n"
               f"\nFull transcript: `claude --resume {w.get('session')}`\n"))
        with registry() as reg:
            reg["workers"][args.name]["archived"] = str(path.relative_to(HOME / "history"))
    rel = str(path.relative_to(HOME / "history"))
    project = Path(args.dir or (read_registry()[1].get(args.name, {}).get("dir", ""))).name
    index_add(rel, f"- {date} · {project} · {args.name} · {status} · {args.summary or ''} · "
                   + " ".join(f"#{t}" for t in tags))
    print(f"archived → {path}")


LESSONS = "# 秘书的教训（用户说「复盘」时交给 claudesec worker 归类，处理过的移到「已处理」）\n\n"
LESSONS_EN = "# The secretary's lessons (sorted by a claudesec worker at the daily review; reviewed ones move to Done)\n\n"


# ---------- budgets: a spending window for everyone, and an optional one per worker ----------
# budget.json: the window (start, until, an optional USD cap) and, once it has run out, who was
# stopped. Spend is what every session claudesec runs cost since the start, at list prices
# (usage_by_owner). Each tool call of a Claude Code worker passes the PreToolUse check below: past
# 85% of the time or the money it is told to wrap up, once; at 100% the window is frozen and
# every tool call is refused but the report. Cursor workers aren't covered. While frozen,
# spawn / wake / delegate refuse. Unfrozen by `budget --add`, a later `--until`, `--off`, or a
# window booked with --from starting; then each stopped worker is told to carry on.
BUDGET_SOFT = 0.15   # wrap up with this share of the time or the money left


def read_budget():
    try:
        return json.loads((HOME / "budget.json").read_text())
    except (OSError, ValueError):
        return None


def write_budget(b):
    path = HOME / "budget.json"
    if b is None:
        path.unlink(missing_ok=True)
        return
    tmp = path.with_name(f".budget.{os.getpid()}.tmp")
    tmp.write_text(json.dumps(b, indent=2, ensure_ascii=False) + "\n")
    os.replace(tmp, path)


def window_spent(b):
    start = dt.datetime.fromisoformat(b["start"])
    total = 0.0
    for per in usage_by_owner(since=start).values():
        for key, v in per.items():
            usd = cost_of(v, *key.split("|"))
            total += usd or 0
    return total


def budget_state(b, now=None):
    """(state, why, spent) for the window: "off" before its start (or none), "ok", "soft", "over"."""
    now = now or dt.datetime.now().astimezone()
    if not b:
        return "off", "", 0.0
    start, until = dt.datetime.fromisoformat(b["start"]), dt.datetime.fromisoformat(b["until"])
    if now < start:
        return ("over" if b.get("frozen") else "off"), tr("等预约的窗口开始", "waiting for the booked window"), 0.0
    spent = window_spent(b)
    if b.get("frozen"):
        return "over", b.get("frozen_why", ""), spent
    if now >= until:
        return "over", tr(f"预算窗口 {until:%H:%M} 到了", f"the budget window ended at {until:%H:%M}"), spent
    if b.get("usd") and spent >= b["usd"]:
        return "over", tr(f"预算 {money(b['usd'])} 花完了（已花 {money(spent)}）",
                          f"the {money(b['usd'])} budget is spent ({money(spent)})"), spent
    left_time = (until - now).total_seconds() / max(1.0, (until - start).total_seconds())
    left_money = 1 - spent / b["usd"] if b.get("usd") else 1.0
    if min(left_time, left_money) <= BUDGET_SOFT:
        why = tr(f"预算窗口 {until:%H:%M} 结束", f"the budget window ends at {until:%H:%M}") \
            if left_time <= left_money else \
            tr(f"预算剩 {money(b['usd'] - spent)}（共 {money(b['usd'])}）", f"{money(b['usd'] - spent)} of {money(b['usd'])} left")
        return "soft", why, spent
    return "ok", "", spent


def worker_budget_state(name, w):
    """The same for a worker's own budget (spawn --budget): "ok", "soft" at 85%, "over" at 100%."""
    cap = w.get("budget_usd")
    if not cap:
        return "ok", "", 0.0
    spent = worker_cost({name: w}).get(name) or 0.0
    if spent >= cap:
        return "over", tr(f"你的额度 {money(cap)} 用完了（已花 {money(spent)}）",
                          f"your {money(cap)} budget is used up ({money(spent)})"), spent
    if spent >= cap * (1 - BUDGET_SOFT):
        return "soft", tr(f"你的额度 {money(cap)} 已用到 {money(spent)}", f"you have used {money(spent)} of {money(cap)}"), spent
    return "ok", "", spent


def hook_worker_budget(name):
    """PreToolUse for a Claude Code worker while a budget is set: tell it to wrap up, or refuse."""
    data = hook_input()
    w = read_registry()[1].get(name)
    if w is None:
        return
    b = read_budget()
    states = [budget_state(b), worker_budget_state(name, w)]
    over = next(((why, kind) for (st, why, _), kind in zip(states, ("window", "worker")) if st == "over"), None)
    if over:
        why, kind = over
        if kind == "window" and b and not b.get("frozen") and dt.datetime.now().astimezone() >= \
                dt.datetime.fromisoformat(b["start"]):
            b.update(frozen=True, frozen_why=why, frozen_at=now())
            write_budget(b)
            if secretary_alive():
                raise_alert(tr(f"[预算] {why}：已冻结，worker 的工具调用都会被拒，秘书不要再派活。"
                               f"要继续：claudesec budget --add <美元> 或 --until <时间>（要用户定）。",
                               f"[budget] {why}: frozen; workers' tool calls are refused, don't hand out work. "
                               f"To go on: claudesec budget --add <USD> or --until <time> (the user decides)."))
        mark = worker_dir(name) / ("frozen-window" if kind == "window" else "frozen-own")
        first = not mark.exists()
        mark.write_text(why)
        if data.get("tool_name") in ("SendMessage", "ToolSearch"):
            return  # the report is how it says it stopped (ToolSearch: loading SendMessage, where it's deferred)
        reason = tr(f"{why}。这次调用没有执行，别的工具也都会被拒；只剩汇报可以做：现在用 SendMessage "
                    f"（还没加载的话先用 ToolSearch 加载它）给秘书发一条 BLOCKED："
                    f"ISSUE 写{'预算到点' if kind == 'window' else '额度用完'}、做到了哪、还差什么、改了哪些没提交的文件，"
                    f"{'问用户要不要追加额度，' if kind == 'worker' else ''}然后结束本轮。",
                    f"{why}. This call did not run, and every other tool will be refused; only the report is left. "
                    f"Send the secretary a BLOCKED report with SendMessage now (load it with ToolSearch first if it "
                    f"isn't loaded): ISSUE says the {'budget ran out' if kind == 'window' else 'budget is used up'}, "
                    f"how far you got, what's left, any uncommitted changes"
                    f"{', and asks whether the user adds to it' if kind == 'worker' else ''}; then end your turn.")
        if first:
            append_log(name, "budget", f"stopped: {why}")
        print(json.dumps({"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny",
                                                 "permissionDecisionReason": reason}}, ensure_ascii=False))
        return
    soft = [(why, kind) for (st, why, _), kind in zip(states, ("window", "worker")) if st == "soft"]
    for why, kind in soft:
        mark = worker_dir(name) / f"warned-{kind}"
        tag = (b or {}).get("start", "") if kind == "window" else str(w.get("budget_usd"))
        if mark.exists() and mark.read_text() == tag:
            continue  # once per window / budget
        mark.write_text(tag)
        text = tr(f"[claudesec 预算] {why}。现在开始收尾：把手上的改动提交，整理已有结论，给秘书发汇报"
                  f"（{'DONE，或者 BLOCKED 说明还差什么' if kind == 'window' else 'DONE 交差；做不完就 BLOCKED，问用户要不要追加额度'}）。"
                  f"预计做不完的不要再开新的大块工作。",
                  f"[claudesec budget] {why}. Wrap up now: commit what you changed, sum up what you have and report to "
                  f"the secretary ({'DONE, or BLOCKED saying what is left' if kind == 'window' else 'DONE; if it cannot be finished, BLOCKED asking whether the user adds to the budget'}). "
                  f"Don't start large new pieces of work you can't finish.")
        append_log(name, "budget", f"told to wrap up: {why}")
        print(json.dumps({"hookSpecificOutput": {"hookEventName": "PreToolUse", "additionalContext": text}},
                         ensure_ascii=False))
        return


def refuse_while_frozen(what):
    """spawn / wake / delegate: no new work while the window is frozen."""
    st, why, _ = budget_state(read_budget())
    if st == "over":
        sys.exit(tr(f"{what}：预算已冻结（{why}），不派新活。要继续：claudesec budget --add <美元> 或 --until <时间>，由用户决定。",
                    f"{what}: the budget is frozen ({why}); no new work. To go on: claudesec budget --add <USD> or "
                    f"--until <time>, the user's call."))


def resume_frozen(why):
    """The window is open again: each worker it stopped is told to carry on (pasted into its
    window; the secretary hears of it too)."""
    workers = read_registry()[1]
    stopped = [n for n in workers if (worker_dir(n) / "frozen-window").exists()]
    alive = alive_windows()
    text = tr(f"[claudesec] 预算已恢复（{why}）。接着做你被冻结前的活，按规则汇报。",
              f"[claudesec] The budget is open again ({why}). Carry on with the work you were stopped in, and report as usual.")
    told = []
    for n in stopped:
        (worker_dir(n) / "frozen-window").unlink(missing_ok=True)
        (worker_dir(n) / "warned-window").unlink(missing_ok=True)
        w = workers[n]
        if w.get("window") in alive:
            with contextlib.suppress(Exception):
                send_text(n, w, text, by="claudesec")
                told.append(n)
    if secretary_alive():
        raise_alert(tr(f"[预算] 已恢复（{why}）。" + (f"已通知被冻结的 worker 继续：{'、'.join(told)}。" if told else "没有被冻结的 worker。"),
                       f"[budget] open again ({why}). " + (f"Told the stopped workers to carry on: {', '.join(told)}." if told else "No worker had been stopped.")))
    return told


def set_worker_budget_marker(name, usd):
    """The file the PreToolUse guard tests for: present only while the worker has a budget."""
    path = worker_dir(name) / "budget_usd"
    if usd:
        path.write_text(f"{usd}\n")
    else:
        path.unlink(missing_ok=True)


def worker_budget_change(args):
    """budget --worker NAME --usd N | --add N | --off: the user set, raised or dropped a worker's
    budget (only on the user's word). A worker stopped by it is told to carry on."""
    name = args.worker
    with registry() as reg:
        w = reg["workers"].get(name) or sys.exit(f"no worker {name}")
        if is_cursor(w):
            sys.exit(f"{name} is a Cursor worker; claudesec can't see what it spends, so it can't have a budget")
        if args.off:
            w.pop("budget_usd", None)
        elif args.add:
            w["budget_usd"] = (w.get("budget_usd") or 0) + args.add
        elif args.usd:
            w["budget_usd"] = args.usd
        else:
            sys.exit("budget --worker NAME needs --usd N, --add N or --off")
        cap = w.get("budget_usd")
        w = dict(w)
    set_worker_budget_marker(name, cap)
    spent = worker_cost({name: w}).get(name) or 0.0
    print(tr(f"{name}：" + (f"额度 {money(cap)}，已花 {money(spent)}" if cap else "不再设额度"),
             f"{name}: " + (f"budget {money(cap)}, spent {money(spent)}" if cap else "no budget any more")))
    stopped = worker_dir(name) / "frozen-own"
    if stopped.exists() and (not cap or spent < cap):
        stopped.unlink(missing_ok=True)
        (worker_dir(name) / "warned-worker").unlink(missing_ok=True)
        if w.get("window") in alive_windows():
            with contextlib.suppress(Exception):
                send_text(name, w, tr(f"[claudesec] 用户把你的额度调到了 {money(cap) if cap else '不限'}。接着做被停下前的活，按规则汇报。",
                                      f"[claudesec] The user set your budget to {money(cap) if cap else 'none'}. Carry on with "
                                      f"what you were stopped in, and report as usual."), by="claudesec")
                print(tr(f"已通知 {name} 继续。", f"Told {name} to carry on."))


def cmd_budget(args):
    """Set, extend, book or end the spending window; with no options, show it."""
    if args.worker:
        worker_budget_change(args)
        return
    now_t = dt.datetime.now().astimezone()
    b = read_budget()
    if args.off:
        was = b and b.get("frozen")
        write_budget(None)
        print(tr("预算窗口已关。", "Budget window off."))
        if was:
            resume_frozen(tr("预算窗口已关", "budget window turned off"))
        return
    if not (args.until or args.usd or args.add or args.start):
        if not b:
            print(tr("没有预算窗口。", "No budget window."))
            return
        st, why, spent = budget_state(b)
        print(tr(f"预算窗口：{show_time(b['start'])} – {show_time(b['until'])}"
                 + (f"，上限 {money(b['usd'])}" if b.get("usd") else "") + f"；已花 {money(spent)}；状态 {st}"
                 + (f"（{why}）" if why else ""),
                 f"Budget window: {show_time(b['start'])} – {show_time(b['until'])}"
                 + (f", cap {money(b['usd'])}" if b.get("usd") else "") + f"; spent {money(spent)}; state {st}"
                 + (f" ({why})" if why else "")))
        return
    try:
        until = parse_when(args.until, now_t) if args.until else None
        start = parse_when(args.start, now_t) if args.start else None
    except ValueError as e:
        sys.exit(str(e))
    was_frozen = bool(b and b.get("frozen"))
    if args.add:
        if not b:
            sys.exit(tr("没有预算窗口可以追加；先 claudesec budget --until <时间> [--usd N]。",
                        "No budget window to add to; set one with claudesec budget --until <time> [--usd N]."))
        if not until and dt.datetime.fromisoformat(b["until"]) <= now_t:
            sys.exit(tr(f"窗口已在 {show_time(b['until'])} 到点，追加金额时要同时给新的 --until。",
                        f"The window ended at {show_time(b['until'])}; give a new --until along with --add."))
        b["usd"] = (b.get("usd") or window_spent(b)) + args.add
        if until:
            b["until"] = until.isoformat(timespec="seconds")
    elif start and start > now_t:
        # booked: a window that opens later; a frozen one stays frozen until then
        if not until or until <= start:
            sys.exit(tr("--from 要配一个在它之后的 --until。", "--from needs an --until after it."))
        b = {"start": start.isoformat(timespec="seconds"), "until": until.isoformat(timespec="seconds"),
             "usd": args.usd, "frozen": was_frozen, "frozen_why": (b or {}).get("frozen_why", ""), "set_at": now()}
        write_budget(b)
        with reminders() as data:  # the reminder checker opens it on time
            rid = f"r{data['next_id']}"
            data["next_id"] += 1
            data["items"].append({"id": rid, "due": b["start"], "target": "secretary", "action": "budget-open",
                                  "text": tr("预约的预算窗口开始", "the booked budget window opens"),
                                  "every": None, "status": "pending", "created_at": now()})
        print(tr(f"预约了预算窗口 {show_time(b['start'])} – {show_time(b['until'])}"
                 + (f"，上限 {money(args.usd)}" if args.usd else "") + (f"；在那之前保持冻结（{rid} 到点解除）" if was_frozen else ""),
                 f"Booked a budget window {show_time(b['start'])} – {show_time(b['until'])}"
                 + (f", cap {money(args.usd)}" if args.usd else "") + (f"; frozen until then ({rid} opens it)" if was_frozen else "")))
        return
    else:
        if not until:
            sys.exit(tr("要给 --until（截止时间）。", "Give --until (when the window ends)."))
        if b and not was_frozen and dt.datetime.fromisoformat(b["start"]) <= now_t:
            b.update(until=until.isoformat(timespec="seconds"), usd=args.usd if args.usd else b.get("usd"))
        else:
            b = {"start": now_t.isoformat(timespec="seconds"), "until": until.isoformat(timespec="seconds"),
                 "usd": args.usd, "frozen": False, "set_at": now()}
    b["frozen"] = False
    b.pop("frozen_why", None)
    write_budget(b)
    st, why, spent = budget_state(b)
    print(tr(f"预算窗口：到 {show_time(b['until'])}" + (f"，上限 {money(b['usd'])}" if b.get("usd") else "")
             + f"；已花 {money(spent)}", f"Budget window: until {show_time(b['until'])}"
             + (f", cap {money(b['usd'])}" if b.get("usd") else "") + f"; spent {money(spent)}"))
    if was_frozen:
        resume_frozen(tr("用户追加了预算", "the user extended the budget"))


def cmd_lesson(args):
    path = HOME / "lessons.md"
    text = path.read_text() if path.exists() else tr(LESSONS, LESSONS_EN)
    entry = f"- {dt.date.today().isoformat()} · {args.type} · {args.situation} · " + tr(f"「{args.correction}」\n",
                                                                                     f"\"{args.correction}\"\n")
    pending, mark, done = text.partition(done_heading(text))  # new ones go above the reviewed ones
    path.write_text(pending.rstrip("\n") + "\n" + entry + (mark and "\n" + mark.lstrip("\n") + done))
    print("noted")


# ---------- reminders: things to do at a given time ----------
# reminders.json under HOME, so they outlive the secretary's context, a restart and a reboot. A
# checker started by `claudesec run` fires them; one that came due while no secretary was
# running fires late, saying how late, when the next one starts. A due reminder always goes to
# the secretary, never straight to a worker: the user's call, routing is the secretary's job.

REMINDER_CHECK_SECS = 15
REMINDERS_KEPT = 30  # fired or cancelled ones kept for `remind --list --all`


@contextlib.contextmanager
def reminders():
    """Locked read-modify-write of reminders.json, like registry()."""
    HOME.mkdir(parents=True, exist_ok=True)
    with open(HOME / "reminders.lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        path = HOME / "reminders.json"
        data = json.loads(path.read_text()) if path.exists() else {}
        data.setdefault("next_id", 1)
        data.setdefault("items", [])
        yield data
        done = [r for r in data["items"] if r["status"] != "pending"]
        drop = {id(r) for r in done[:-REMINDERS_KEPT]} if len(done) > REMINDERS_KEPT else set()
        data["items"] = [r for r in data["items"] if id(r) not in drop]
        tmp = path.with_suffix(".tmp")
        tmp.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n")
        tmp.replace(path)


def read_reminders():
    path = HOME / "reminders.json"
    return json.loads(path.read_text()).get("items", []) if path.exists() else []


def by_due(r):
    """Sort key: the moment a reminder is due, then its number. Not the due string: those carry
    whatever offset they were written with (+00:00 from a Z time, +08:00 from a local one), and
    as strings 05:00+00:00 sorts after 02:50+08:00 the next day."""
    n = r["id"][1:]
    return dt.datetime.fromisoformat(r["due"]), int(n) if n.isdigit() else 0, r["id"]


def parse_when(when, at=None):
    """+30m / +2h / +1d / +90s; HH:MM (the next one); MM-DD HH:MM; YYYY-MM-DD HH:MM; full ISO.
    A trailing Z means UTC, otherwise local time. Returns an aware datetime."""
    at = at or dt.datetime.now().astimezone()
    w = when.strip()
    m = re.fullmatch(r"\+(\d+)([smhd])", w)
    if m:
        unit = {"s": "seconds", "m": "minutes", "h": "hours", "d": "days"}[m.group(2)]
        return at + dt.timedelta(**{unit: int(m.group(1))})
    tz = dt.timezone.utc if w.endswith(("Z", "z")) else at.tzinfo
    w = w.rstrip("Zz")
    m = re.fullmatch(r"(\d{1,2}):(\d{2})", w)
    if m:
        base = at.astimezone(tz)
        t = base.replace(hour=int(m.group(1)), minute=int(m.group(2)), second=0, microsecond=0)
        return t if t > base else t + dt.timedelta(days=1)
    m = re.fullmatch(r"(?:(\d{4})-)?(\d{1,2})-(\d{1,2})[ T](\d{1,2}):(\d{2})", w)
    if m:
        year = int(m.group(1)) if m.group(1) else at.astimezone(tz).year
        return dt.datetime(year, int(m.group(2)), int(m.group(3)), int(m.group(4)), int(m.group(5)), tzinfo=tz)
    try:
        t = dt.datetime.fromisoformat(when.strip().replace("Z", "+00:00"))
    except ValueError:
        raise ValueError(f"can't read {when!r} as a time: use +30m, 09:05Z, 17:05, '10-21 09:05Z' or ISO 8601")
    return t if t.tzinfo else t.replace(tzinfo=at.tzinfo)


def parse_every(every):
    """1d / 12h / 30m: the period of a repeating reminder, in seconds."""
    m = re.fullmatch(r"(\d+)([mhd])", every.strip())
    if not m or int(m.group(1)) == 0:
        raise ValueError(f"can't read {every!r} as a period: use 30m, 12h, 1d, 7d")
    return int(m.group(1)) * {"m": 60, "h": 3600, "d": 86400}[m.group(2)]


def show_every(secs):
    for unit, n in (("d", 86400), ("h", 3600), ("m", 60)):
        if secs % n == 0:
            return tr(f"每 {secs // n}{unit}", f"every {secs // n}{unit}")
    return tr(f"每 {secs}s", f"every {secs}s")


def show_time(iso):
    t = dt.datetime.fromisoformat(iso)
    return f"{t.astimezone():%m-%d %H:%M}" + paren(f"{t.astimezone(dt.timezone.utc):%H:%MZ}").rstrip()


def parse_moment(when, at=None):
    """A moment for a cost period, which lies in the past: like parse_when, but HH:MM is today's
    (not the next one), YYYY-MM-DD is that day's start, and 2h / 3d (or -2h) count back from now."""
    at = at or dt.datetime.now().astimezone()
    w = when.strip()
    m = re.fullmatch(r"-?(\d+)([mhd])", w)
    if m:
        return at - dt.timedelta(**{{"m": "minutes", "h": "hours", "d": "days"}[m[2]]: int(m[1])})
    if re.fullmatch(r"\d{4}-\d{2}-\d{2}", w):
        return dt.datetime.fromisoformat(w).replace(tzinfo=at.tzinfo)
    t = parse_when(w, at)
    if re.fullmatch(r"\d{1,2}:\d{2}[Zz]?", w) and t > at:
        t -= dt.timedelta(days=1)  # the HH:MM that has been, today
    return t


def cmd_cost(args):
    """What claudesec's sessions cost, by worker and model: every session it ran (the secretary,
    shelved and closed workers, subagents with theirs), in the period asked for. Computed from the
    transcripts and the price table; nothing is asked of a model."""
    now = dt.datetime.now().astimezone()
    try:
        since = now.replace(hour=0, minute=0, second=0, microsecond=0) if args.today else \
            parse_moment(args.since, now) if args.since else None
        until = parse_moment(args.until, now) if args.until else None
    except ValueError as e:
        sys.exit(str(e))
    usage = usage_by_owner(since, until)
    if args.name:
        usage = {k: v for k, v in usage.items() if k == args.name}
    span = (tr("今天", "today") if args.today else
            f"{since:%m-%d %H:%M} – {until:%m-%d %H:%M}" if since and until else
            tr(f"{since:%m-%d %H:%M} 起", f"since {since:%m-%d %H:%M}") if since else
            tr(f"截至 {until:%m-%d %H:%M}", f"until {until:%m-%d %H:%M}") if until else tr("全部", "all time"))
    if not usage:
        print(tr(f"{span}：没有花费记录。", f"{span}: nothing spent."))
        return
    head = tr(("worker", "模型", "输入", "缓存写5m", "缓存写1h", "缓存读", "输出", "USD"),
              ("worker", "model", "input", "write 5m", "write 1h", "read", "output", "USD"))
    rows, grand, unpriced = [head], 0.0, set()
    per_owner = []
    for owner, per in usage.items():
        total = sum(c for c in (cost_of(v, *k.split("|")) for k, v in per.items()) if c is not None)
        per_owner.append((total, owner, per))
    for total, owner, per in sorted(per_owner, key=lambda x: -x[0]):
        for i, (key, v) in enumerate(sorted(per.items(), key=lambda kv: -sum(kv[1]))):
            model, speed = key.split("|")
            usd = cost_of(v, model, speed)
            if usd is None:
                unpriced.add(model)
            rows.append((owner if i == 0 else "", short_model(model) + (" fast" if speed == "fast" else ""),
                         *map(short_count, v), tr("未计价", "unpriced") if usd is None else money(usd)))
        if len(per) > 1:
            rows.append(("", tr("小计", "subtotal"), "", "", "", "", "", money(total)))
        grand += total
    rows.append((tr("合计", "total"), "", "", "", "", "", "", money(grand)))
    print(tr(f"花费（{span}，按官方单价折算，不含未计价的模型）：", f"Spend ({span}, at list prices, unpriced models left out):"))
    print_rows(rows)
    if unpriced:
        print(tr("未计价（单价表里没有，不算进合计；可在 config.json 的 prices 里补）：",
                 "Unpriced (not in the price table, left out of the total; add them under prices in config.json): ")
              + ", ".join(sorted(unpriced)))


def cmd_remind(args):
    if args.cancel:
        with reminders() as data:
            r = next((r for r in data["items"] if r["id"] == args.cancel and r["status"] == "pending"), None)
            if r is None:
                sys.exit(f"no pending reminder {args.cancel}; see `claudesec remind --list`")
            r.update(status="cancelled", done_at=now())
        print(f"cancelled {r['id']}: {r['text']}")
        return
    if args.list or not args.words:
        items = read_reminders() if args.all else [r for r in read_reminders() if r["status"] == "pending"]
        if not items:
            print(tr("没有定时任务。", "Nothing scheduled.") if args.all else tr("没有未到点的定时任务。", "Nothing scheduled ahead."))
            return
        rows = [("id", *tr(("时间", "重复", "给", "状态", "内容"), ("when", "repeat", "for", "status", "text")))]
        for r in sorted(items, key=by_due):
            rows.append((r["id"], show_time(r["due"]), show_every(r["every"]) if r.get("every") else "",
                         r["target"], tr({"pending": "未到点", "fired": "已发", "cancelled": "已取消"},
                                        {"pending": "pending", "fired": "fired", "cancelled": "cancelled"})[r["status"]],
                         r["text"][:60]))
        print_rows(rows)
        return
    if len(args.words) < 3:
        sys.exit("usage: claudesec remind WHEN TARGET TEXT...   (TARGET: a worker name, or `secretary`)")
    when, target, text = args.words[0], args.words[1], " ".join(args.words[2:]).strip()
    try:
        due = parse_when(when)
        every = parse_every(args.every) if args.every else None
    except ValueError as e:
        sys.exit(str(e))
    if due < dt.datetime.now().astimezone() - dt.timedelta(seconds=30):
        sys.exit(f"{when!r} is {show_time(due.isoformat())}, already past")
    workers = read_registry()[1]
    with reminders() as data:
        rid = f"r{data['next_id']}"
        data["next_id"] += 1
        data["items"].append({"id": rid, "due": due.isoformat(timespec="seconds"), "target": target, "text": text,
                              "every": every, "status": "pending", "created_at": now()})
    note = "" if target in workers or target == "secretary" else tr(f"（注意：{target} 现在不是 worker）",
                                                                     f" (note: {target} is not a worker now)")
    repeat = tr(f"起，{show_every(every)}", f" on, {show_every(every)}") if every else ""
    print(tr(f"{rid}: {show_time(due.isoformat())}{repeat} 叫醒秘书，给 {target}：{text}{note}",
             f"{rid}: {show_time(due.isoformat())}{repeat} wakes the secretary, for {target}: {text}{note}"))


def deliver_reminder(r):
    """Wake the secretary with a due reminder, through the alert channel. A booked budget window
    (budget --from) opens this way instead."""
    if r.get("action") == "budget-open":
        b = read_budget()
        if b and b.get("frozen"):
            b.update(frozen=False)
            b.pop("frozen_why", None)
            write_budget(b)
            resume_frozen(tr("预约的预算窗口开始", "the booked window opened"))
        return "budget window opened"
    due = dt.datetime.fromisoformat(r["due"])
    late = (dt.datetime.now().astimezone() - due).total_seconds()
    late_note = tr(f"，迟到 {int(late // 60)} 分钟（那时秘书没在跑）", f", {int(late // 60)} minutes late (the "
                   "secretary wasn't running then)") if late > 3 * REMINDER_CHECK_SECS + 60 else ""
    raise_alert(tr(f"[定时任务 {r['id']}] 原定 {show_time(r['due'])}{late_note}，给 {r['target']}：{r['text']}",
                   f"[reminder {r['id']}] due {show_time(r['due'])}{late_note}, for {r['target']}: {r['text']}"))
    if r["target"] in read_registry()[1]:
        append_log(r["target"], "reminder", r["text"])
    return "secretary alerted"


def fire_due_reminders():
    """Each due reminder is marked fired before it is handed on: at most once, even if two
    checkers overlap or delivery dies halfway. A repeating one moves on to its next time
    instead; occurrences missed while no secretary ran fire once, not once each."""
    cutoff = dt.datetime.now().astimezone()
    with reminders() as data:
        due = []
        for r in data["items"]:
            when = dt.datetime.fromisoformat(r["due"])
            if r["status"] != "pending" or when > cutoff:
                continue
            due.append(dict(r))
            if r.get("every"):
                step = dt.timedelta(seconds=r["every"])
                while when + step <= cutoff:
                    when += step
                due[-1]["due"] = when.isoformat(timespec="seconds")  # the latest one missed, for "how late"
                r.update(due=(when + step).isoformat(timespec="seconds"), last_fired=now())
            else:
                r.update(status="fired", done_at=now())
    for r in due:
        try:
            how = deliver_reminder(r)
        except Exception as e:  # keep checking the others; tell the secretary this one went wrong
            how = f"failed: {e}"
            raise_alert(tr(f"[定时任务 {r['id']}] 投递出错（{e}），原文给 {r['target']}：{r['text']}",
                           f"[reminder {r['id']}] couldn't be delivered ({e}); for {r['target']}: {r['text']}"))
        with reminders() as data:
            for x in data["items"]:
                if x["id"] == r["id"]:
                    x["result"] = f"{now()} {how}" if x.get("every") else how
        print(f"{now()} {r['id']} → {r['target']}: {how}", flush=True)


RUNAWAY_CHECK_SECS = 300


def check_runaway(now_t=None):
    """Alert the secretary, once each, about a worker with no budget of its own that spends a lot:
    more than runaway_pool_share of the budget window's cap since the window began, or more than
    runaway_usd since its last report when that was over runaway_quiet_minutes ago. Claude Code
    workers only (a Cursor agent's spend isn't visible). Returns the alerts raised."""
    cfg, now_t = config(), now_t or dt.datetime.now().astimezone()
    workers = {n: w for n, w in read_registry()[1].items()
               if w["status"] != "SHELVED" and not is_cursor(w) and not w.get("budget_usd") and w.get("session")}
    if not workers:
        return []
    path = HOME / "runaway.json"
    try:
        seen = json.loads(path.read_text())
    except (OSError, ValueError):
        seen = {}
    raised = []
    b = read_budget()
    share = float(cfg.get("runaway_pool_share") or 0)
    if b and b.get("usd") and share and not b.get("frozen"):
        start = dt.datetime.fromisoformat(b["start"])
        if start <= now_t:
            for name, usd in worker_cost(workers, since=start).items():
                key = f"pool|{name}|{b['start']}"
                if usd and usd > share * b["usd"] and key not in seen:
                    seen[key] = now()
                    raised.append(tr(f"[预算] {name} 没有自己的额度，但这个预算窗口里已经花了 {money(usd)}，"
                                     f"超过窗口上限 {money(b['usd'])} 的 {share:.0%}。看看它在做什么（peek），要不要让它收尾或给它设额度（问用户）。",
                                     f"[budget] {name} has no budget of its own and has spent {money(usd)} in this window, "
                                     f"over {share:.0%} of its {money(b['usd'])} cap. See what it's doing (peek), and whether "
                                     f"it should wrap up or get a budget (ask the user)."))
    limit, quiet = float(cfg.get("runaway_usd") or 0), float(cfg.get("runaway_quiet_minutes") or 0)
    if limit:
        for name, w in workers.items():
            last = w.get("last_report_at") or w.get("started_at")
            if not last:
                continue
            since = dt.datetime.fromisoformat(last)
            if (now_t - since).total_seconds() < quiet * 60:
                continue
            usd = worker_cost({name: w}, since=since).get(name)
            key = f"quiet|{name}|{last}"
            if usd and usd > limit and key not in seen:
                seen[key] = now()
                mins = int((now_t - since).total_seconds() // 60)
                raised.append(tr(f"[花费] {name} 上次汇报是 {mins} 分钟前，之后已经花了约 {money(usd)}（阈值 {money(limit)}），"
                                 f"而且没有额度。peek 看看是不是卡在循环里，必要时 interrupt。",
                                 f"[spend] {name} last reported {mins} minutes ago and has spent about {money(usd)} since "
                                 f"(threshold {money(limit)}), with no budget. Peek at it for a loop; interrupt if needed."))
    if raised:
        tmp = path.with_name(f".runaway.{os.getpid()}.tmp")
        tmp.write_text(json.dumps(seen))
        os.replace(tmp, path)
        for text in raised:
            raise_alert(text)
    return raised


def check_reminders(run_pid):
    """Runs alongside the secretary, for as long as its `claudesec run` is the current one.
    The lock hands over from an older checker whose secretary is gone. Runaway spending is
    looked at here too, less often."""
    last_runaway = 0.0
    with open(HOME / "reminders-checker.lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        while current_run() == run_pid:
            fire_due_reminders()
            with contextlib.suppress(Exception):  # nor a window that vanished mid-look
                check_stuck()
            if time.monotonic() - last_runaway >= RUNAWAY_CHECK_SECS:
                last_runaway = time.monotonic()
                with contextlib.suppress(Exception):  # a bad transcript line mustn't stop the reminders
                    check_runaway()
            time.sleep(REMINDER_CHECK_SECS)


def print_reminders():
    pending = sorted((r for r in read_reminders() if r["status"] == "pending"), key=by_due)
    if pending:
        print(tr("\n定时任务（未到点；claudesec remind --cancel ID 取消）：",
                 "\nScheduled (not due yet; claudesec remind --cancel ID drops one):"))
        rows = [("id", *tr(("时间", "重复", "给", "内容"), ("when", "repeat", "for", "text")))]
        for r in pending:
            rows.append((r["id"], show_time(r["due"]), show_every(r["every"]) if r.get("every") else "",
                         r["target"], r["text"][:60]))
        print_rows(rows)


# ---------- daily review: tidy the secretary's memory, propose prompt changes ----------

def claude_project(cwd):
    """Where Claude Code keeps transcripts and auto memory of sessions started in cwd."""
    return claude_dir() / "projects" / re.sub(r"[^A-Za-z0-9]", "-", str(cwd))


def secretary_memory_dir():
    """Claude Code keys auto memory by cwd, and the secretary's cwd is HOME. By the resolved cwd:
    with HOME under a linked /home, an unresolved name is a dir nobody writes to."""
    return claude_project(HOME.resolve()) / "memory"


def memory_settings(cwd):
    """Settings so a session started in cwd reads and writes its own auto memory without asking.
    Claude Code asks nothing for that dir, unless its path resolves through a symlink into a
    protected place: with ~/.agentlodge/claude/projects a link to ~/.claude/projects, the
    exemption goes by the path asked for and the protection by where it lands, and allow rules
    don't count for protected paths. So name the resolved dir as the memory dir: the same files,
    no link on the way. Untouched (no setting) where no link is involved or the dir can't be
    worked out the way Claude Code does it: by the git repository's main checkout (worktrees
    and subdirectories share one), else by cwd."""
    root = Path(cwd).resolve()
    with contextlib.suppress(OSError, subprocess.SubprocessError):
        # Relative to root or absolute, either way; --path-format=absolute needs git 2.31; the devbox has 2.30.
        out = subprocess.run(["git", "-C", str(root), "rev-parse", "--git-common-dir"],
                             capture_output=True, text=True, stdin=subprocess.DEVNULL, timeout=10)
        if out.returncode == 0 and out.stdout.strip():
            common = (root / out.stdout.strip()).resolve()
            if common.name != ".git":  # a submodule, a bare repo
                return {}
            root = common.parent
    name = re.sub(r"[^A-Za-z0-9]", "-", str(root))
    if len(name) > 200:  # Claude Code shortens it with a hash of its own
        return {}
    d = claude_dir() / "projects" / name / "memory"
    return {"autoMemoryDirectory": str(d.resolve())} if d.resolve() != d else {}


def cmd_review(args):
    """A fresh worker each day: the review needs none of yesterday's context, and a long-lived
    one would carry every past review along."""
    date = dt.date.today().isoformat()
    brief = (PROMPTS / "review.md").read_text()
    # Resolved: through a symlink every write would ask (see memory_settings). The worker gets it
    # as its own auto memory dir, where Write and Edit don't ask either.
    memory = secretary_memory_dir().resolve()
    for key, value in {"DATE": date, "MEMORY": memory, "LESSONS": HOME / "lessons.md",
                       "REPO": REPO, "QUEUE": HOME / "queue.md", "INDEX": HOME / "history" / "INDEX.md",
                       "REVIEWS": HOME / "reviews"}.items():
        brief = brief.replace("{{" + key + "}}", str(value))
    if args.print:
        print(brief)
        return
    (HOME / "reviews").mkdir(parents=True, exist_ok=True)
    if memory.is_dir():  # the backup the brief points to, made here so the worker needs no Bash for it
        shutil.copytree(memory, HOME / "reviews" / f"{date}-memory-before", dirs_exist_ok=True)
    name = f"review-{date[5:7]}{date[8:]}"
    w = read_registry()[1].get(name)
    if w and w["status"] != "SHELVED" and w.get("window") in alive_windows():
        sys.exit(f"{name} is already running (status {w['status']})")
    if w:
        quietly(cmd_close, name=name)
    cmd_spawn(argparse.Namespace(name=name, dir=str(REPO), model=None, discuss=False, agent="claude",
                                 for_worker=None, task=brief, intro=tr("claudesec 每日例行派给你的任务：\n\n", "claudesec's daily routine task for you:\n\n"),
                                 memory=str(memory)))


# ---------- hooks ----------

def hook_worker_session_start(name):
    data = hook_input()
    with registry() as reg:
        if name in reg["workers"]:
            reg["workers"][name]["session"] = data.get("session_id")


def hook_worker_report(name):
    data = hook_input()
    sec = config()["secretary_name"]
    inp = data.get("tool_input") or {}
    if not str(inp.get("to", "")).startswith(sec):
        return
    record_report(name, str(inp.get("message", "")))


def record_report(name, text):
    """A worker's report: log, registry status and summary, focus, the 'reported' marker."""
    append_log(name, "worker→secretary", text)
    r = parse_report(text)
    typ = r.get("TYPE", "").split()[0] if r.get("TYPE") else "UNTYPED"
    with registry() as reg:
        w = reg["workers"].get(name)
        if w is not None:
            w["status"] = typ
            w["last_report_at"] = now()
            w["last_summary"] = (r.get("DID") or text).splitlines()[0][:200]
            w["pending_ask"] = r.get("ASK") if typ == "NEED_DECISION" else None
        if typ in TERMINAL:
            reg["focus"] = name
        discussion_over = w is not None and w.get("mode") == "discuss" and typ in ("DONE", "FAILED")
    (worker_dir(name) / "waiting-permission").unlink(missing_ok=True)
    if typ in TERMINAL:
        (worker_dir(name) / "reported").write_text(typ)
    after = worker_dir(name) / AFTER_REPORT
    if typ in TERMINAL:
        after.write_text("reported")  # "idle" once that turn ends; see back_at_work
    else:
        after.unlink(missing_ok=True)
    if discussion_over:
        # Bring the user back to the secretary, who summarizes and offers to dispatch the to-dos.
        tmux("select-window", "-t", f"={config()['tmux_session']}:secretary", check=False)


def cmd_report(args):
    """A Cursor worker's report (it has no SendMessage): recorded like a Claude Code worker's,
    then delivered to the secretary through the alert channel, which wakes it; a delegated
    worker's goes to its delegator instead (see cmd_wait)."""
    if args.name not in read_registry()[1]:
        sys.exit(f"no worker {args.name}")
    text = sys.stdin.read().strip() or sys.exit("empty report: pass it on stdin")
    # Cursor's subagents (Task tool) inherit the worker's environment and rules, and send
    # reports of their own. Only the worker's counts: a subagent's DONE ends the delegator's
    # wait and gets the worker archived before it is done. Cursor puts the conversation's id in
    # each shell's environment; a subagent is a conversation of its own, the worker's is the
    # session sessionStart recorded. (Cursor 2026.10 fires no subagentStart / subagentStop.)
    conv, session = os.environ.get("CURSOR_CONVERSATION_ID"), read_registry()[1][args.name].get("session")
    if conv and session and conv != session:
        append_log(args.name, "subagent-report-refused", text)
        sys.exit(f"NOT REPORTED: you are a subagent of {args.name} (conversation {conv}, the worker's is "
                 f"{session}), and only the worker itself reports. Don't report; put your findings in "
                 f"your final answer to the agent that started you.")
    record_report(args.name, text)
    boss = read_registry()[1][args.name].get("delegated_by")
    if boss:
        # Straight back to the delegator, whose `claudesec wait` reads it off the log. The
        # secretary sees the status; it is woken only for what may need it or the user.
        r = parse_report(text)
        typ = r.get("TYPE", "").split()[0] if r.get("TYPE") else "UNTYPED"
        if typ in ("FAILED", "BLOCKED"):
            why = (r.get("ISSUE") or r.get("DID") or text).splitlines()[0][:120]
            receipt(tr(f"{args.name}（为 {boss}）{typ}：{why}", f"{args.name} (for {boss}) {typ}: {why}"))
        if typ == "DONE":
            (worker_dir(args.name) / "finish").write_text(now())  # archived and closed when the turn ends
        print(f"reported to {boss}")
    elif secretary_alive():
        raise_alert(tr(f"{CURSOR_REPORT}「{args.name}」：\n{text}", f"{CURSOR_REPORT_EN} \"{args.name}\":\n{text}"))
        print(f"reported to {config()['secretary_name']}")
    else:
        print("recorded; the secretary is not running and will see it in `claudesec log`")


def send_text(name, w, text, by="secretary"):
    """Paste text into a Cursor worker's window as one message. A pasted message looks to Cursor
    exactly like the user typing in its window, so it says where it comes from: delegated workers
    had been reporting 「用户直接跟我说了：…」 about their delegator's follow-ups."""
    head = (tr("[claudesec] 秘书转来的消息（不是用户在你窗口里打的字）：",
               "[claudesec] A message passed on by the secretary (not the user typing in your window):")
            if by == "secretary" else
            tr("[claudesec] claudesec 发来的系统消息（不是用户在你窗口里打的字）：",
               "[claudesec] A notice from claudesec itself (not the user typing in your window):")
            if by == "claudesec" else
            tr(f"[claudesec] 委托你的 worker {by} 发来的消息（不是用户在你窗口里打的字）：",
               f"[claudesec] A message from {by}, the worker that delegated to you (not the user typing in your window):"))
    subprocess.run(["tmux", "load-buffer", "-b", "claudesec-send", "-"], input=f"{head}\n{text}", text=True, check=True)
    tmux("paste-buffer", "-p", "-d", "-b", "claudesec-send", "-t", w["window"])
    time.sleep(0.5)  # Enter apart from the paste, as when typed by hand
    tmux("send-keys", "-t", w["window"], "Enter")
    append_log(name, f"{by}→worker", text)


def cmd_model(args):
    """Switch a worker to another model: shelve it and wake it on the new one, the conversation
    kept. The one way for a Cursor worker, whose agent takes the model only on its command line;
    works for a Claude Code worker too. A busy worker is left alone (--force cuts it off)."""
    w = read_registry()[1].get(args.name) or sys.exit(f"no worker {args.name}")
    if w["status"] != "SHELVED":
        err = quietly(cmd_shelve, name=args.name, note=f"switching to {args.model}", as_name=None, force=args.force)
        if err:
            sys.exit(f"model: {err}")
    with registry() as reg:
        reg["workers"][args.name]["shelved_by"] = "model"
    err = quietly(cmd_wake, name=args.name, model=args.model, quiet=True)
    if err:
        sys.exit(f"model: {args.name} is shelved now, but waking it on {args.model} failed: {err}. "
                 f"`claudesec wake {args.name} --model <model>` tries again.")
    print(f"{args.name} now runs {args.model} (conversation kept; it waits for your next message)")


def cmd_send(args):
    """Secretary → Cursor worker: pasted into its window as one message. Sent while it works,
    the message waits in Cursor's queue and runs when the turn ends."""
    w = read_registry()[1].get(args.name) or sys.exit(f"no worker {args.name}")
    if not is_cursor(w):
        sys.exit(f"{args.name} is a Claude Code worker: use SendMessage(to: {args.name!r})")
    if not cursor_running(w):
        sys.exit(f"{args.name} has no running agent (status {w['status']}); `claudesec wake {args.name}` it first")
    text = sys.stdin.read().strip() or sys.exit("empty message: pass it on stdin")
    if re.match(r"/model\b", text):  # pasted as text, it is a message to the model, not a command
        sys.exit(f"NOT SENT: a pasted /model doesn't switch a Cursor worker's model. Run "
                 f"`claudesec model {args.name} <model>`: it restarts the agent on the new model, conversation kept.")
    send_text(args.name, w, text)
    mark_answered(args.name, text)
    with registry() as reg:
        reg["focus"] = args.name
    print(f"sent to {args.name}" + (" (it is busy: queued until its turn ends)" if worker_busy(args.name, w) else ""))


# ---------- delegation: a worker hands a small job to a Cursor worker ----------
# All by script, so neither the task nor the result passes through the secretary's context:
# `claudesec delegate` spawns (or messages) the Cursor worker on the spot, the Cursor worker's
# reports land in its log, and the delegator's `claudesec wait` reads them from there. The
# secretary sees it all in `claudesec status` and is woken only for what may need it: FAILED,
# BLOCKED, a dialog, a guard overridden. A task that looks like it goes beyond a small job is
# refused back to the delegator, who either does it itself or says why it's fine (--ack).

DELEGATE_GUARD = [
    (("push / merge",) * 2, r"\bgit\s+push\b|\bpush\b|\bmerge\b|合入|合并到|\bMR\b|\bPR\b"),
    (("部署 / 发版", "deploy / release"), r"部署|发版|上线|发布|\bdeploy|\brelease\b|\brollout\b|回滚|\brollback\b"),
    (("凭据", "credentials"), r"凭据|凭证|密码|私钥|\bcredential|\bpassword|\bsecret|\btoken|\bAK\b|\bSK\b|access[ _-]?key"
           r"|\.ssh\b|\.pem\b|\bcookie"),
    (("对外发消息", "messages to others"), r"发消息|发送消息|发到群|群里|通知.{0,6}(用户|群|人)|邮件|\bemail|\bslack|\bwebhook|\blark-cli\s+im"
                   r"|send[ _-]?message"),
    (("删除 / 改线上数据", "deleting / changing live data"), r"\brm\s+-rf\b|\bdrop\s+table\b|\bdelete\s+from\b|\btruncate\b|删库|删表"),
]


def delegate_guard(task):
    """The categories a task's words hit; a hit is refused back to the delegator."""
    return [tr(*what) for what, pat in DELEGATE_GUARD if re.search(pat, task, re.IGNORECASE)]


def receipt(line):
    """One line waking the secretary, about delegated work that may need it."""
    if secretary_alive():
        raise_alert(tr(f"[委托回执] {line}", f"[delegation receipt] {line}"))


def archived_delegation(name):
    """The newest archive of a delegated Cursor worker called name, or None: its frontmatter
    (project, session, model, delegated_by) plus path. Older archives didn't record who
    delegated it; their index line starts the summary with 为 <worker>：."""
    found = []
    for path in (HOME / "history").glob("*/*.md"):
        with contextlib.suppress(OSError, ValueError):
            text = path.read_text()
            if not text.startswith("---\n"):
                continue
            meta = {}
            for line in text.split("\n---\n", 1)[0].splitlines()[1:]:
                key, _, value = line.partition(": ")
                meta[key] = json.loads(value)
            if meta.get("worker") == name and "delegated" in (meta.get("tags") or []):
                found.append((path.stat().st_mtime, path, meta))
    if not found:
        return None
    _, path, meta = max(found, key=lambda f: f[0])
    if not meta.get("delegated_by"):
        index = HOME / "history" / "INDEX.md"
        rel = str(path.relative_to(HOME / "history"))
        line = next((l for l in (index.read_text().splitlines() if index.exists() else []) if rel in l), "")
        m = re.search(rf"· {re.escape(name)} · \w+ · (?:为 ([a-z0-9-]+)：|for ([a-z0-9-]+): )", line)
        meta["delegated_by"] = (m[1] or m[2]) if m else None
    return {**meta, "path": path}


def cmd_delegate(args):
    if getattr(args, "budget", None) is not None:
        sys.exit("NOT DELEGATED: --budget is for Claude Code workers; a delegated worker is a Cursor agent, whose "
                 "spending claudesec can't see. Delegate without it, or do the work with a budgeted spawn.")
    refuse_while_frozen(f"NOT DELEGATED: delegate {args.name}")
    workers = read_registry()[1]
    boss = args.boss
    if boss not in workers:
        sys.exit(f"no worker {boss}: the first argument is your own worker name")
    ok, why = cursor_available()
    if not ok:
        sys.exit(f"NOT DELEGATED: Cursor workers are not available here — {why}. Do it yourself, "
                 f"or with a subagent if it runs alongside your work.")
    task = sys.stdin.read().strip() or sys.exit("empty task: pass the task brief on stdin")
    name = args.name
    if not NAME_RE.match(name):
        sys.exit(f"bad name {name!r}: lowercase letters, digits, dashes")
    cursor_room(f"delegating {name}", but=name, prefix="NOT DELEGATED: ")
    hits = delegate_guard(task)
    if hits and not args.ack:
        append_log(boss, "delegate-refused", f"{name}: hits {', '.join(hits)}\n{task}")
        sys.exit(f"NOT DELEGATED: the task mentions {' / '.join(hits)}. Cursor workers only get small jobs "
                 f"with none of that. If the task really does that, do it yourself (or report to the "
                 f"secretary). If the words are innocent (e.g. counting tokens, reading a deploy log), "
                 f"run again with --ack \"<why it's fine>\".")
    ack = tr(f"（越界检查命中 {' / '.join(hits)}，{boss} 确认：{args.ack}）",
             f" (the scope check hit {' / '.join(hits)}; {boss} says: {args.ack})") if hits else ""
    # What `wait` reads from: log entries from here on, and turn ends after this moment. A fresh
    # spawn starts a fresh log; a message to a running one counts from its current length.
    since, start = time.time(), 0
    w = workers.get(name)
    if w:
        if w.get("delegated_by") != boss or not is_cursor(w):
            sys.exit(f"{name} is taken and isn't a Cursor worker you delegated to; pick another --name")
        if not cursor_running(w):
            sys.exit(f"{name} has no running agent any more (status {w['status']}); delegate under a new --name")
        if ack:
            append_log(name, "ack", ack)
        (worker_dir(name) / "finish").unlink(missing_ok=True)
        start = len(read_log(name))
        send_text(name, w, task, by=boss)
        verb = "sent to"
    elif (past := archived_delegation(name)):
        # Done, archived and closed: its window is gone and so is its registry entry, but the
        # Cursor chat and its directory may still be there. Resumed with the new task, it keeps
        # what it knew; a fresh spawn under the same name would start blind in the wrong place.
        by = past.get("delegated_by")
        if by and by != boss:
            sys.exit(f"NOT DELEGATED: {name} was {by}'s delegation (archived {past['path']}); pick another --name")
        project, _ = where_now(past["project"])
        if not (past.get("session") and cursor_chat_exists(past["session"]) and project):
            sys.exit(f"NOT DELEGATED: {name} already finished and was closed, and its chat or its directory "
                     f"({past['project']}) is gone, so it can't pick this up. Delegate under a new --name with "
                     f"--dir {past['project']}, and put in the task what it needs from the first round "
                     f"(its archive: {past['path']}).")
        with registry() as reg:
            reg["workers"][name] = {
                "window": None, "dir": project, "model": past.get("model"), "task": task,
                "agent": "cursor", "delegated_by": boss, "mode": "task", "status": "SHELVED",
                "shelved_by": "archived", "session": past["session"], "started_at": now(),
                "last_report_at": now(), "last_summary": "", "pending_ask": None,
                "archived": str(past["path"].relative_to(HOME / "history")),
                **({"moved_from": past["project"]} if project != past["project"] else {}),
            }
        if ack:
            append_log(name, "ack", ack)
        (worker_dir(name) / "finish").unlink(missing_ok=True)
        start = len(read_log(name))
        out = io.StringIO()
        with contextlib.redirect_stdout(out):
            err = quietly(cmd_wake, name=name, model=args.model, quiet=False, instruction=task,
                          intro=tr(f"worker {boss} 追加给你的任务（它写的原文），接着上一轮做，照做并按规则汇报：",
                                   f"More work from worker {boss} (as it wrote it); carry on from your last turn, "
                                   "do it and report by the rules:"))
        if err:
            with registry() as reg:
                reg["workers"].pop(name, None)
            sys.exit(f"NOT DELEGATED: {name} had finished and been closed; resuming its chat failed: {err}\n"
                     f"{out.getvalue()}Delegate under a new --name with --dir {past['project']} instead.")
        print(out.getvalue().rstrip())
        verb = "resumed (it had finished and been closed; same chat, same directory)"
    else:
        project = str(Path(args.dir or workers[boss]["dir"]).expanduser().resolve())
        if not Path(project).is_dir():
            sys.exit(f"--dir {project}: no such directory")
        out = io.StringIO()
        with contextlib.redirect_stdout(out):
            err = quietly(cmd_spawn, name=name, dir=project, model=args.model, discuss=False, agent="cursor",
                          for_worker=boss, task=task)
        if err:
            sys.exit(f"NOT DELEGATED: spawning {name} failed: {err}\n{out.getvalue()}")
        if ack:
            append_log(name, "ack", ack)
        if "STUCK ON A DIALOG" in out.getvalue():
            receipt(tr(f"{boss} 委托 {name} 时 Cursor 卡在对话框上，要用户切到窗口 {name} 处理",
                       f"{boss} delegated {name}, and Cursor is stuck on a dialog: the user has to handle it in window {name}"))
        print(out.getvalue().rstrip())
        verb = "spawned"
    (worker_dir(name) / "delegation.json").write_text(json.dumps({"by": boss, "since": since, "log_start": start}))
    append_log(boss, "delegated", f"{name}{ack}\n{task}")
    if ack:
        receipt(tr(f"{boss} 委托了 {name}：{task.splitlines()[0][:80]}{ack}", f"{boss} delegated {name}: {task.splitlines()[0][:80]}{ack}"))
    print(f"{verb} Cursor worker {name}. To get its result, run in a background Bash:\n"
          f"  {hook_cmd()} wait {name}\n"
          f"It prints the report when {name} sends DONE / FAILED / BLOCKED / NEED_DECISION, or why it stopped.")


def cmd_wait(args):
    """Block until a delegated Cursor worker sends a final report after its latest task, and
    print it. Also returns (exit 1) when it can't come: the turn errored or ended without a
    report (marked by its stop hook), or the agent is gone. For the delegator's background Bash."""
    name, d = args.name, HOME / "workers" / args.name
    try:
        mark = json.loads((d / "delegation.json").read_text())
        since, start = mark["since"], mark["log_start"]
    except (OSError, ValueError, KeyError):
        sys.exit(f"{name} has no delegation to wait for")

    def after(f):
        return f.exists() and f.stat().st_mtime > since

    deadline = time.time() + args.timeout
    while True:
        for header, body in read_log(name)[start:]:
            if header.endswith(" worker→secretary"):
                typ = (parse_report(body).get("TYPE") or "").split()[:1]
                if typ and typ[0] in TERMINAL:
                    print(tr(f"Cursor worker {name} 的汇报（你委托的，{header[11:16]}）：\n{body}",
                             f"Report from Cursor worker {name} (delegated by you, {header[11:16]}):\n{body}"))
                    return
        w = read_registry()[1].get(name)
        if w is None:
            sys.exit(f"{name} was closed without a final report; `claudesec log {name}` has what it said")
        if after(d / "ended-error"):
            sys.exit(f"{name}: its turn ended with an error. Tell it to carry on: "
                     f"`claudesec delegate <you> --name {name}` with a short note, then wait again")
        if after(d / "ended-unreported"):
            sys.exit(f"{name} stopped without a final report; `claudesec peek {name}` to see where it is")
        if not cursor_running(w):
            sys.exit(f"{name}: its agent is no longer running (status {w['status']})")
        if time.time() > deadline:
            sys.exit(f"gave up after {args.timeout}s: {name} is still going; wait again, or peek")
        time.sleep(3)


def finish_later(name):
    """A delegated worker that reported DONE is archived and closed once its turn is over, from
    outside: this runs in its own stop hook, inside the window that gets killed."""
    subprocess.Popen([str(SELF), "hook", "cursor-finish", name], env={**os.environ, "CLAUDESEC_HOME": str(HOME)},
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)


CURSOR_FALLBACK_MODEL = "gpt-5.6-sol-high"
AGENT_START = "[claudesec] Cursor agent, model "


def cursor_error_text(window):
    """The error a Cursor agent printed at the end of a failed turn ("Error: Model Blocked"): its
    stop hook says only "error". The screen may lag the hook by a moment."""
    if not window:
        return ""
    for _ in range(3):
        lines = [l.strip() for l in pane_text(window, suggestion="drop").splitlines() if l.strip()]
        hits = [l for l in lines[-40:] if re.search(r"\b(Error|error|ERROR)\b|Blocked|blocked", l)]
        if hits:
            return " ".join(hits[-1].split())[:200]
        time.sleep(1)
    return ""


def hook_cursor_launch(name):
    """What a spawned Cursor worker's window runs: its agent, in the foreground. Cursor now and
    then answers a model variant string with "Cannot use this model" and exits, though the same
    string works a minute later (devbox, 2026-10-22). Refused, the model is tried once more; refused
    again, CURSOR_FALLBACK_MODEL stands in for it, which the worker's summary and log say. Any
    other failure is left to hook_cursor_exit."""
    model = os.environ.get("CLAUDESEC_MODEL") or config()["cursor_worker_model"]
    first = (worker_dir(name) / "initial.md").read_text()
    pane = os.environ.get("TMUX_PANE", "")
    env = {**os.environ, "CLAUDESEC_WORKER": name, "CLAUDESEC_HOME": str(HOME)}
    env.pop("CLAUDESEC_MODEL", None)
    signal.signal(signal.SIGINT, signal.SIG_IGN)  # Ctrl+C (`claudesec interrupt`) is the agent's

    def run(m):
        print(AGENT_START + m, flush=True)
        return subprocess.run(["agent", "--model", m, "--trust", first], env=env,
                              preexec_fn=lambda: signal.signal(signal.SIGINT, signal.SIG_DFL)).returncode

    def refused():  # only what the last run printed
        screen = pane_text(pane, suggestion="drop") if pane else ""
        return "Cannot use this model" in screen.rsplit(AGENT_START, 1)[-1]

    rc = run(model)
    if rc and refused():
        time.sleep(5)
        rc = run(model)
        if rc and refused() and model != CURSOR_FALLBACK_MODEL:
            note = tr(f"模型兜底：{model} 被拒两次，改用 {CURSOR_FALLBACK_MODEL}",
                      f"model fallback: {model} refused twice, using {CURSOR_FALLBACK_MODEL}")
            with registry() as reg:
                w = reg["workers"].get(name)
                if w is not None:
                    w.update(model=CURSOR_FALLBACK_MODEL, last_summary=note)
            append_log(name, "model-fallback", note)
            rc = run(CURSOR_FALLBACK_MODEL)
    os.environ["CLAUDESEC_RC"] = str(rc)
    hook_cursor_exit(name)


def hook_cursor_exit(name):
    """After a spawned Cursor worker's agent exits for good. A clean exit (the user quit it) is
    left alone; any other is a failure nobody would otherwise hear of."""
    rc = os.environ.get("CLAUDESEC_RC", "")
    if rc in ("0", ""):
        return
    screen = pane_text(os.environ.get("TMUX_PANE", ""), suggestion="drop") if os.environ.get("TMUX_PANE") else ""
    lines = [l.strip() for l in screen.splitlines() if l.strip()]
    why = next((l for l in lines if "Cannot use this model" in l), None)
    why = (why.split(". Available models")[0] if why else (lines[-1] if lines else f"exit {rc}"))[:200]
    with registry() as reg:
        w = reg["workers"].get(name)
        if w is None:
            return
        w.update(status="FAILED", last_report_at=now(), pending_ask=None,
                 last_summary=tr(f"Cursor agent 退出（rc {rc}）：{why}", f"Cursor agent exited (rc {rc}): {why}")[:200])
        boss = w.get("delegated_by")
    append_log(name, "agent-exit", f"rc {rc}\n" + "\n".join(lines[-15:]))
    if boss:
        receipt(tr(f"{name}（为 {boss}）的 Cursor agent 退出了（rc {rc}）：{why}",
                   f"{name}'s (for {boss}) Cursor agent exited (rc {rc}): {why}"))
    elif secretary_alive():
        raise_alert(tr(f"Cursor worker {name} 的 agent 退出了（rc {rc}）：{why}。`claudesec close {name}` 后换个模型重开。",
                       f"Cursor worker {name}'s agent exited (rc {rc}): {why}. `claudesec close {name}` and start it "
                       "again with another model."))


def hook_cursor_finish(name):
    time.sleep(2)
    w = read_registry()[1].get(name)
    if not w or not (worker_dir(name) / "finish").exists():
        return  # given more work in the meantime, or already gone
    did = next((parse_report(b).get("DID", "") for h, b in reversed(read_log(name))
                if h.endswith("worker→secretary")), "")
    quietly(cmd_archive, name=name, summary=tr(f"为 {w.get('delegated_by')}：", f"for {w.get('delegated_by')}: ")
            + (did.splitlines()[0][:100] if did else ""),
            tags="delegated,cursor", files=None, subagent=False, task=None, dir=None)
    quietly(cmd_close, name=name)


def cursor_worker():
    """The worker a Cursor hook runs for. The hooks are global; the shell guard in
    hooks.json already skips sessions without CLAUDESEC_WORKER."""
    name = os.environ.get("CLAUDESEC_WORKER", "")
    return name if name in read_registry()[1] else None


def hook_cursor_session_start():
    """A new chat: record its id, and hand Cursor the worker rules as context (it has no
    --append-system-prompt). A resumed chat fires no sessionStart; it keeps the rules it got."""
    data = hook_input()
    name = cursor_worker()
    if not name:
        return
    with registry() as reg:
        reg["workers"][name]["session"] = data.get("session_id") or data.get("conversation_id")
    print(json.dumps({"additional_context": (worker_dir(name) / "prompt.md").read_text()}, ensure_ascii=False))


def hook_cursor_prompt():
    hook_input()
    name = cursor_worker()
    if name:
        (worker_dir(name) / "busy").write_text(now())
        back_at_work(name, new_turn=True)  # a prompt after a final report: an answer or new work


def hook_cursor_stop():
    """Cursor's Stop: a follow-up message asks for the report, as Claude Code's block does."""
    data = hook_input()
    name = cursor_worker()
    if not name:
        return
    d = worker_dir(name)
    (d / "last-stop.json").write_text(json.dumps(data, indent=2, ensure_ascii=False))
    w = read_registry()[1][name]

    def idle():
        (d / "busy").unlink(missing_ok=True)

    # `claudesec interrupt` stopped it on purpose. One Ctrl+C can end in more than one stop,
    # so the mark holds for a while; and one that lands while a shell command runs can leave
    # the turn going on to complete, which then is an ordinary end.
    interrupted = d / "interrupted"
    if interrupted.exists():
        if data.get("status") != "completed" and time.time() - interrupted.stat().st_mtime < 30:
            idle()
            (d / "ended-unreported").write_text(now())
            return
        interrupted.unlink(missing_ok=True)
    if data.get("status") == "error" and (d / "reported").exists():
        # It had sent its final report when the turn errored (in its closing words, say): the work
        # is delivered, so this is an ordinary end, and a delegated worker's DONE is wrapped up.
        (d / "reported").unlink(missing_ok=True)
        idle()
        append_log(name, "api-error", "Cursor: turn ended with status error after its final report; taken as the end")
        if (d / "finish").exists():
            finish_later(name)
        return
    if data.get("status") == "error":
        idle()
        (d / "ended-error").write_text(now())
        said = cursor_error_text(w.get("window"))
        why = f"Cursor ({data.get('model') or '?'}): {said or 'turn ended with status error'}"
        with registry() as reg:
            w = reg["workers"][name]
            if w["status"] not in ("API_ERROR", "WAITING_PERMISSION"):
                w["status_before"] = w["status"]
            w.update(status="API_ERROR", pending_ask=why, last_report_at=now())
        append_log(name, "api-error", why)
        blocked = re.search(r"(?i)model.{0,20}(blocked|not available|cannot use)|(blocked|cannot use).{0,20}model", said or "")
        if not w.get("delegated_by") and w.get("mode") != "discuss":  # a delegator's wait reports it
            raise_alert(tr(f"Cursor worker {name} 这一轮以错误结束，停在提示符上，不会自己汇报：{why}。"
                           + (f"是模型用不了：`claudesec model {name} <模型>` 换一个（会重开 agent，对话保留）。"
                              if blocked else f"用 `claudesec send {name}` 让它从中断处继续。"),
                           f"Cursor worker {name}'s turn ended in an error; it sits at its prompt and won't report "
                           f"on its own: {why}. "
                           + (f"The model can't be used: switch with `claudesec model {name} <model>` (restarts the "
                              "agent, keeps the conversation)." if blocked else
                              f"Tell it to carry on from where it stopped with `claudesec send {name}`.")))
        return
    if w["status"] == "API_ERROR":
        with registry() as reg:
            w = reg["workers"][name]
            w["status"] = w.pop("status_before", None) or "PROGRESS"
            w["pending_ask"] = None
    marker = d / "reported"
    nobody = not w.get("delegated_by") and not secretary_alive()
    if data.get("status") != "completed" or w.get("mode") == "discuss" or nobody or marker.exists():
        if not marker.exists():
            (d / "ended-unreported").write_text(now())
        marker.unlink(missing_ok=True)  # aborted by the user, a discussion turn, nobody to tell, or reported
        idle()
        if (d / "finish").exists() and data.get("status") == "completed":
            finish_later(name)
        return
    if data.get("loop_count", 0) >= CURSOR_NAGS:
        idle()
        (d / "ended-unreported").write_text(now())
        if not w.get("delegated_by"):  # a delegator's wait reports it
            raise_alert(tr(f"Cursor worker {name} 催了 {CURSOR_NAGS} 次仍没汇报就停下了；`claudesec peek {name}` 看看。",
                           f"Cursor worker {name} stopped without reporting after {CURSOR_NAGS} reminders; have a look "
                           f"with `claudesec peek {name}`."))
        return
    print(json.dumps({"followup_message":
        tr(f"结束本轮前必须用 shell 执行 `{SELF} report {name}`（stdin 传入汇报正文）给秘书发一条汇报，"
           "TYPE 为 DONE / FAILED / BLOCKED / NEED_DECISION 之一（PROGRESS 不算），格式见规则里的「汇报」。"
           + ("" if w.get("delegated_by") else "若用户刚在你的窗口直接打字跟你说过话，汇报里注明。"),
           f"Before ending this turn, run `{SELF} report {name}` in a shell (the report on stdin) to send the "
           "secretary a report whose TYPE is DONE / FAILED / BLOCKED / NEED_DECISION (PROGRESS doesn't count); "
           "the format is under \"Reporting\" in your rules."
           + ("" if w.get("delegated_by") else " If the user just typed to you in your window, say so in the report."))},
        ensure_ascii=False))


def hook_worker_stop(name):
    data = hook_input()
    (worker_dir(name) / "last-stop.json").write_text(json.dumps(data, indent=2, ensure_ascii=False))
    after = worker_dir(name) / AFTER_REPORT
    if after.exists():
        after.write_text("idle")  # the reporting turn is over; its next tool call means something new came
    permission_answered(name)
    with registry() as reg:  # a turn that ends normally is past any API error
        w = reg["workers"].get(name)
        if w is not None and w["status"] == "API_ERROR":
            w["status"] = w.pop("status_before", None) or "PROGRESS"
            w["pending_ask"] = None
    if data.get("background_tasks"):
        return  # waiting on its own background subagents; it will be woken and report then
    if read_registry()[1].get(name, {}).get("mode") == "discuss":
        return  # every turn of a discussion ends waiting for the user, who is in the window
    if not secretary_alive():
        return  # nobody to report to; the report, if any, is in the log and registry already
    marker = worker_dir(name) / "reported"
    if marker.exists() or data.get("stop_hook_active"):
        marker.unlink(missing_ok=True)
        return
    sec = config()["secretary_name"]
    print(json.dumps({"decision": "block", "reason":
        tr(f"结束本轮前必须用 SendMessage(to: \"{sec}\") 发一条汇报，TYPE 为 "
           "DONE / FAILED / BLOCKED / NEED_DECISION 之一（PROGRESS 不算）。"
           "若用户刚在你的窗口直接跟你说过话，汇报里注明。",
           f"Before ending this turn, send a report with SendMessage(to: \"{sec}\") whose TYPE is "
           "DONE / FAILED / BLOCKED / NEED_DECISION (PROGRESS doesn't count). "
           "If the user just talked to you in your window, say so in the report.")}, ensure_ascii=False))


def hook_secretary_session_start():
    data = hook_input()
    if data.get("session_id"):
        (HOME / "secretary.session").write_text(data["session_id"] + "\n")
    focus, workers = read_registry()
    out = [tr(f"[claudesec] 状态目录 {HOME}；你的宪法文件 {PROMPTS / 'secretary.md'}",
              f"[claudesec] State directory {HOME}; your constitution {PROMPTS / 'secretary.md'}")]
    import io
    buf, old = io.StringIO(), sys.stdout
    sys.stdout = buf
    try:
        cmd_status(None)
    finally:
        sys.stdout = old
    out += ["", tr("当前状态（来自 registry，以此为准）：", "Current state (from the registry; it is authoritative):"),
            buf.getvalue().rstrip()]
    index = HOME / "history" / "INDEX.md"
    if index.exists():
        lines = [l for l in index.read_text().splitlines() if l.startswith("- ")]
        if lines:
            out += ["", tr(f"历史索引最近 {min(20, len(lines))} 条（全部见 {index}）：",
                           f"The last {min(20, len(lines))} lines of the history index (all of it: {index}):"), *lines[-20:]]
    lessons = HOME / "lessons.md"
    if lessons.exists():
        n = sum(1 for l in open_part(lessons).splitlines() if l.startswith("- "))
        if n:
            out += ["", tr(f"lessons.md 里有 {n} 条教训待复盘。", f"lessons.md has {n} lessons waiting for the review.")]
    queue = HOME / "queue.md"
    if queue.exists():
        open_items, section = {}, None
        text = queue_text()
        for line in text.split(done_heading(text))[0].splitlines():
            if line.startswith("## "):
                section = queue_section(line)
            elif section and QUEUE_ITEM.match(line):
                open_items.setdefault(section, []).append(line)
        todo = open_items.get("todo", []) + open_items.get("doing", [])
        if todo:
            out += ["", tr(f"决策队列 {queue} 里还有 {len(todo)} 件没定（待问、待答；一次只问用户一件）：",
                           f"The decision queue {queue} has {len(todo)} undecided (To ask, Waiting; ask the user one "
                           "at a time):"), *todo]
        if open_items.get("backlog"):
            out += [tr(f"另有 {len(open_items['backlog'])} 件在「搁置」，用户提起前不问：",
                       f"And {len(open_items['backlog'])} in Backlog, not to be asked about until the user brings them up: ")
                    + tr("；", "; ").join(l.strip()[2:] for l in open_items["backlog"])]
        if open_items.get("ideas"):
            out += [tr(f"「记录」里 {len(open_items['ideas'])} 条是用户让记下的想法，不是要问的问题：",
                       f"Ideas holds {len(open_items['ideas'])} notes the user asked to keep, not questions: ")
                    + tr("；", "; ").join(l.strip()[2:] for l in open_items["ideas"])]
    notices = open_notices()
    if notices:
        out += ["", tr(f"待办事项 {HOME / 'notices.md'} 里有 {len(notices)} 件要用户去做的事（不是决策；用户做完 `claudesec notice done 编号`）：",
                       f"The to-do list {HOME / 'notices.md'} has {len(notices)} things for the user to do (not decisions; "
                       "when the user has done one, `claudesec notice done N`):"),
                *(f"- #{n} " + (f"[{t}] " if t else "") + text for n, t, text in notices)]
    print("\n".join(out)[:9500])


# Not the user's own words: peer messages, background-task notices, claudesec's alerts.
NOT_USER = ("<cross-session-message", "<task-notification", "[claudesec", "<system-reminder")


def hook_secretary_prompt():
    """The first thing the user says on a given day starts that day's review. Tied to the user
    showing up, not to a clock: no review on days off, and one, not several, after a break."""
    data = hook_input()
    if str(data.get("prompt", "")).lstrip().startswith(NOT_USER):
        return
    today = dt.date.today().isoformat()
    seen = HOME / "user-seen.date"
    try:
        last = seen.read_text().strip()
    except OSError:
        last = ""
    if last == today:
        return
    seen.write_text(today + "\n")
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "UserPromptSubmit", "additionalContext":
        tr(f"[claudesec] 今天第一次见用户（上次 {last or '没有记录'}）：先跑 `claudesec review` 开今天的复盘 worker，"
           "收据一行，再回应用户这条消息。",
           f"[claudesec] This is the first time you see the user today (last time: {last or 'no record'}): first "
           "run `claudesec review` to start today's review worker, give a one-line receipt, then answer the "
           "user's message.")}}, ensure_ascii=False))


def done_heading(text):
    """The heading a lessons or queue file's reviewed / decided part starts with, in its language."""
    return "\n## Done" if "\n## Done" in text and "\n## 已处理" not in text else "\n## 已处理"


def open_part(path):
    """A lessons or queue file up to its 「已处理」 (Done) section."""
    text = path.read_text()
    return text.split(done_heading(text))[0]


def hook_secretary_send():
    data = hook_input()
    inp = data.get("tool_input") or {}
    to = str(inp.get("to", "")).split(" [")[0]
    with registry() as reg:
        if to not in reg["workers"]:
            return
        reg["focus"] = to
    append_log(to, "secretary→worker", str(inp.get("message", "")))
    mark_answered(to, str(inp.get("message", "")))


def is_user_decision(text):
    """The secretary passing on the user's answer: 「用户决策：…」, or "User decision: …"."""
    return text.lstrip().startswith(("用户决策", "User decision"))


def mark_answered(name, text):
    """The secretary passed on the user's answer (「用户决策：…」): the worker no longer waits on
    the user, though it reports again only once it has acted on it."""
    if not is_user_decision(text):
        return
    with registry() as reg:
        w = reg["workers"].get(name)
        if w is None or w["status"] not in ("NEED_DECISION", "BLOCKED"):
            return
        line = text.lstrip().splitlines()[0]
        w.update(status="PROGRESS", pending_ask=None, last_summary=tr(f"已答，在处理：{line}", f"answered, working on it: {line}")[:200])


# ---------- watchdog: a worker stuck on a dialog ----------

STUCK_SECS = 60
DIALOG_FOOTER = re.compile(r"Enter to confirm|Esc to cancel|Esc to exit|trust this folder|Do you trust|Do you want to")
CREDITS = re.compile(r"(?:runs on|uses) usage credits")
SWITCH = re.compile(r"Switch to (.+?)(?: and continue)?\s*$")


def screen_dialog(screen):
    """The dialog a window ends in, as its last lines, or None. Only the bottom counts: older
    messages above may quote one, and below an idle prompt sits Claude Code's input box."""
    lines = [l.rstrip() for l in screen.splitlines() if l.strip()]
    if not any(DIALOG_FOOTER.search(l) for l in lines[-4:]):
        return None
    return "\n".join(lines[-12:])


def model_id(shown):
    """Claude Code's name for a model → its id: "Opus 5.5" → "claude-opus-5-5"."""
    return "claude-" + re.sub(r"[^a-z0-9]+", "-", re.sub(r"\(.*?\)", "", shown).lower()).strip("-")


def unpaid(model):
    """The model to run instead of one Claude Code said runs on usage credits, bought apart from
    the plan (learned by answer_credit_dialog)."""
    path = HOME / "registry.json"
    with contextlib.suppress(OSError, ValueError):
        return (json.loads(path.read_text()).get("credit_models") or {}).get(model, model)
    return model


def answer_credit_dialog(name, target, screen=None):
    """Claude Code asks before a model that runs on usage credits ("Switch to Opus 5.5 and
    continue / Continue with Fable 5.1"). Pick the switch, which costs nothing extra; record the
    worker's new model, and the swap for later spawns and wakes, and for shelved workers on the
    same model. Returns a note for the secretary, or None when no such dialog is up."""
    for _ in range(6):
        screen = screen if screen is not None else pane_text(target, suggestion="drop")
        dialog = screen_dialog(screen)
        if not dialog or not CREDITS.search(dialog):
            return None
        lines = screen.splitlines()
        at = max((i for i, l in enumerate(lines) if l.lstrip().startswith("❯")), default=None)
        to = max((i for i, l in enumerate(lines) if SWITCH.search(l)), default=None)
        if at is None or to is None:
            return None
        if at == to:
            break
        tmux("send-keys", "-t", target, "Down" if to > at else "Up")
        time.sleep(0.3)
        screen = None
    else:
        return None
    new = model_id(SWITCH.search(lines[to])[1])
    tmux("send-keys", "-t", target, "Enter")
    with registry() as reg:
        w = reg["workers"].get(name) or {}
        old = w.get("model")
        if w:
            w["model"] = new
        if old and old != new:
            reg.setdefault("credit_models", {})[old] = new
            for other in reg["workers"].values():
                if other["status"] == "SHELVED" and other.get("model") == old:
                    other["model"] = new
    permission_answered(name)
    append_log(name, "task", f"{old or 'its model'} runs on usage credits: picked Switch to {new}")
    return tr(f"worker {name} 的模型 {old} 要额外付费（usage credits），Claude Code 弹框问；已自动选「切到 {new} 继续」，"
              f"注册表里改成 {new}，以后用 {old} 的 spawn / wake 都直接用 {new}。",
              f"worker {name}'s model {old} runs on usage credits, paid apart from the plan, and Claude Code asked; "
              f"picked \"Switch to {new}\" for it. The registry says {new} now, and spawns and wakes on {old} use {new}.")


def user_watching(window):
    """The user has this window in front of them: the current window of an attached session."""
    out = tmux("display", "-p", "-t", window, "#{window_active} #{session_attached}", check=False).split() if window else []
    return len(out) == 2 and out[0] == "1" and out[1] != "0"


def check_stuck(now_t=None):
    """Runs with the reminders. A running worker that has sat on a dialog (a permission or
    confirmation prompt, a trust question, anything ending in Enter to confirm / Esc to cancel)
    or on an API error for STUCK_SECS wakes the secretary, once per dialog, unless the user is
    looking at its window. The hooks alert sooner for what they see; the screen catches the rest.
    Returns the alerts raised."""
    now_t = time.time() if now_t is None else now_t
    path = HOME / "stuck.json"
    try:
        seen = json.loads(path.read_text())
    except (OSError, ValueError):
        seen = {}
    live, keep, raised = alive_windows(), {}, []
    for name, w in read_registry()[1].items():
        if w["status"] == "SHELVED" or w.get("window") not in live:
            continue
        screen = pane_text(w["window"], suggestion="drop")
        if not is_cursor(w) and (note := answer_credit_dialog(name, w["window"], screen)):
            raise_alert(note)
            raised.append(note)
            continue
        if w["status"] in ("WAITING_PERMISSION", "API_ERROR"):
            sig = f"{w['status']}|{w.get('last_report_at')}"
            what = w.get("pending_ask") or w["status"]
        elif (dialog := screen_dialog(screen)):
            sig = "screen|" + hashlib.md5(re.sub(r"\d+", "", dialog).encode()).hexdigest()  # a ticking clock is the same dialog
            what = "\n".join(dialog.splitlines()[-6:])
        else:
            continue
        entry = seen.get(name) if (seen.get(name) or {}).get("sig") == sig else None
        entry = keep[name] = entry or {"sig": sig, "since": now_t, "alerted": w.get("alerted_for") == sig}
        if entry["alerted"] or now_t - entry["since"] < STUCK_SECS or user_watching(w["window"]):
            continue
        entry["alerted"] = True
        mins = int((now_t - entry["since"]) // 60)
        text = tr(f"worker {name} 卡住 {mins} 分钟以上了，停在这里等人处理（窗口 {name}）：\n{what}",
                  f"worker {name} has been stuck for over {mins} min, waiting for someone in window {name}:\n{what}")
        raise_alert(text)
        raised.append(text)
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(keep, indent=1, ensure_ascii=False) + "\n")
    tmp.replace(path)
    return raised


# ---------- dialogs: a worker waiting on the user ----------

def describe_request(tool, inp):
    what = (inp.get("command") or inp.get("file_path") or inp.get("notebook_path") or inp.get("url")
            or inp.get("path") or json.dumps(inp, ensure_ascii=False))
    return f"{tool}: {what}".replace("\n", " ")[:300]


def raise_alert(text):
    d = HOME / "alerts"
    d.mkdir(parents=True, exist_ok=True)
    tmp = d / f".{time.time_ns()}"
    tmp.write_text(text + "\n")
    tmp.rename(d / f"{time.time_ns()}.txt")


def hook_worker_permission(name):
    """A worker hit a permission dialog. PermissionRequest fires at once, also for calls that
    end up auto-approved, so only a prompt still open a few seconds later is announced."""
    data = hook_input()
    marker = worker_dir(name) / "waiting-permission"
    if data.get("hook_event_name") == "Notification":
        if marker.exists():
            return  # the same prompt, already being handled
        detail = data.get("message") or data.get("title") or tr("需要用户确认", "needs the user's confirmation")
        delay = 0  # Claude Code only notifies after the prompt has waited ~6s
    else:
        detail = describe_request(data.get("tool_name", "?"), data.get("tool_input") or {})
        delay = 4
    token = str(time.time_ns())
    marker.write_text(json.dumps({"token": token, "detail": detail}, ensure_ascii=False))
    subprocess.Popen([str(SELF), "hook", "worker-permission-alert", name],
                     env={**os.environ, "CLAUDESEC_HOME": str(HOME), "CLAUDESEC_TOKEN": token, "CLAUDESEC_DELAY": str(delay)},
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)


def hook_worker_permission_alert(name):
    time.sleep(float(os.environ.get("CLAUDESEC_DELAY", "0")))
    marker = worker_dir(name) / "waiting-permission"
    try:
        m = json.loads(marker.read_text())
    except (OSError, ValueError):
        return  # answered meanwhile
    if m.get("token") != os.environ.get("CLAUDESEC_TOKEN"):
        return
    with registry() as reg:
        w = reg["workers"].get(name)
        if w is None:
            return
        if w["status"] != "WAITING_PERMISSION":
            w["status_before"] = w["status"]
        w["status"] = "WAITING_PERMISSION"
        w["pending_ask"] = m["detail"]
        w["last_report_at"] = now()
        # Not when the user has the window in front of them (a discussion, mostly); if they look
        # away and leave it, check_stuck speaks up.
        watching = user_watching(w.get("window"))
        if not watching:
            w["alerted_for"] = f"WAITING_PERMISSION|{w['last_report_at']}"
    append_log(name, "permission", m["detail"])
    if not watching:
        raise_alert(tr(f"worker {name} 卡在一个确认对话框上，等用户在窗口 {name} 里处理：{m['detail']}",
                       f"worker {name} is stuck on a confirmation dialog, waiting for the user in window {name}: {m['detail']}"))


def hook_worker_stop_failure(name):
    """The turn died on an API error (a proxy's 524, an overload). The worker now idles at its
    prompt and will never report, so wake the secretary, who tells it to carry on."""
    data = hook_input()
    err = " ".join(str(data.get(k) or "") for k in ("error", "error_details")).strip() or "unknown error"
    err = err.replace("\n", " ")[:300]
    with registry() as reg:
        w = reg["workers"].get(name)
        if w is None:
            return
        if w["status"] not in ("API_ERROR", "WAITING_PERMISSION"):
            w["status_before"] = w["status"]
        w["status"] = "API_ERROR"
        w["pending_ask"] = err
        w["last_report_at"] = now()
        watching = user_watching(w.get("window"))  # then they see it; check_stuck speaks up if it stays
        if not watching:
            w["alerted_for"] = f"API_ERROR|{w['last_report_at']}"
    append_log(name, "api-error", err)
    if not watching:
        raise_alert(tr(f"worker {name} 这一轮因 API 错误中断，停在提示符上，不会自己汇报：{err}",
                       f"worker {name}'s turn broke off on an API error; it sits at its prompt and won't report on its own: {err}"))


def permission_answered(name):
    marker = worker_dir(name) / "waiting-permission"
    if not marker.exists():
        return
    marker.unlink(missing_ok=True)
    with registry() as reg:
        w = reg["workers"].get(name)
        if w is not None and w["status"] == "WAITING_PERMISSION":
            w["status"] = w.pop("status_before", None) or "PROGRESS"
            w["pending_ask"] = None
            append_log(name, "permission", "answered")


def hook_worker_permission_done(name):
    """After a tool call while a dialog is open or the last report still stands (the settings'
    guard keeps it cheap otherwise)."""
    data = hook_input()
    permission_answered(name)
    if data.get("tool_name") != "SendMessage":  # the report itself, or another one
        back_at_work(name)


# The pane shows a worker's last report: DONE, FAILED, BLOCKED, NEED_DECISION. Once it works again
# (an answer from the secretary, a new task, a decision pasted into a Cursor window) that would
# say done or stuck while it is busy. So a final report leaves a marker; the turn's end makes it
# "idle"; the first tool call of a later turn (a Claude worker) or the next prompt (a Cursor
# worker) puts the worker back to working, until its next report.
AFTER_REPORT = "after-report"


def back_at_work(name, new_turn=False):
    marker = worker_dir(name) / AFTER_REPORT
    try:
        state = marker.read_text().strip()
    except OSError:
        return
    if state != "idle" and not new_turn:
        return  # still in the turn that reported: it may wrap up, but nothing new came in
    marker.unlink(missing_ok=True)
    with registry() as reg:
        w = reg["workers"].get(name)
        if w is None or w["status"] not in TERMINAL:
            return
        was, old = w["status"], " ".join((w.get("last_summary") or "").split())
        if was in ("NEED_DECISION", "BLOCKED"):
            summary = old if old.startswith(("已答，在处理", "answered, working")) else \
                tr(f"收到回复，在处理：{old}", f"got an answer, working on it: {old}")
        else:
            summary = tr(f"在做新的一轮（上次 {was}：{old}）", f"on a new turn (last {was}: {old})")
        w.update(status="PROGRESS", pending_ask=None, last_summary=summary[:200])
    append_log(name, "resumed", f"working again after its {was} report")


# Claude Code sends SIGTERM to an async hook when its timeout runs out: 600 s if none is set
# (2.1.309, measured). The watcher had none, so it died ten minutes into an idle stretch and the
# night's alerts (10-23, devbox) waited in alerts/ until the user's next message.
WATCH_TIMEOUT = 24 * 3600
WATCH_MARGIN = 300
# After the secretary's turn fails on an API error: wait this long before waking it again. Each
# retry that fails again is one cheap rejected request; 10-23 the account ran out of credit and
# nothing woke the secretary for 2.5 days.
WATCH_RETRY = 15 * 60
WATCH_REARM = ("[claudesec] 告警监听到期重挂：没有新告警，这不是任务。什么都不用做、不用回复，"
               "直接结束这一轮（结束时会自动重新挂上监听）。")
WATCH_REARM_EN = ("[claudesec] The alert watcher timed out and is being re-armed: there are no new alerts, and this "
                  "is not a task. Do nothing and don't reply; just end this turn (ending it re-arms the watcher).")


def hook_secretary_watch_failed():
    """StopFailure: the secretary's turn died on an API error. Whatever alerts it was woken for
    go back to alerts/, and a watcher is armed that waits a while before waking it again, so a
    billing or capacity error doesn't turn into a tight loop of failing turns."""
    inflight, done = HOME / "alerts" / "inflight.json", HOME / "alerts" / "delivered"
    with contextlib.suppress(OSError, ValueError):
        for name in json.loads(inflight.read_text()):
            with contextlib.suppress(OSError):
                (done / name).rename(HOME / "alerts" / name)
    inflight.unlink(missing_ok=True)
    hook_secretary_watch(delay=WATCH_RETRY)


def hook_secretary_watch(delay=0):
    """Armed in the background at session start and every turn end; one instance at a time.
    Exits 2 with the pending alerts, which wakes the secretary (asyncRewake)."""
    data = hook_input()
    lock = open(HOME / "watch.lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return  # already armed
    owner = next((s["pid"] for s in claude_sessions() if s.get("sessionId") == data.get("session_id")),
                 os.getppid())
    alerts, done = HOME / "alerts", HOME / "alerts" / "delivered"
    done.mkdir(parents=True, exist_ok=True)
    inflight = alerts / "inflight.json"
    if data.get("hook_event_name") == "Stop":
        inflight.unlink(missing_ok=True)  # the turn they woke ended normally: handled
    deadline = time.monotonic() + WATCH_TIMEOUT - WATCH_MARGIN
    quiet_until = time.monotonic() + delay
    while True:
        if time.monotonic() < quiet_until:  # after a failed turn: give the API time to recover
            try:
                os.kill(owner, 0)
            except OSError:
                return
            time.sleep(1)
            continue
        if time.monotonic() > deadline:
            # Claude Code ends an async hook at its timeout, and nothing would arm another until
            # the secretary's next turn. Wake it with nothing to do; its turn end re-arms this.
            print(tr(WATCH_REARM, WATCH_REARM_EN), file=sys.stderr)
            sys.exit(2)
        files = sorted(alerts.glob("*.txt"))
        if files:
            msgs = [f.read_text().strip() for f in files]
            for f in files:
                f.rename(done / f.name)
            # Kept until the turn they wake ends normally; a failed one puts them back.
            names = json.loads(inflight.read_text()) if inflight.exists() else []
            inflight.write_text(json.dumps(names + [f.name for f in files]))
            print(tr("[claudesec 告警]\n", "[claudesec alert]\n") + "\n".join(msgs), file=sys.stderr)
            sys.exit(2)
        try:
            os.kill(owner, 0)
        except OSError:
            return  # the secretary is gone
        time.sleep(1)


HOOKS = {
    "worker-session-start": hook_worker_session_start,
    "worker-permission": hook_worker_permission,
    "worker-permission-alert": hook_worker_permission_alert,
    "worker-permission-done": hook_worker_permission_done,
    "secretary-watch": hook_secretary_watch,
    "secretary-watch-failed": hook_secretary_watch_failed,
    "worker-report": hook_worker_report,
    "worker-stop": hook_worker_stop,
    "worker-stop-failure": hook_worker_stop_failure,
    "secretary-session-start": hook_secretary_session_start,
    "secretary-send": hook_secretary_send,
    "secretary-prompt": hook_secretary_prompt,
    "cursor-session-start": hook_cursor_session_start,
    "cursor-prompt": hook_cursor_prompt,
    "cursor-stop": hook_cursor_stop,
    "cursor-finish": hook_cursor_finish,
    "worker-budget": hook_worker_budget,
    "cursor-exit": hook_cursor_exit,
    "cursor-launch": hook_cursor_launch,
}


def cmd_hook(args):
    fn = HOOKS[args.event]
    fn(args.name) if args.name else fn()


# ---------- cli ----------

def main():
    p = argparse.ArgumentParser(prog="claudesec", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd")

    s = sub.add_parser("start"); s.add_argument("--new", action="store_true")
    s.add_argument("--restart", action="store_true")
    s.add_argument("-d", "--detach", action="store_true"); s.set_defaults(fn=cmd_start)
    s = sub.add_parser("run"); s.add_argument("--new", action="store_true"); s.set_defaults(fn=cmd_run)
    s = sub.add_parser("spawn"); s.add_argument("name"); s.add_argument("--dir")
    s.add_argument("--model"); s.add_argument("--discuss", action="store_true")
    s.add_argument("--agent", choices=["claude", "cursor"], default="claude")
    s.add_argument("--for", dest="for_worker", metavar="WORKER"); s.add_argument("--budget", type=float, metavar="USD")
    s.set_defaults(fn=cmd_spawn)
    s = sub.add_parser("status"); s.set_defaults(fn=cmd_status)
    s = sub.add_parser("budget"); s.add_argument("--until"); s.add_argument("--from", dest="start")
    s.add_argument("--usd", type=float); s.add_argument("--add", type=float); s.add_argument("--off", action="store_true")
    s.add_argument("--worker", metavar="NAME"); s.set_defaults(fn=cmd_budget)
    s = sub.add_parser("cost"); s.add_argument("name", nargs="?"); s.add_argument("--today", action="store_true")
    s.add_argument("--since"); s.add_argument("--until"); s.set_defaults(fn=cmd_cost)
    s = sub.add_parser("log"); s.add_argument("name"); s.add_argument("-n", type=int, default=3)
    s.set_defaults(fn=cmd_log)
    s = sub.add_parser("interrupt"); s.add_argument("name"); s.set_defaults(fn=cmd_interrupt)
    s = sub.add_parser("close"); s.add_argument("name"); s.set_defaults(fn=cmd_close)
    s = sub.add_parser("peek"); s.add_argument("name"); s.add_argument("-n", type=int, default=15)
    s.set_defaults(fn=cmd_peek)
    s = sub.add_parser("sessions"); s.set_defaults(fn=cmd_sessions)
    s = sub.add_parser("adopt"); s.add_argument("session"); s.add_argument("--as", dest="as_name")
    s.add_argument("--model"); s.add_argument("--wait", action="store_true"); s.set_defaults(fn=cmd_adopt)
    s = sub.add_parser("shelve"); s.add_argument("name"); s.add_argument("--note")
    s.add_argument("--as", dest="as_name"); s.add_argument("--force", action="store_true")
    s.set_defaults(fn=cmd_shelve)
    s = sub.add_parser("wake"); s.add_argument("name"); s.add_argument("--model"); s.add_argument("--dir")
    s.set_defaults(fn=cmd_wake)
    s = sub.add_parser("redir"); s.add_argument("old"); s.add_argument("new"); s.set_defaults(fn=cmd_redir)
    s = sub.add_parser("remind"); s.add_argument("words", nargs="*")
    s.add_argument("--list", action="store_true"); s.add_argument("--all", action="store_true")
    s.add_argument("--cancel"); s.add_argument("--every", metavar="PERIOD"); s.set_defaults(fn=cmd_remind)
    s = sub.add_parser("show"); s.add_argument("number"); s.set_defaults(fn=cmd_show)
    s = sub.add_parser("notice"); s.set_defaults(fn=cmd_notice)
    notice = s.add_subparsers(dest="action", required=True)
    s = notice.add_parser("add"); s.add_argument("words", nargs="+"); s.add_argument("--from", dest="source")
    s = notice.add_parser("done"); s.add_argument("number")
    notice.add_parser("list")
    s = sub.add_parser("queue"); s.set_defaults(fn=cmd_queue)
    queue = s.add_subparsers(dest="action", required=True)  # so --asked goes before or after the text
    s = queue.add_parser("add"); s.add_argument("words", nargs="+"); s.add_argument("--asked", action="store_true")
    s.add_argument("--later", action="store_true"); s.add_argument("--idea", action="store_true")
    s = queue.add_parser("list"); s.add_argument("--older", type=int, metavar="DAYS")
    s = queue.add_parser("doctor"); s.add_argument("--fix", action="store_true")
    s = queue.add_parser("move"); s.add_argument("number")
    s.add_argument("to", choices=[*QUEUE_SECTIONS, *(w for ws in QUEUE_SECTIONS.values() for w in ws)])
    s.add_argument("--note")
    s = queue.add_parser("number")
    s = sub.add_parser("dashboard"); s.add_argument("action", choices=["on", "off", "layout", "show"])
    s.add_argument("what", nargs="?", choices=list(DASH_PANES)); s.set_defaults(fn=cmd_dashboard)
    s = sub.add_parser("review"); s.add_argument("--print", action="store_true"); s.set_defaults(fn=cmd_review)
    s = sub.add_parser("report"); s.add_argument("name"); s.set_defaults(fn=cmd_report)
    s = sub.add_parser("send"); s.add_argument("name"); s.set_defaults(fn=cmd_send)
    s = sub.add_parser("model"); s.add_argument("name"); s.add_argument("model")
    s.add_argument("--force", action="store_true"); s.set_defaults(fn=cmd_model)
    s = sub.add_parser("delegate"); s.add_argument("boss"); s.add_argument("--name", required=True)
    s.add_argument("--dir"); s.add_argument("--model"); s.add_argument("--ack"); s.add_argument("--budget", type=float)
    s.set_defaults(fn=cmd_delegate)
    s = sub.add_parser("wait"); s.add_argument("name"); s.add_argument("--timeout", type=int, default=4 * 3600)
    s.set_defaults(fn=cmd_wait)
    s = sub.add_parser("lifecycle"); s.add_argument("job", choices=["shelve-all", "wake-all", "reminders"])
    s.add_argument("run_pid", type=int, nargs="?"); s.set_defaults(fn=cmd_lifecycle)
    s = sub.add_parser("archive"); s.add_argument("name"); s.add_argument("--summary")
    s.add_argument("--tags"); s.add_argument("--files"); s.add_argument("--subagent", action="store_true")
    s.add_argument("--task"); s.add_argument("--dir"); s.set_defaults(fn=cmd_archive)
    s = sub.add_parser("lesson"); s.add_argument("type"); s.add_argument("situation")
    s.add_argument("correction"); s.set_defaults(fn=cmd_lesson)
    s = sub.add_parser("hook"); s.add_argument("event", choices=HOOKS); s.add_argument("name", nargs="?")
    s.set_defaults(fn=cmd_hook)

    argv = sys.argv[1:]
    if not argv or argv[0].startswith("-") and argv[0] not in ("-h", "--help"):
        argv = ["start", *argv]
    args = p.parse_args(argv)
    if not getattr(args, "fn", None):
        p.print_help()
        return
    args.fn(args)


if __name__ == "__main__":
    main()
